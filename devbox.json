{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": {
    "nodejs": "22",
    "gren": "0.6",
    "cmake": "latest",
    "pkg-config": "latest",
    "ncurses": {
      "version": "latest",
      "outputs": [
        "out",
        "dev"
      ]
    }
  },
  "shell": {
    "scripts": {
      "m0": [
        "cd m0-load-test && ./run.sh"
      ],
      "lib": [
        "tvision-node/scripts/build-tvision.sh"
      ],
      "build": [
        "tvision-node/scripts/build-tvision.sh",
        "(cd tvision-node && npm install --no-audit --no-fund && npx node-gyp rebuild)",
        "(cd gren-tvision-runtime && npm install --no-audit --no-fund)",
        "gren-tvision/build.sh"
      ],
      "hello": [
        "cd tvision-node && node examples/hello.js"
      ],
      "demo": [
        "cd tvision-node && node examples/demo.js"
      ],
      "ascii": [
        "(cd tvision-node && node examples/ascii.js)"
      ],
      "form": [
        "(cd tvision-node && node examples/form.js)"
      ],
      "gren": [
        "gren-tvision/run.sh ${1:-entries}"
      ],
      "gren:build": [
        "gren-tvision/build.sh"
      ],
      "test": [
        "python3 tools/check_consistency.py",
        "(cd gren-tvision && gren docs --output=/dev/null)",
        "(cd gren-tvision-runtime && node --test test/*.test.js)",
        "(cd gren-tvision/tests && ./run.sh)",
        "gren-tvision/build.sh",
        "(cd tvision-node && python3 test/drive_regress.py)",
        "(cd tvision-node && python3 test/drive.py)",
        "(cd tvision-node && python3 test/drive_demo.py)",
        "(cd tvision-node && python3 test/drive_ascii.py)",
        "(cd tvision-node && python3 test/drive_form.py)",
        "(cd gren-tvision && python3 test/drive_hello.py)",
        "(cd gren-tvision && python3 test/drive_mmenu.py)",
        "(cd gren-tvision && python3 test/drive_entries.py)",
        "(cd gren-tvision && python3 test/drive_forms.py)",
        "(cd gren-tvision && python3 test/drive_ascii.py)",
        "(cd gren-tvision && python3 test/drive_calendar.py)",
        "(cd gren-tvision && python3 test/drive_puzzle.py)",
        "(cd gren-tvision && python3 test/drive_calc.py)",
        "(cd gren-tvision && python3 test/drive_palette.py)",
        "(cd gren-tvision && python3 test/drive_mouse.py)"
      ],
      "test:asan": [
        "(cd tvision-node && TVNODE_ASAN=1 npx node-gyp rebuild)",
        "gren-tvision/build.sh",
        "(cd tvision-node && TVNODE_ASAN=1 python3 test/drive_regress.py)",
        "(cd tvision-node && TVNODE_ASAN=1 python3 test/drive.py)",
        "(cd tvision-node && TVNODE_ASAN=1 python3 test/drive_demo.py)",
        "(cd tvision-node && TVNODE_ASAN=1 python3 test/drive_ascii.py)",
        "(cd tvision-node && TVNODE_ASAN=1 python3 test/drive_form.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_hello.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_mmenu.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_entries.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_forms.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_ascii.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_calendar.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_puzzle.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_calc.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_palette.py)",
        "(cd gren-tvision && TVNODE_ASAN=1 python3 test/drive_mouse.py)",
        "(cd tvision-node && npx node-gyp rebuild)"
      ],
      "check": [
        "python3 tools/check_consistency.py",
        "(cd gren-tvision && gren docs --output=/dev/null)",
        "(cd gren-tvision-runtime && node --test test/*.test.js)",
        "(cd gren-tvision/tests && ./run.sh)"
      ]
    }
  }
}

port module Main exposing (main)

{-| Milestone 3: a Turbo Vision application written in Gren.

Nothing in this file knows that C++ exists. It is a model, a view returning a
description of some windows, and an update that responds to messages -- the
same shape as any Elm-architecture program. `Tui` sends the description over a
port; the JavaScript in `tui.js` diffs it and drives the native binding.

The clock is here on purpose. It is driven by `Time.every`, a perfectly
ordinary subscription, and it keeps ticking while a modal dialog is open --
which is the thing milestone 2.5 went to some trouble to make true.
-}

import Array exposing (Array)
import Init
import Json.Decode as Decode
import Json.Encode as Encode
import Node
import String
import Task
import Time
import Tui exposing (Event(..), MenuItem(..), View(..))


-- PORTS
--
-- A Gren package may not declare ports, so every application declares these
-- two itself and hands them to Tui. The names are part of the contract with
-- the JavaScript runtime.


port tuiOut : Encode.Value -> Cmd msg


port tuiIn : (Decode.Value -> msg) -> Sub msg


tui : Tui.Ports Msg
tui =
    { toJs = tuiOut, fromJs = tuiIn }


-- MODEL


type alias Model =
    { items : Array String
    , selected : String
    , ticks : Int
    , now : Time.Posix
    , listOpen : Bool
    -- How big the desktop is, which the program is told rather than assuming.
    -- The value here is only what the very first render uses: Resized arrives
    -- immediately after the application starts, before anyone can see it.
    , desk : { cols : Int, rows : Int }
    }


type Msg
    = Tick Time.Posix
    | FromTui Event


-- INIT


init : Node.Environment -> Init.Task { model : Model, command : Cmd Msg }
init _ =
    Node.startProgram
        { model =
            { items = [ "Turbo Vision", "Borland", "Gren" ]
            , selected = "(nothing selected)"
            , ticks = 0
            , now = Time.millisToPosix 0
            , listOpen = True
            , desk = { cols = 80, rows = 23 }
            }
        , command = Cmd.none
        }


-- UPDATE


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        Tick posix ->
            { model = { model | now = posix, ticks = model.ticks + 1 }
            , command = Cmd.none
            }

        FromTui event ->
            handleEvent event model


handleEvent : Event -> Model -> { model : Model, command : Cmd Msg }
handleEvent event model =
    when event is
        Command "add" ->
            { model = model, command = addDialog }

        Command "clear" ->
            { model = { model | items = [], selected = "(nothing selected)" }
            , command = Tui.setEnabled tui "clear" False
            }

        -- Opening a window that is already open used to be a no-op: the flag
        -- was already True, the render found no difference, and Alt-L did
        -- nothing at all for a window sitting behind the clock. "Show me that
        -- one" is the thing a description of the UI cannot say, because the
        -- window is already in the description.
        Command "list" ->
            { model = { model | listOpen = True }
            , command = Tui.focus tui "list"
            }

        Command _ ->
            { model = model, command = Cmd.none }

        Selected selection ->
            { model = { model | selected = selection.text }, command = Cmd.none }

        -- Where the highlight is sitting is nothing this model needs; the
        -- forms example is the one that acts on it.
        Focused _ ->
            { model = model, command = Cmd.none }

        KeyPressed _ ->
            { model = model, command = Cmd.none }

        Clicked _ ->
            { model = model, command = Cmd.none }

        -- The terminal is a size the model is told, once at startup and again
        -- whenever it changes. Every window here is placed against it.
        Resized size ->
            { model = { model | desk = size }, command = Cmd.none }

        -- The dialog's result arrives as a message, the way any Cmd's does.
        DialogClosed closed ->
            if closed.cmd == "ok" then
                let
                    entry =
                        String.trim (Tui.text "entry" closed.values)
                in
                if String.isEmpty entry then
                    { model = model, command = Cmd.none }

                else
                    { model = { model | items = Array.pushLast entry model.items }
                    , command =
                        Cmd.batch
                            [ Tui.setEnabled tui "clear" True
                            -- The dialog took the caret with it and gives it
                            -- back to whatever had it before, which is not
                            -- necessarily the list the new entry just went
                            -- into.
                            , Tui.focus tui "entries"
                            ]
                    }

            else
                { model = model, command = Cmd.none }

        -- The user closed a window from its frame. Without this the model
        -- would go on believing the window is open, and the next render would
        -- put it straight back.
        WindowClosed "list" ->
            { model = { model | listOpen = False }, command = Cmd.none }

        WindowClosed _ ->
            { model = model, command = Cmd.none }

        Scrolled _ ->
            { model = model, command = Cmd.none }

        Unknown _ ->
            { model = model, command = Cmd.none }


addDialog : Cmd Msg
addDialog =
    Tui.dialog tui
        { id = "addDialog"
        , title = "Add an entry"
        , rect = { x1 = 16, y1 = 7, x2 = 64, y2 = 15 }
        , views =
            [ StaticText { id = "prompt", rect = { x1 = 3, y1 = 2, x2 = 44, y2 = 3 }, text = "New entry:" }
            , InputLine { id = "entry", rect = { x1 = 3, y1 = 3, x2 = 44, y2 = 4 }, maxLen = 40, value = "" }
            , Button { id = "ok", rect = { x1 = 10, y1 = 5, x2 = 22, y2 = 7 }, title = "~O~K", cmd = "ok", isDefault = True, takesFocus = True }
            , Button { id = "cancel", rect = { x1 = 26, y1 = 5, x2 = 38, y2 = 7 }, title = "Cancel", cmd = "cancel", isDefault = False, takesFocus = True }
            ]
        }


-- VIEW


view : Model -> Tui.Ui
view model =
    { menuBar =
        [ SubMenu
            { title = "~E~ntries"
            , key = "Alt-E"
            , items =
                [ Item { title = "~A~dd...", cmd = "add", key = "Alt-A", shortcut = "Alt-A" }
                , Item { title = "~L~ist window", cmd = "list", key = "Alt-L", shortcut = "Alt-L" }
                , Separator
                , Item { title = "~C~lear", cmd = "clear", key = "", shortcut = "" }
                , Separator
                , Item { title = "E~x~it", cmd = "quit", key = "Alt-X", shortcut = "Alt-X" }
                ]
            }
        ]
    , statusLine =
        [ { text = "~Alt-X~ Exit", key = "Alt-X", cmd = "quit" }
        , { text = "~Alt-A~ Add", key = "Alt-A", cmd = "add" }
        , { text = "~Alt-L~ List", key = "Alt-L", cmd = "list" }
        , { text = "", key = "F10", cmd = "menu" }
        ]
    , windows =
        Array.append
            [ clockWindow model ]
            (if model.listOpen then
                [ listWindow model ]

             else
                []
            )
    }


{-| A fixed-width panel against the right-hand edge of the desktop, wherever
that edge happens to be. This is the whole of what knowing the size buys: the
rectangle used to say 48 and 79, which is the right-hand edge of an 80-column
terminal and the middle of a 120-column one.
-}
clockWindow : Model -> Tui.Window
clockWindow model =
    { id = "clock"
    , title = "Gren"
    , rect =
        { x1 = model.desk.cols - 32
        , y1 = 1
        , x2 = model.desk.cols - 1
        , y2 = 9
        }
    , views =
        [ StaticText
            { id = "clockTime"
            , rect = { x1 = 2, y1 = 1, x2 = 29, y2 = 2 }
            , text = "UTC " ++ clock model.now
            }
        , StaticText
            { id = "clockTicks"
            , rect = { x1 = 2, y1 = 2, x2 = 29, y2 = 3 }
            , text = "ticks: " ++ String.fromInt model.ticks
            }
        , StaticText
            { id = "clockNote"
            , rect = { x1 = 2, y1 = 4, x2 = 29, y2 = 7 }
            , text = "A Time.every subscription. It keeps running while a dialog is open."
            }
        ]
    }


{-| And this one takes whatever the panel left, in both directions -- and the
views inside it follow, which is a separate question from the window's own size
and answered separately, by `Grows`.
-}
listWindow : Model -> Tui.Window
listWindow model =
    { id = "list"
    , title = "Entries (" ++ String.fromInt (Array.length model.items) ++ ")"
    , rect =
        { x1 = 1
        , y1 = 1
        , x2 = model.desk.cols - 34
        , y2 = model.desk.rows - 6
        }
    -- The rectangles below are the layout at the size the window starts at,
    -- and the `Grows` wrappers are what keeps them right at every other size.
    -- Nothing here recomputes them: Turbo Vision moves the edges that were
    -- told to follow, in TGroup::changeBounds, whether the window changed size
    -- because the terminal did or because the user dragged its corner -- and
    -- the model is not told about the second one at all.
    , views =
        [ Grows
            { grow = Tui.stretch
            , view =
                ListBox
                    { id = "entries"
                    , rect = { x1 = 2, y1 = 1, x2 = 43, y2 = 11 }
                    , items = model.items
                    , focused = 0
                    }
            }
        -- Both vertical edges follow, so this keeps its one-row height and
        -- stays the same distance off the bottom; the right edge follows too,
        -- so it stays as wide as the window.
        , Grows
            { grow = { left = False, top = True, right = True, bottom = True }
            , view =
                StaticText
                    { id = "selection"
                    , rect = { x1 = 2, y1 = 12, x2 = 43, y2 = 13 }
                    , text = "Selected: " ++ model.selected
                    }
            }
        -- A button keeps its size, so only the vertical pair moves.
        , Grows
            { grow = Tui.pinBottom
            , view =
                Button
                    { id = "addButton"
                    , rect = { x1 = 2, y1 = 13, x2 = 16, y2 = 15 }
                    , title = "~A~dd..."
                    , cmd = "add"
                    , isDefault = False
                    , takesFocus = True
                    }
            }
        ]
    }


clock : Time.Posix -> String
clock posix =
    let
        pad n =
            String.padLeft 2 '0' (String.fromInt n)
    in
    pad (Time.toHour Time.utc posix)
        ++ ":"
        ++ pad (Time.toMinute Time.utc posix)
        ++ ":"
        ++ pad (Time.toSecond Time.utc posix)


-- PROGRAM


main : Tui.Program Model Msg
main =
    Tui.defineProgram tui
        { init = init
        , update = update
        , subscriptions = \_ -> Time.every 1000 Tick
        , view = view
        , onEvent = FromTui
        }

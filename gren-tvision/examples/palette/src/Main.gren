port module Main exposing (main)

{-| tvision's palette example (`tvision/examples/palette`), in Gren -- and the
one port where the original's whole subject disappears in translation.

`palette.cpp` is an essay on how a Turbo Vision view gets its colors. A view
asks for color *1*; its own palette turns that into an index into the window's
palette; the window's palette turns that into an index into the application's;
the application's palette holds the byte the terminal finally receives. Three
layers of indirection, three parallel palettes for color, black-and-white and
monochrome displays, and a comment explaining that the strings are `#define`s
so that the compiler will concatenate them.

    #define cpTestView   "\x9\xA\xB\xC\xD\xE"
    #define cpTestWindow "\x88\x89\x8A\x8B\x8C\x8D"
    #define cpTestAppC   "\x3E\x2D\x72\x5F\x68\x4E"

The six lines below are what those three lines resolve to. In Gren a
[`Span`](Tui#Span) names its color and there is nothing in between, so the
essay becomes a table -- and the original's last line, the one whose comment
says it "bypasses the palettes", is now indistinguishable from the six above
it, because there are no palettes to bypass.

That is a real trade and it is worth being clear about which way it goes. The
indirection existed so that one edit to the application's palette could restyle
every view in the program at once; say the color and you give that up. What
you get back is that the color is in the model, where the same `if` that
decides *what* to draw can decide what color to draw it -- which is how the
calendar marks today and the puzzle shows a tile out of place, and neither of
those is a palette question.

The window at the bottom is the middle road: spans that name no color follow
whatever the window's palette gives them, which is still how nearly every
canvas in these examples paints.

-}

import Array exposing (Array)
import Init
import Json.Decode as Decode
import Json.Encode as Encode
import Node
import String
import Tui exposing (Event(..), Hue(..), MenuItem(..), View(..))


-- PORTS


port tuiOut : Encode.Value -> Cmd msg


port tuiIn : (Decode.Value -> msg) -> Sub msg


tui : Tui.Ports Msg
tui =
    { toJs = tuiOut, fromJs = tuiIn }


-- MODEL


type alias Model =
    { showing : Bool
    , showingPlain : Bool
    -- Which of Turbo Vision's three window color sets the second window is
    -- drawn in. The one piece of the palette machinery that survives into an
    -- API where a color is named rather than looked up -- see the note on
    -- `plainWindow` -- so this example is where it belongs.
    , tone : Tui.WindowPalette
    -- And the application palette, which is the other hundred and thirty-four
    -- colors: everything the package draws rather than the model.
    , dark : Bool
    }


type Msg
    = FromTui Event


init : Node.Environment -> Init.Task { model : Model, command : Cmd Msg }
init _ =
    Node.startProgram
        { model = { showing = True, showingPlain = True, tone = Tui.BlueWindow, dark = False }
        , command = Cmd.none
        }


-- THE COLORS
--
-- What the three palettes in palette.cpp add up to, byte for byte. The C++
-- reaches these through cpTestView -> cpTestWindow -> cpTestAppC; here they
-- are just the answer.


type alias Entry =
    { index : String, attr : String, fg : Hue, bg : Hue }


entries : Array Entry
entries =
    [ { index = "01", attr = "3E", fg = Yellow, bg = Cyan }
    , { index = "02", attr = "2D", fg = LightMagenta, bg = Green }
    , { index = "03", attr = "72", fg = Green, bg = LightGray }
    , { index = "04", attr = "5F", fg = White, bg = Magenta }
    , { index = "05", attr = "68", fg = DarkGray, bg = Brown }
    , { index = "06", attr = "4E", fg = Yellow, bg = Red }
    ]


-- UPDATE


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        FromTui (Command "about") ->
            { model = model, command = Tui.dialog tui aboutDialog }

        FromTui (Command "palette") ->
            { model = { model | showing = True, showingPlain = True }, command = Cmd.none }

        FromTui (Command "theme") ->
            { model = { model | dark = not model.dark }, command = Cmd.none }

        FromTui (Command "tone") ->
            { model = { model | tone = nextTone model.tone }, command = Cmd.none }

        FromTui (WindowClosed "paletteWin") ->
            { model = { model | showing = False }, command = Cmd.none }

        FromTui (WindowClosed "plainWin") ->
            { model = { model | showingPlain = False }, command = Cmd.none }

        FromTui _ ->
            { model = model, command = Cmd.none }


{-| A second scheme, so that this example shows both halves of the color
story: `Alt-W` moves one window between the three sets a theme defines, and
`Alt-T` changes what those three sets *are*.

Written out in full rather than as `{ Tui.borland | ... }` because that is what
authoring a theme looks like, and seventeen fields is the size of the job. Two
things are worth noticing in it.

**It is `Rgb` throughout.** Borland's is `Ansi`, so it follows whatever the
person running it has set their terminal's sixteen colors to; this one does
not, because a dark scheme built out of "whatever this terminal calls black" is
at the mercy of a terminal whose black is not dark. The cost is that it looks
the same everywhere including where that is wrong -- Turbo Vision quantises it
down when the terminal cannot do better, and a 24-bit scheme checked only at
24 bits is a scheme nobody has checked.

**The window ground is lifted off the desktop rather than equal to it.** That
is the whole trick of a dark scheme in sixteen colors, and the reason it needs
`Rgb`: `Black` and `DarkGray` is the only pair the sixteen offer, and it is too
far apart to read as one surface and too close to be a border.
-}
midnight : Tui.Theme
midnight =
    { desktop = { fg = Tui.Rgb 0x2A2A33, bg = Tui.Rgb 0x14141A }
    , bar = { fg = Tui.Rgb 0xC8C8D0, bg = Tui.Rgb 0x24242E }
    , barAccent = Tui.Rgb 0xE8A33D
    , barDisabled = Tui.Rgb 0x6A6A78
    , barSelected = { fg = Tui.Rgb 0x14141A, bg = Tui.Rgb 0xE8A33D }
    , barSelectedAccent = Tui.Rgb 0x5A2E00
    , window = midnightPanel (Tui.Rgb 0x1E1E26)
    , alternate = midnightPanel (Tui.Rgb 0x1A2430)
    , dialog = midnightPanel (Tui.Rgb 0x26262F)
    }


midnightPanel : Tui.Tint -> Tui.ThemePanel
midnightPanel ground =
    { frame = { fg = Tui.Rgb 0x5A5A6A, bg = ground }
    , frameActive = Tui.Rgb 0xE8E8F0
    , text = { fg = Tui.Rgb 0xC8C8D0, bg = ground }
    , accent = Tui.Rgb 0xE8A33D
    , selected = { fg = Tui.Rgb 0x14141A, bg = Tui.Rgb 0x8AA9C8 }
    , disabled = Tui.Rgb 0x6A6A78
    , button = { fg = Tui.Rgb 0xE8E8F0, bg = Tui.Rgb 0x3A3A48 }
    , buttonAccent = Tui.Rgb 0xE8A33D
    , input = { fg = Tui.Rgb 0xE8E8F0, bg = Tui.Rgb 0x141A24 }
    , inputAccent = Tui.Rgb 0xE8A33D
    , scrollBar = { fg = Tui.Rgb 0x5A5A6A, bg = Tui.Rgb 0x24242E }
    }


nextTone : Tui.WindowPalette -> Tui.WindowPalette
nextTone tone =
    when tone is
        Tui.BlueWindow ->
            Tui.CyanWindow

        Tui.CyanWindow ->
            Tui.GrayWindow

        Tui.GrayWindow ->
            Tui.BlueWindow


toneName : Tui.WindowPalette -> String
toneName tone =
    when tone is
        Tui.BlueWindow ->
            "blue"

        Tui.CyanWindow ->
            "cyan"

        Tui.GrayWindow ->
            "gray"


{-| The original's About box, which is a `TStaticText` full of `\003` centering
markers and a default OK button.
-}
aboutDialog : Tui.DialogSpec
aboutDialog =
    { id = "about"
    , title = "About"
    , rect = { x1 = 16, y1 = 5, x2 = 63, y2 = 18 }
    , views =
        [ Tui.StaticText
            { id = "aboutText"
            , rect = { x1 = 2, y1 = 1, x2 = 45, y2 = 9 }
            , text = "\n\u{0003}PALETTE EXAMPLE\n \n\u{0003}A Turbo Vision Demo\n \n\u{0003}written by\n \n\u{0003}Borland C++ Tech Support\n"
            }
        , Tui.Button
            { id = "aboutOk"
            , rect = { x1 = 18, y1 = 10, x2 = 29, y2 = 12 }
            , title = "OK"
            , cmd = "ok"
            , isDefault = True
            , takesFocus = True
            }
        ]
    }


-- VIEW


view : Model -> Tui.Ui
view model =
    { menuBar =
        [ SubMenu
            { title = "~P~alette"
            , key = "Alt-P"
            , items =
                [ Item { title = "~A~bout...", cmd = "about", key = "Alt-A", shortcut = "Alt-A" }
                , Item { title = "~P~alette", cmd = "palette", key = "Alt-P", shortcut = "Alt-P" }
                , Item { title = "~W~indow color", cmd = "tone", key = "Alt-W", shortcut = "Alt-W" }
                , Item { title = "~T~heme", cmd = "theme", key = "Alt-T", shortcut = "Alt-T" }
                , Tui.Separator
                , Item { title = "E~x~it", cmd = "quit", key = "Alt-X", shortcut = "Alt-X" }
                ]
            }
        ]
    , theme =
        if model.dark then
            midnight

        else
            Tui.borland
    , statusLine =
        [ { text = "~Alt-X~ Exit", key = "Alt-X", cmd = "quit" }
        , { text = "~Alt-P~ Palette", key = "Alt-P", cmd = "palette" }
        , { text = "~Alt-W~ Window color", key = "Alt-W", cmd = "tone" }
        , { text = "~Alt-T~ Theme", key = "Alt-T", cmd = "theme" }
        , { text = "", key = "F10", cmd = "menu" }
        ]
    , windows =
        (if model.showing then
            [ paletteWindow ]

         else
            []
        )
            ++ (if model.showingPlain then
                    [ plainWindow model ]

                else
                    []
               )
    , overlays = []
    }


{-| The original's window, 42 by 11, one line per palette entry.
-}
paletteWindow : Tui.Window
paletteWindow =
    { id = "paletteWin"
    , title = "Colors, said out loud"
    , rect = { x1 = 4, y1 = 1, x2 = 46, y2 = 12 }
    , resize = Tui.resizable
    , palette = Tui.BlueWindow
    , canClose = True
    , canMove = True
    , views =
        [ Canvas
            { id = "colors"
            , rect = { x1 = 2, y1 = 1, x2 = 40, y2 = 9 }
            , lines = Array.map entryLine entries ++ [ bypass ]
            , cursor = Nothing
            , takesFocus = False
            }
        ]
    }


entryLine : Entry -> Array Tui.Span
entryLine entry =
    [ Tui.ink entry.fg
        (" This line uses index "
            ++ entry.index
            ++ ", color is "
            ++ entry.attr
            ++ " "
        )
        |> Tui.on entry.bg
    ]


{-| `palette.cpp`'s last line writes attribute 5 -- magenta on black --
straight into the draw buffer, and its comment says it "bypasses the palettes".
Here every line does.
-}
bypass : Array Tui.Span
bypass =
    [ Tui.ink Magenta "   This line bypasses the palettes!    " |> Tui.on Black ]


{-| ...and this is what a canvas looks like when it says nothing about color:
it takes the window's, which is what you want everywhere the color is not the
point.

`Alt-W` is the proof, and the reason this example is where
[`WindowPalette`](Tui#WindowPalette) is demonstrated. Turbo Vision's three
window color sets are the one part of the palette indirection that survives
being asked to name a color rather than an index -- because there are three of
them and they have names, rather than a hundred and thirty-five of them and
byte offsets. Cycling it repaints every line above **without the lines
changing**: they say nothing about color, so they follow.

The window above it does not follow, because every line in it names both halves
of its color. That is the whole trade, on one screen: say the color and it is
yours to keep; say nothing and it is the window's to change.
-}
plainWindow : Model -> Tui.Window
plainWindow model =
    { id = "plainWin"
    , title = "Saying nothing (" ++ toneName model.tone ++ ")"
    , rect = { x1 = 4, y1 = 13, x2 = 46, y2 = 18 }
    , resize = Tui.resizable
    , palette = model.tone
    , canClose = True
    , canMove = True
    , views =
        [ Canvas
            { id = "plain"
            , rect = { x1 = 2, y1 = 1, x2 = 40, y2 = 4 }
            , lines =
                Array.map Tui.line
                    [ " A span that names no color follows"
                    , " the window, which is how a canvas keeps"
                    , " looking like the rest of the program."
                    ]
            , cursor = Nothing
            , takesFocus = False
            }
        ]
    }


-- PROGRAM


main : Tui.Program Model Msg
main =
    Tui.defineProgram tui
        { init = init
        , update = update
        , subscriptions = \_ -> Sub.none
        , view = view
        , onEvent = FromTui
        }

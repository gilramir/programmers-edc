port module Main exposing (main)

{-| tvision/examples/tvforms, in Gren: a collection of records edited through a
form.

The C++ original is two halves. One is the form -- input lines with labels
bound to them, a group of check boxes, a group of radio buttons, Save and
Cancel -- and that half is what this is. The other half is `opstream` and
`ipstream` writing the views themselves to a `.f32` file, so that a *data file*
carries its own dialog layout. That trick has no meaning here: a Gren view is a
function of the model, and there is nothing to serialise.

What porting it needed that the package did not have:

  - check boxes and radio buttons, which are the whole point of the form
  - labels, which name another view by id -- the first time the order of the
    `views` array means anything beyond who gets focus
  - a list box highlight that travels in both directions. `listdlg.cpp` reads
    `list->focused` the moment Edit is pressed; a model that cannot call into
    C++ has to be told as it moves, which is the `Focused` event -- and because
    the collection is sorted, it also has to be able to say where the highlight
    should go, which is the `focused` field.

-}

import Array exposing (Array)
import Init
import Json.Decode as Decode
import Json.Encode as Encode
import Node
import String
import Tui exposing (Event(..), MenuItem(..), View(..))


-- PORTS


port tuiOut : Encode.Value -> Cmd msg


port tuiIn : (Decode.Value -> msg) -> Sub msg


tui : Tui.Ports Msg
tui =
    { toJs = tuiOut, fromJs = tuiIn }


-- MODEL


{-| The record from `genphone.h`, field for field. `kind` is the Business /
Personal check box group -- both can be true, which is why it is an array and
not a choice -- and `gender` is the index of a radio button.
-}
type alias Record =
    { name : String
    , company : String
    , remarks : String
    , phone : String
    , kind : Array Bool
    , gender : Int
    -- One state per entry in `reachLabels`, indexing into `reachMarks`. The
    -- cluster the other two could not express: a box with more than two
    -- states.
    , reachable : Array Int
    }


type alias Model =
    { records : Array Record
    , focused : Int
    , editing : Maybe Int
    , listOpen : Bool
    }


type Msg
    = FromTui Event


kindLabels : Array String
kindLabels =
    [ "Business", "Personal" ]


genderLabels : Array String
genderLabels =
    [ "Male", "Female" ]


reachLabels : Array String
reachLabels =
    [ "Morning", "Evening" ]


{-| One character per state, drawn between the brackets: never, sometimes,
always. Three states is what makes this a `MultiCheckBoxes` and not a
`CheckBoxes` -- a phone book wants "usually" and a tick cannot say it.
-}
reachMarks : String
reachMarks =
    " ?X"


{-| The four records the C++ demo generates into `phonenum.f32`.
-}
seed : Array Record
seed =
    [ { name = "Helton, Andrew"
      , company = "Asterisk International"
      , remarks = "Purch. Mgr."
      , phone = "(415) 868-3964"
      , kind = [ True, True ]
      , gender = 0
      , reachable = [ 2, 0 ]
      }
    , { name = "White, Natalie"
      , company = "Exclamation, Inc."
      , remarks = "VP sales"
      , phone = "(408) 242-2030"
      , kind = [ True, False ]
      , gender = 1
      , reachable = [ 1, 1 ]
      }
    , { name = "Stern, Peter"
      , company = ""
      , remarks = "Decent violinist"
      , phone = "(111) 222-5555"
      , kind = [ False, True ]
      , gender = 0
      , reachable = [ 0, 2 ]
      }
    , { name = "Whitcom, Hana O."
      , company = "Nate's girlfriend"
      , remarks = "Birthday: Jan 8, 1990"
      , phone = "(408) 426-1234"
      , kind = [ False, True ]
      , gender = 1
      , reachable = [ 2, 2 ]
      }
    ]


empty : Record
empty =
    { name = ""
    , company = ""
    , remarks = ""
    , phone = ""
    , kind = [ True, False ]
    , gender = 0
    , reachable = [ 0, 0 ]
    }


init : Node.Environment -> Init.Task { model : Model, command : Cmd Msg }
init _ =
    Node.startProgram
        { model =
            { records = sorted seed
            , focused = 0
            , editing = Nothing
            , listOpen = True
            }
        , command = Cmd.none
        }


{-| `TDataCollection` is a sorted collection keyed on the name, so the list is
always in order and a renamed record moves. Here that is one call.
-}
sorted : Array Record -> Array Record
sorted records =
    Array.sortBy .name records


current : Model -> Maybe Record
current model =
    Array.get model.focused model.records


-- UPDATE


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        FromTui event ->
            handleEvent event model


handleEvent : Event -> Model -> { model : Model, command : Cmd Msg }
handleEvent event model =
    when event is
        Command "new" ->
            { model = { model | editing = Nothing }
            , command = formDialog "New record" empty
            }

        Command "edit" ->
            edit model model.focused

        Command "delete" ->
            let
                left =
                    Array.remove model.focused model.records
            in
            { model =
                { model
                    | records = left
                    , focused = min model.focused (max 0 (Array.length left - 1))
                }
            , command = enableRecordCommands (not (Array.isEmpty left))
            }

        Command "list" ->
            { model = { model | listOpen = True }, command = Cmd.none }

        Command _ ->
            { model = model, command = Cmd.none }

        -- The highlight moved. This is the event this port put into the API:
        -- without it, Edit and Delete would have nothing to act on.
        Focused moved ->
            { model = { model | focused = moved.index }, command = Cmd.none }

        -- Committing a row (Space, or a double click) edits it, the way
        -- cmListItemSelected does in the original.
        Selected chosen ->
            edit { model | focused = chosen.index } chosen.index

        KeyPressed _ ->
            { model = model, command = Cmd.none }

        Clicked _ ->
            { model = model, command = Cmd.none }

        Dragged _ ->
            { model = model, command = Cmd.none }

        DialogClosed closed ->
            if closed.cmd == "save" then
                save (fromValues closed.values) model

            else
                { model = model, command = Cmd.none }

        WindowClosed "list" ->
            { model = { model | listOpen = False }, command = Cmd.none }

        WindowClosed _ ->
            { model = model, command = Cmd.none }

        Scrolled _ ->
            { model = model, command = Cmd.none }

        -- Fixed-size forms in fixed-size windows; the size is nothing this one
        -- needs. examples/entries is the one that lays out against it.
        Resized _ ->
            { model = model, command = Cmd.none }

        -- Nor is the window's: the form inside it is fixed-size, so the
        -- window says `resize = Tui.fixedSize` and this never arrives.
        WindowResized _ ->
            { model = model, command = Cmd.none }

        -- Every editable control here is inside the form *dialog*, and its
        -- values are read from the answer when Save is pressed. So these
        -- arrive -- a dialog's fields report like any other -- and there is
        -- nothing this model wants to do with them before then. It is the
        -- example that found the hole; examples/entries is the one that needed
        -- it filled, because its filter box is in an ordinary window.
        Changed _ ->
            { model = model, command = Cmd.none }

        Edited _ ->
            { model = model, command = Cmd.none }

        Searched _ ->
            { model = model, command = Cmd.none }

        EditorText _ ->
            { model = model, command = Cmd.none }

        Copied _ ->
            { model = model, command = Cmd.none }

        ClipboardText _ ->
            { model = model, command = Cmd.none }

        Unknown _ ->
            { model = model, command = Cmd.none }


edit : Model -> Int -> { model : Model, command : Cmd Msg }
edit model index =
    when Array.get index model.records is
        Just record ->
            { model = { model | editing = Just index }
            , command = formDialog "Edit record" record
            }

        Nothing ->
            { model = model, command = Cmd.none }


{-| Everything a dialog holds comes back in one `values` object, read out by
field id.
-}
fromValues : Decode.Value -> Record
fromValues values =
    { name = String.trim (Tui.text "name" values)
    , company = String.trim (Tui.text "company" values)
    , remarks = String.trim (Tui.text "remarks" values)
    , phone = String.trim (Tui.text "phone" values)
    , kind = Tui.flags "kind" values
    , gender = Tui.number "gender" values
    -- The fourth shape a dialog's answer can carry, beside text, a number and
    -- a row of flags: one state index per box.
    , reachable = Tui.marks "reach" values
    }


save : Record -> Model -> { model : Model, command : Cmd Msg }
save record model =
    if String.isEmpty record.name then
        -- The original refuses a record with no key, and so does this.
        { model = model, command = Cmd.none }

    else
        let
            records =
                when model.editing is
                    Just index ->
                        sorted (Array.set index record model.records)

                    Nothing ->
                        sorted (Array.pushLast record model.records)

            -- Sorting moves the record, so the highlight follows it there
            -- rather than staying on whatever row it used to occupy.
            landed =
                Array.findFirst (\r -> r.name == record.name) records
                    |> Maybe.map .index
                    |> Maybe.withDefault model.focused
        in
        { model = { model | records = records, focused = landed, editing = Nothing }
        , command = enableRecordCommands True
        }


{-| Edit and Delete mean nothing with no records. Disabling the *command* greys
it out everywhere it appears at once -- the menu entry, the status line entry
and the button in the window -- and makes every route to it inert.
-}
enableRecordCommands : Bool -> Cmd Msg
enableRecordCommands on =
    Cmd.batch
        [ Tui.setEnabled tui "edit" on
        , Tui.setEnabled tui "delete" on
        ]


-- THE FORM


{-| `makeForm()` from `genphone.h`, at the same coordinates.

Two rules decide the order of this array. A label names a view that must
already exist, so every control comes before its label; and the first
selectable view gets focus, which is why the name field is first.

The hotkeys are the original's -- `~N~ame`, `~C~ompany`, `~R~emarks`,
`~P~hone`, `~T~ype`, `~G~ender` -- which is only possible because the status
line stays off `Alt-`letter entirely. A status entry is offered every keystroke
before an open modal dialog sees it, so `Alt-N` on the status line would make
`~N~ame` unreachable in here.
-}
formDialog : String -> Record -> Cmd Msg
formDialog title record =
    Tui.dialog tui
        { id = "form"
        , title = title
        -- Three rows taller than it was, for the third cluster.
        , rect = { x1 = 5, y1 = 2, x2 = 46, y2 = 22 }
        , views =
            [ InputLine { id = "name", rect = { x1 = 11, y1 = 2, x2 = 38, y2 = 3 }, maxLen = 25, value = record.name, allowed = Nothing }
            , Label { id = "nameLabel", rect = { x1 = 1, y1 = 2, x2 = 9, y2 = 3 }, text = "~N~ame", for = "name" }
            , InputLine { id = "company", rect = { x1 = 11, y1 = 4, x2 = 36, y2 = 5 }, maxLen = 23, value = record.company, allowed = Nothing }
            , Label { id = "companyLabel", rect = { x1 = 1, y1 = 4, x2 = 9, y2 = 5 }, text = "~C~ompany", for = "company" }
            , InputLine { id = "remarks", rect = { x1 = 11, y1 = 6, x2 = 35, y2 = 7 }, maxLen = 22, value = record.remarks, allowed = Nothing }
            , Label { id = "remarksLabel", rect = { x1 = 1, y1 = 6, x2 = 9, y2 = 7 }, text = "~R~emarks", for = "remarks" }
            -- The one field with a filter on it. `allowed` is the last piece
            -- of the hole `Changed` opened: a keystroke outside the set never
            -- reaches the field, so it is the one thing a model told about
            -- every value change still could not do. It is also the one that
            -- says nothing back -- a rejected key did not happen, so there is
            -- no event for it, which is how it fits a protocol that has never
            -- carried a question.
            , InputLine
                { id = "phone"
                , rect = { x1 = 11, y1 = 8, x2 = 33, y2 = 9 }
                , maxLen = 20
                , value = record.phone
                , allowed = Just "0123456789 ()+-."
                }
            , Label { id = "phoneLabel", rect = { x1 = 1, y1 = 8, x2 = 9, y2 = 9 }, text = "~P~hone", for = "phone" }
            , CheckBoxes { id = "kind", rect = { x1 = 11, y1 = 11, x2 = 25, y2 = 13 }, items = kindLabels, checked = record.kind }
            , Label { id = "kindLabel", rect = { x1 = 11, y1 = 10, x2 = 19, y2 = 11 }, text = "~T~ype", for = "kind" }
            , RadioButtons { id = "gender", rect = { x1 = 26, y1 = 11, x2 = 38, y2 = 13 }, items = genderLabels, selected = record.gender }
            , Label { id = "genderLabel", rect = { x1 = 26, y1 = 10, x2 = 34, y2 = 11 }, text = "~G~ender", for = "gender" }
            -- The third kind of cluster, and the one the other two cannot
            -- express: every box has three states rather than two, and
            -- `marks` says what each of them looks like. Space, a click or
            -- the hotkey moves a box to the next state and wraps.
            , MultiCheckBoxes
                { id = "reach"
                , rect = { x1 = 11, y1 = 15, x2 = 27, y2 = 17 }
                , items = reachLabels
                , marks = reachMarks
                , states = record.reachable
                }
            , Label { id = "reachLabel", rect = { x1 = 1, y1 = 14, x2 = 10, y2 = 15 }, text = "Reac~h~", for = "reach" }
            , Button { id = "save", rect = { x1 = 13, y1 = 17, x2 = 25, y2 = 19 }, title = "~S~ave", cmd = "save", isDefault = True, takesFocus = True }
            , Button { id = "cancel", rect = { x1 = 27, y1 = 17, x2 = 39, y2 = 19 }, title = "Cancel", cmd = "cancel", isDefault = False, takesFocus = True }
            ]
        }


-- VIEW


view : Model -> Tui.Ui
view model =
    { menuBar =
        [ SubMenu
            { title = "~F~ile"
            , key = "Alt-F"
            , items =
                [ Item { title = "~N~ew record...", cmd = "new", key = "", shortcut = "F2" }
                , Item { title = "~E~dit record...", cmd = "edit", key = "", shortcut = "F3" }
                , Item { title = "~D~elete record", cmd = "delete", key = "", shortcut = "F8" }
                , Separator
                , Item { title = "E~x~it", cmd = "quit", key = "Alt-X", shortcut = "Alt-X" }
                ]
            }
        , SubMenu
            { title = "~W~indow"
            , key = "Alt-W"
            , items =
                [ Item { title = "~L~ist", cmd = "list", key = "", shortcut = "" }
                , Item { title = "~C~lose", cmd = "close", key = "", shortcut = "Alt-F3" }
                ]
            }
        ]
    -- Function keys, not Alt-letters: the status line is offered every
    -- keystroke before anything else, dialogs included, so anything bound
    -- here is spent for the whole program. The menu entries above name the
    -- same keys as hints and leave the binding to these.
    , theme = Tui.borland
    , statusLine =
        [ { text = "~F2~ New", key = "F2", cmd = "new" }
        , { text = "~F3~ Edit", key = "F3", cmd = "edit" }
        , { text = "~F8~ Delete", key = "F8", cmd = "delete" }
        , { text = "~F10~ Menu", key = "F10", cmd = "menu" }
        , { text = "~Alt-X~ Exit", key = "Alt-X", cmd = "quit" }
        ]
    , windows =
        Array.append
            (if model.listOpen then
                [ listWindow model ]

             else
                []
            )
            [ detailWindow model ]
    , overlays = []
    }


listWindow : Model -> Tui.Window
listWindow model =
    { id = "list"
    , title = "Phone Numbers (" ++ String.fromInt (Array.length model.records) ++ ")"
    , rect = { x1 = 1, y1 = 0, x2 = 45, y2 = 15 }
    -- Two windows laid out side by side to fill an 80x25 terminal exactly.
    -- Either one resized would overlap the other, and neither has a `Grows`
    -- to make the space useful, so neither is resizable.
    , resize = Tui.fixedSize
    , palette = Tui.BlueWindow
    , views =
        [ ListBox
            { id = "keys"
            , rect = { x1 = 2, y1 = 2, x2 = 28, y2 = 12 }
            , items = Array.map .name model.records
            , focused = model.focused
            , chooses = ""
            }
        -- After the list box, not before it: a label names a view that has to
        -- exist already.
        , Label { id = "keysLabel", rect = { x1 = 2, y1 = 1, x2 = 12, y2 = 2 }, text = "~K~eys", for = "keys" }
        , Button { id = "editButton", rect = { x1 = 30, y1 = 2, x2 = 42, y2 = 4 }, title = "~E~dit", cmd = "edit", isDefault = True, takesFocus = True }
        , Button { id = "newButton", rect = { x1 = 30, y1 = 4, x2 = 42, y2 = 6 }, title = "~N~ew", cmd = "new", isDefault = False, takesFocus = True }
        , Button { id = "deleteButton", rect = { x1 = 30, y1 = 6, x2 = 42, y2 = 8 }, title = "~D~elete", cmd = "delete", isDefault = False, takesFocus = True }
        ]
    }


{-| Not in the original, and the reason it can exist here: the model is told as
the highlight moves, so a second window can show what it is sitting on.
-}
detailWindow : Model -> Tui.Window
detailWindow model =
    let
        record =
            current model |> Maybe.withDefault empty

        ticked =
            Array.indexedKeepIf
                (\index _ -> Array.get index record.kind |> Maybe.withDefault False)
                kindLabels

        -- The same marks the cluster draws, so the panel and the form agree
        -- character for character.
        reachSummary =
            reachLabels
                |> Array.indexedMap
                    (\index label ->
                        let
                            state =
                                Array.get index record.reachable
                                    |> Maybe.withDefault 0
                        in
                        label ++ " [" ++ String.slice state (state + 1) reachMarks ++ "]"
                    )
                |> String.join "  "
    in
    { id = "detail"
    , title = "Record"
    , rect = { x1 = 46, y1 = 0, x2 = 79, y2 = 17 }
    , resize = Tui.fixedSize
    , palette = Tui.BlueWindow
    , views =
        [ field 1 "Name" record.name
        , field 3 "Company" record.company
        , field 5 "Remarks" record.remarks
        , field 7 "Phone" record.phone
        , field 9 "Type" (String.join ", " ticked)
        , field
            11
            "Gender"
            (Array.get record.gender genderLabels |> Maybe.withDefault "")
        , field 13 "Reachable" reachSummary
        , StaticText
            { id = "hint"
            , rect = { x1 = 2, y1 = 15, x2 = 31, y2 = 16 }
            , text =
                if Array.isEmpty model.records then
                    "F2 adds one."

                else
                    "Arrows move; Space edits."
            }
        ]
    }


{-| A caption and its value, two rows. Every id here is stable across renders,
so a new highlight patches the text rather than rebuilding the window.
-}
field : Int -> String -> String -> View
field row caption value =
    StaticText
        { id = "field" ++ String.fromInt row
        , rect = { x1 = 2, y1 = row, x2 = 31, y2 = row + 2 }
        , text = caption ++ ":\n  " ++ value
        }


-- PROGRAM


main : Tui.Program Model Msg
main =
    Tui.defineProgram tui
        { init = init
        , update = update
        , subscriptions = \_ -> Sub.none
        , view = view
        , onEvent = FromTui
        }

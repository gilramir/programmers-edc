port module Main exposing (main)

{-| tvdemo's mouse options dialog (`tvision/examples/tvdemo/mousedlg.cpp`), in
Gren.

A scroll bar sets how long Turbo Vision waits before deciding two clicks were a
double click, and a strip of text above it lets you feel where that boundary
is: double-click the strip and it changes colour. Move the bar towards `Slow`
and a lazier pair of clicks counts; move it towards `Fast` and the same pair
counts as two.

Three things had to exist before this could be written, and all three are worth
naming.

**A scroll bar the model owns.** A list box has always made one for itself, but
there was no way to put one in a window and ask what it says. `ScrollBar` is
that, and it reports a [`Scrolled`](Tui#Event) event however it moves --
arrows, page clicks, a drag on the thumb, or the keyboard. A drag reports only
where it *ended*: `TScrollBar` calls `scrollDraw()` for every cell the thumb
passes, and a model that re-rendered on each of those would redraw the window a
dozen times per gesture.

**Which way it points is not a field.** `TScrollBar`'s constructor decides from
its own rectangle -- one column wide is vertical, anything else horizontal --
and inventing an `orientation` field to sit next to a rectangle that already
says the same thing would only give the two a way to disagree.

**A click that knows it is the second one.** `TClickTester` reacts to
`meDoubleClick`, so `Clicked` grew `isDouble`. The first click of a pair still
arrives on its own a moment earlier, which is exactly the behaviour being
demonstrated here.

The dialog is a plain window rather than a modal one, because the whole point
is to click things elsewhere while it is open.

-}

import Array exposing (Array)
import Init
import Json.Decode as Decode
import Json.Encode as Encode
import Node
import String
import Tui exposing (Event(..), Hue(..), MenuItem(..), View(..))


-- PORTS


port tuiOut : Encode.Value -> Cmd msg


port tuiIn : (Decode.Value -> msg) -> Sub msg


tui : Tui.Ports Msg
tui =
    { toJs = tuiOut, fromJs = tuiIn }


-- MODEL


type alias Model =
    { delay : Int
    , clicked : Bool
    , doubles : Int
    , singles : Int
    , open : Bool
    }


type Msg
    = FromTui Event


{-| `TEventQueue::doubleDelay` starts at 8 ticks of the original PC timer,
which is 8/18.2 of a second. The scroll bar's range is the original's: 1 to 20.
-}
initialDelay : Int
initialDelay =
    8


init : Node.Environment -> Init.Task { model : Model, command : Cmd Msg }
init _ =
    Node.startProgram
        { model =
            { delay = initialDelay
            , clicked = False
            , doubles = 0
            , singles = 0
            , open = True
            }
        , command = Tui.setDoubleClickDelay tui initialDelay
        }


-- UPDATE


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        FromTui (Scrolled bar) ->
            -- The one place the delay is set. Turbo Vision keeps it in a
            -- static, so this is a command rather than part of the view.
            { model = { model | delay = bar.value }
            , command = Tui.setDoubleClickDelay tui bar.value
            }

        FromTui (Clicked spot) ->
            { model =
                if spot.isDouble then
                    { model | clicked = not model.clicked, doubles = model.doubles + 1 }

                else
                    { model | singles = model.singles + 1 }
            , command = Cmd.none
            }

        FromTui (Command "mouse") ->
            { model = { model | open = True }, command = Cmd.none }

        FromTui (Command "reset") ->
            { model = { model | delay = initialDelay, doubles = 0, singles = 0, clicked = False }
            , command = Tui.setDoubleClickDelay tui initialDelay
            }

        FromTui (WindowClosed "mouseWin") ->
            { model = { model | open = False }, command = Cmd.none }

        FromTui _ ->
            { model = model, command = Cmd.none }


-- VIEW


view : Model -> Tui.Ui
view model =
    { menuBar =
        [ SubMenu
            { title = "~O~ptions"
            , key = "Alt-O"
            , items =
                [ Item { title = "~M~ouse...", cmd = "mouse", key = "Alt-M", shortcut = "Alt-M" }
                , Item { title = "~R~eset", cmd = "reset", key = "Alt-R", shortcut = "Alt-R" }
                , Tui.Separator
                , Item { title = "E~x~it", cmd = "quit", key = "Alt-X", shortcut = "Alt-X" }
                ]
            }
        ]
    , theme = Tui.borland
    , statusLine =
        [ { text = "~Alt-X~ Exit", key = "Alt-X", cmd = "quit" }
        , { text = "~Alt-M~ Mouse", key = "Alt-M", cmd = "mouse" }
        , { text = "Double-click the strip", key = "", cmd = "" }
        , { text = "", key = "F10", cmd = "menu" }
        ]
    , windows =
        if model.open then
            [ mouseWindow model ]

        else
            []
    , overlays = []
    }


mouseWindow : Model -> Tui.Window
mouseWindow model =
    { id = "mouseWin"
    , title = "Mouse options"
    , rect = { x1 = 20, y1 = 4, x2 = 54, y2 = 16 }
    , resize = Tui.resizable
    , palette = Tui.BlueWindow
    , views =
        -- The tester says takesFocus = False, and it has to: a focused canvas
        -- eats every key it is given, Tab included, so a canvas that is only
        -- there to be double-clicked would trap the caret and the scroll bar
        -- below it could never be reached from the keyboard. Clicks reach it
        -- either way. The label comes after the scroll bar because a label
        -- has to name a view that has already been built.
        [ Canvas
            { id = "tester"
            , rect = { x1 = 3, y1 = 3, x2 = 30, y2 = 4 }
            , lines = [ testerLine model ]
            , cursor = Nothing
            , takesFocus = False
            }
        , Tui.ScrollBar
            { id = "delay"
            , rect = { x1 = 3, y1 = 4, x2 = 30, y2 = 5 }
            , value = model.delay
            , min = 1
            , max = 20
            , pageStep = 4
            , arrowStep = 1
            }
        , Tui.Label
            { id = "delayLabel"
            , rect = { x1 = 2, y1 = 2, x2 = 21, y2 = 3 }
            , text = "~M~ouse double click"
            , for = "delay"
            }
        , Tui.StaticText
            { id = "report"
            , rect = { x1 = 2, y1 = 6, x2 = 32, y2 = 7 }
            , text = report model
            }
        , Tui.StaticText
            { id = "counts"
            , rect = { x1 = 2, y1 = 7, x2 = 32, y2 = 8 }
            , text =
                "singles "
                    ++ String.fromInt model.singles
                    ++ "   doubles "
                    ++ String.fromInt model.doubles
            }
        , Tui.Button
            { id = "reset"
            , rect = { x1 = 9, y1 = 9, x2 = 19, y2 = 11 }
            , title = "~R~eset"
            , cmd = "reset"
            , isDefault = True
            , takesFocus = True
            }
        ]
    }


{-| The original's `Fast Medium Slow` strip, which `TClickTester` draws in
`getColor(1)` or `getColor(2)` depending on whether it has been double-clicked.
Here the two colours are said out loud.
-}
testerLine : Model -> Array Tui.Span
testerLine model =
    if model.clicked then
        [ Tui.ink Yellow "Fast       Medium      Slow" |> Tui.on Red ]

    else
        Tui.line "Fast       Medium      Slow"


report : Model -> String
report model =
    "delay "
        ++ String.padLeft 2 ' ' (String.fromInt model.delay)
        ++ " ticks ("
        ++ String.fromInt (model.delay * 1000 // 18)
        ++ " ms)"


-- PROGRAM


main : Tui.Program Model Msg
main =
    Tui.defineProgram tui
        { init = init
        , update = update
        , subscriptions = \_ -> Sub.none
        , view = view
        , onEvent = FromTui
        }

port module Main exposing (main)

{-| tvdemo's shell (`tvision/examples/tvdemo`), in Gren: the parts of that
program that are about the *application* rather than about one of the demos
inside it. Its windows, its `Windows` menu, its event viewer and its clock.
The demos themselves are `examples/ascii`, `calendar`, `puzzle`, `calc` and
`mouse`.

Three things are worth pointing at.

**Tile and cascade are Turbo Vision's, not the model's.** `cmTile` and
`cmCascade` move every window on the desktop, which is exactly the kind of
thing this API has spent nine examples pulling *into* the model -- and it
should stay where it is. A window's rectangle is where the model put it until
the user moves, zooms or tiles it, and after that the model has no opinion:
`Ui` lists which windows exist, not where they are. Writing them down would
mean fighting the user for the mouse.

Getting there found a bug. `Tui`'s documentation has promised `"tile"` and
`"cascade"` as built-in command names since the beginning, and the binding did
not intern either: they were handed out as ordinary user commands, so `Tile`
did nothing but send the model an event. `TApplication` handles those two,
where everything else on that list is `TProgram`'s, which is why they were the
two to be missed. `tools/check_consistency.py` now cross-checks the list.

**The event viewer sees less than the original's, and that is the design.**
`TEventViewer` hooks `getEvent` and prints every `TEvent` the application
receives -- mouse moves included. A Gren model is told what its *views* report:
a command, a selection, a key that reached a canvas. Everything Turbo Vision
handled on its own -- the click that raised a window, the arrow that moved a
highlight, every mouse move -- never crosses the port. That is the whole
bargain, and a window that lists what does cross it is a fair way to show it.

**Right-click a note.** The context menu that comes up holds three of Turbo
Vision's own window commands, and `update` does not handle any of them -- the
same three do the same thing from the Windows menu, from their function keys
and from here, because a command from a popup is a command. It is also where
to watch the clock: it keeps ticking with the menu open, which `TMenuPopup`
would not have allowed.

**The clock is a view on the application, which is what `TClockView` is.** It
sat in the status line for a long time here, because `Ui` had a menu bar, a
status line and windows and nothing in between. That worked and rebuilt the
status line once a second, since a status line is replaced whole -- and that
is exactly why Borland made the clock a view. `overlays` is that missing
place: above every window, uncoverable, never tiled, and in screen
coordinates. The clock is one `StaticText` in it, patched rather than rebuilt.

-}

import Array exposing (Array)
import Init
import Json.Decode as Decode
import Json.Encode as Encode
import Math
import Node
import String
import Task
import Time
import Tui exposing (Event(..), Hue(..), MenuItem(..), PopupItem(..), View(..))


-- PORTS


port tuiOut : Encode.Value -> Cmd msg


port tuiIn : (Decode.Value -> msg) -> Sub msg


tui : Tui.Ports Msg
tui =
    { toJs = tuiOut, fromJs = tuiIn }


-- MODEL


type alias Note =
    { id : Int
    , body : Array String
    }


type alias Model =
    { notes : Array Note
    , nextId : Int
    , events : Array String
    , watching : Bool
    , stopped : Bool
    , hue : Hue
    , now : Time.Posix
    , zone : Time.Zone
    -- Only the About box needs this, and it needs it because a message box
    -- centres itself and a rectangle is in desktop coordinates.
    , desktop : { cols : Int, rows : Int }
    }


type Msg
    = Tick Time.Posix
    | GotZone Time.Zone
    | FromTui Event


init : Node.Environment -> Init.Task { model : Model, command : Cmd Msg }
init _ =
    Node.startProgram
        { model =
            { notes = [ note 1, note 2 ]
            , nextId = 3
            , events = []
            , watching = True
            , stopped = False
            , hue = LightCyan
            , now = Time.millisToPosix 0
            , zone = Time.utc
            , desktop = { cols = 80, rows = 23 }
            }
        , command = Task.perform GotZone Time.here
        }


note : Int -> Note
note id =
    { id = id
    , body =
        [ "Note " ++ String.fromInt id ++ "."
        , ""
        , "Move it, zoom it, tile the"
        , "desktop -- none of which the"
        , "model is told about, and none"
        , "of which it needs to be."
        ]
    }


-- UPDATE


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        GotZone zone ->
            { model = { model | zone = zone }, command = Cmd.none }

        Tick now ->
            { model = { model | now = now }, command = Cmd.none }

        FromTui event ->
            handleEvent event (record event model)


{-| Everything the model is told, in the order it was told. The original's
viewer prints every `TEvent` the application sees; this one can only print what
crossed the port, which is the point of having it.
-}
record : Event -> Model -> Model
record event model =
    if model.stopped then
        model

    else
        { model | events = Array.takeLast 200 (Array.pushLast (describe event) model.events) }


yesNo : Bool -> String
yesNo on =
    if on then
        "on"

    else
        "off"


describe : Event -> String
describe event =
    when event is
        Command name ->
            "Command " ++ name

        Selected it ->
            "Selected " ++ it.id ++ " #" ++ String.fromInt it.index

        Focused it ->
            "Focused " ++ it.id ++ " #" ++ String.fromInt it.index

        KeyPressed it ->
            "KeyPressed " ++ it.id ++ " " ++ it.key

        Clicked it ->
            "Clicked "
                ++ it.id
                ++ " ("
                ++ String.fromInt it.x
                ++ ", "
                ++ String.fromInt it.y
                ++ ")"
                ++ (if it.isDouble then
                        " double"

                    else
                        ""
                   )
                ++ (if it.isRight then
                        " right"

                    else
                        ""
                   )

        Scrolled it ->
            "Scrolled " ++ it.id ++ " = " ++ String.fromInt it.value

        Resized it ->
            "Resized " ++ String.fromInt it.cols ++ "x" ++ String.fromInt it.rows

        Changed it ->
            "Changed "
                ++ it.id
                ++ " = "
                ++ (when it.value is
                        Tui.Text text ->
                            text

                        Tui.Flags bits ->
                            String.join "," (Array.map yesNo bits)

                        Tui.Choice index ->
                            String.fromInt index

                        Tui.Marks states ->
                            String.join "," (Array.map String.fromInt states)
                   )

        DialogClosed it ->
            "DialogClosed " ++ it.id ++ " " ++ it.cmd

        WindowClosed id ->
            "WindowClosed " ++ id

        Edited it ->
            "Edited "
                ++ it.id
                ++ " "
                ++ String.fromInt (it.line + 1)
                ++ ":"
                ++ String.fromInt (it.column + 1)

        EditorText it ->
            "EditorText " ++ it.id ++ " (" ++ String.fromInt (String.count it.text) ++ " chars)"

        Unknown what ->
            "Unknown " ++ what


handleEvent : Event -> Model -> { model : Model, command : Cmd Msg }
handleEvent event model =
    when event is
        Command "new" ->
            { model =
                { model
                    | notes = Array.pushLast (note model.nextId) model.notes
                    , nextId = model.nextId + 1
                }
            , command = Cmd.none
            }

        Command "events" ->
            { model = { model | watching = not model.watching }, command = Cmd.none }

        Resized size ->
            { model = { model | desktop = size }, command = Cmd.none }

        Command "stop" ->
            { model = { model | stopped = not model.stopped }, command = Cmd.none }

        Command "clear" ->
            { model = { model | events = [] }, command = Cmd.none }

        Command "about" ->
            { model = model, command = Tui.dialog tui (aboutDialog model) }

        -- A right click on a note asks for a context menu, and asking is all
        -- it does. Every entry on it is one of Turbo Vision's own window
        -- commands, already on the Windows menu above, and not one of them is
        -- handled here or anywhere in this file -- so the menu is proof of
        -- two things at once: a command from a popup is indistinguishable
        -- from the same command anywhere else, and the clock in the status
        -- line keeps ticking while the menu is up. The second is the whole
        -- reason this is not Turbo Vision's own TMenuPopup, whose execute()
        -- would stop it.
        Clicked click ->
            if click.isRight then
                { model = model
                , command =
                    Tui.popupMenu tui
                        { view = click.id
                        , at = { x = click.x, y = click.y }
                        , items =
                            [ Entry { title = "~Z~oom", cmd = "zoom", shortcut = "F5" }
                            , Entry { title = "~N~ext", cmd = "next", shortcut = "F6" }
                            , Divider
                            , Entry { title = "~C~lose", cmd = "close", shortcut = "Alt-F3" }
                            ]
                        }
                }

            else
                { model = model, command = Cmd.none }

        Command "colours" ->
            { model = model, command = Tui.dialog tui (coloursDialog model) }

        DialogClosed closed ->
            if closed.id == "colours" && closed.cmd == "ok" then
                { model = { model | hue = hueAt (Tui.number "pick" closed.values) }
                , command = Cmd.none
                }

            else
                { model = model, command = Cmd.none }

        -- Windows the user closed from the frame have to leave the model, or
        -- the next render puts them back. This is the one piece of window
        -- management the model does have to care about.
        WindowClosed id ->
            { model =
                { model
                    | notes = Array.keepIf (\it -> windowId it /= id) model.notes
                    , watching =
                        if id == "eventWin" then
                            False

                        else
                            model.watching
                }
            , command = Cmd.none
            }

        _ ->
            { model = model, command = Cmd.none }


hues : Array { name : String, hue : Hue }
hues =
    [ { name = "Light ~c~yan", hue = LightCyan }
    , { name = "~Y~ellow", hue = Yellow }
    , { name = "Light ~g~reen", hue = LightGreen }
    , { name = "Light ~r~ed", hue = LightRed }
    , { name = "~W~hite", hue = White }
    ]


hueAt : Int -> Hue
hueAt index =
    Array.get index hues
        |> Maybe.map .hue
        |> Maybe.withDefault LightCyan


hueIndex : Hue -> Int
hueIndex hue =
    Array.findFirst (\it -> it.hue == hue) hues
        |> Maybe.map .index
        |> Maybe.withDefault 0


-- SUBSCRIPTIONS


subscriptions : Model -> Sub Msg
subscriptions _ =
    Time.every 1000 Tick


-- VIEW


view : Model -> Tui.Ui
view model =
    { menuBar =
        [ SubMenu
            { title = "~≡~"
            , key = ""
            , items =
                [ Item { title = "~A~bout...", cmd = "about", key = "", shortcut = "" }
                , Tui.Separator
                , Item { title = "~E~vent viewer", cmd = "events", key = "Alt-0", shortcut = "Alt-0" }
                ]
            }
        , SubMenu
            { title = "~F~ile"
            , key = ""
            , items =
                [ Item { title = "~N~ew note", cmd = "new", key = "F2", shortcut = "F2" }
                , Tui.Separator
                , Item { title = "E~x~it", cmd = "quit", key = "Alt-X", shortcut = "Alt-X" }
                ]
            }
        -- Every one of these is Turbo Vision's own. They never reach the
        -- model, which is why the window rectangles in `view` are a starting
        -- position rather than a running one.
        , SubMenu
            { title = "~W~indows"
            , key = ""
            , items =
                [ Item { title = "~R~esize/move", cmd = "resize", key = "Ctrl-F5", shortcut = "Ctrl-F5" }
                , Item { title = "~Z~oom", cmd = "zoom", key = "F5", shortcut = "F5" }
                , Item { title = "~N~ext", cmd = "next", key = "F6", shortcut = "F6" }
                , Item { title = "~C~lose", cmd = "close", key = "Alt-F3", shortcut = "Alt-F3" }
                , Item { title = "~T~ile", cmd = "tile", key = "", shortcut = "" }
                , Item { title = "C~a~scade", cmd = "cascade", key = "", shortcut = "" }
                ]
            }
        , SubMenu
            { title = "~O~ptions"
            , key = ""
            , items = [ Item { title = "~C~olours...", cmd = "colours", key = "", shortcut = "" } ]
            }
        ]
    , statusLine =
        [ { text = "~Alt-X~ Exit", key = "Alt-X", cmd = "quit" }
        , { text = "~F2~ New", key = "F2", cmd = "new" }
        , { text = "~F5~ Zoom", key = "F5", cmd = "zoom" }
        , { text = "~F6~ Next", key = "F6", cmd = "next" }
        , { text = "~Alt-0~ Events", key = "Alt-0", cmd = "events" }
        ]
    , windows =
        Array.map (noteWindow model) model.notes
            ++ (if model.watching then
                    [ eventWindow model ]

                else
                    []
               )
    -- The clock, and it is a *view* now rather than a status item.
    --
    -- TClockView is inserted into TProgram and not into TDeskTop, which is
    -- what an overlay is: above every window, uncoverable, in screen
    -- coordinates. It used to live in the status line here, which worked and
    -- rebuilt the status line once a second because a status line is replaced
    -- whole -- and that was precisely the reason Borland made the clock a
    -- view. Now it patches one static text.
    --
    -- Screen coordinates, so the width is the *screen's* and `Resized`
    -- reports the desktop's: same width, two rows shorter. Row 0 is the menu
    -- bar's row, which is where tvdemo puts it too, and `pinRight` is
    -- TClockView's own growMode.
    , overlays =
        [ Grows
            { grow = Tui.pinRight
            , view =
                StaticText
                    { id = "clock"
                    , rect =
                        { x1 = model.desktop.cols - 9
                        , y1 = 0
                        , x2 = model.desktop.cols
                        , y2 = 1
                        }
                    , text = clock model
                    }
            }
        ]
    }


clock : Model -> String
clock model =
    let
        two n =
            String.padLeft 2 '0' (String.fromInt n)
    in
    two (Time.toHour model.zone model.now)
        ++ ":"
        ++ two (Time.toMinute model.zone model.now)
        ++ ":"
        ++ two (Time.toSecond model.zone model.now)


windowId : Note -> String
windowId it =
    "note" ++ String.fromInt it.id


{-| The rectangle is where the window *starts*. Tile, cascade, zoom and a drag
on the frame all move it afterwards, and none of them tell the model -- which
is why re-rendering the same rectangle every time does not drag the window back
where it began. A window's position is Turbo Vision's; which windows exist is
the model's.
-}
noteWindow : Model -> Note -> Tui.Window
noteWindow model it =
    let
        -- Staggered, but kept clear of the event viewer on the right: where a
        -- window *starts* is the model's only say in the matter.
        offset =
            Math.modBy 4 it.id * 3
    in
    { id = windowId it
    , title = "Note " ++ String.fromInt it.id
    , rect = { x1 = 1 + offset, y1 = 1 + offset, x2 = 31 + offset, y2 = 10 + offset }
    , views =
        [ Canvas
            { id = windowId it ++ "Body"
            , rect = { x1 = 2, y1 = 1, x2 = 28, y2 = 8 }
            , lines = Array.map (\line -> [ Tui.ink model.hue line ]) it.body
            , cursor = Nothing
            , takesFocus = False
            }
        ]
    }


eventWindow : Model -> Tui.Window
eventWindow model =
    { id = "eventWin"
    , title =
        if model.stopped then
            "Event Viewer (Stopped)"

        else
            "Event Viewer"
    , rect = { x1 = 40, y1 = 1, x2 = 79, y2 = 20 }
    , views =
        [ Canvas
            { id = "eventLog"
            , rect = { x1 = 2, y1 = 1, x2 = 37, y2 = 15 }
            , lines =
                model.events
                    |> Array.takeLast 15
                    |> Array.map (\it -> Tui.line (String.slice 0 35 it))
            , cursor = Nothing
            , takesFocus = False
            }
        , Tui.Button
            { id = "stopButton"
            , rect = { x1 = 2, y1 = 16, x2 = 15, y2 = 18 }
            , title =
                if model.stopped then
                    "~S~tart"

                else
                    "~S~top"
            , cmd = "stop"
            , isDefault = False
            , takesFocus = True
            }
        , Tui.Button
            { id = "clearButton"
            , rect = { x1 = 17, y1 = 16, x2 = 30, y2 = 18 }
            , title = "C~l~ear"
            , cmd = "clear"
            , isDefault = False
            , takesFocus = True
            }
        ]
    }


aboutDialog : Model -> Tui.DialogSpec
aboutDialog model =
    Tui.messageBox
        { id = "about"
        , title = "About"
        , text = "\n\u{0003}TURBO VISION DEMO\n \n\u{0003}the shell of it, in Gren\n \n\u{0003}tile and cascade are Turbo Vision's;\n\u{0003}which windows exist is the model's\n"
        , buttons = Tui.okButtons
        , desktop = model.desktop
        }


{-| tvdemo's `Colors...` opens a `TColorDialog`, which edits the application's
palette. There is no equivalent here and there does not need to be: a colour
dialog is a form, and what it sets is a field. This one is five radio buttons.
-}
coloursDialog : Model -> Tui.DialogSpec
coloursDialog model =
    { id = "colours"
    , title = "Colours"
    , rect = { x1 = 24, y1 = 5, x2 = 56, y2 = 17 }
    , views =
        [ Tui.RadioButtons
            { id = "pick"
            , rect = { x1 = 3, y1 = 2, x2 = 28, y2 = 7 }
            , items = Array.map .name hues
            , selected = hueIndex model.hue
            }
        , Tui.Label
            { id = "pickLabel"
            , rect = { x1 = 2, y1 = 1, x2 = 20, y2 = 2 }
            , text = "~N~ote colour"
            , for = "pick"
            }
        , Tui.Button
            { id = "coloursOk"
            , rect = { x1 = 4, y1 = 8, x2 = 15, y2 = 10 }
            , title = "~O~K"
            , cmd = "ok"
            , isDefault = True
            , takesFocus = True
            }
        , Tui.Button
            { id = "coloursCancel"
            , rect = { x1 = 17, y1 = 8, x2 = 29, y2 = 10 }
            , title = "Cancel"
            , cmd = "cancel"
            , isDefault = False
            , takesFocus = True
            }
        ]
    }


-- PROGRAM


main : Tui.Program Model Msg
main =
    Tui.defineProgram tui
        { init = init
        , update = update
        , subscriptions = subscriptions
        , view = view
        , onEvent = FromTui
        }

{-| Terminal user interfaces on [Turbo Vision][tv], as the Elm architecture.

You write

    view : Model -> Ui

and hand back a description of what should be on screen. The description is
encoded as JSON and sent over a port; the JavaScript runtime on the other side
compares it with what is already there and patches the difference. Events come
back the same way and arrive as messages.

Nothing here calls into C++ and nothing here blocks, including modal dialogs.

[tv]: https://github.com/magiblot/tvision


## A complete program

    port module Main exposing (main)

    import Json.Decode as Decode
    import Json.Encode as Encode
    import Node
    import Tui exposing (Event(..), MenuItem(..), View(..))

    port tuiOut : Encode.Value -> Cmd msg

    port tuiIn : (Decode.Value -> msg) -> Sub msg

    tui : Tui.Ports Msg
    tui =
        { toJs = tuiOut, fromJs = tuiIn }

    type Msg
        = FromTui Event

    main : Tui.Program Int Msg
    main =
        Tui.defineProgram tui
            { init = \_ -> Node.startProgram { model = 0, command = Cmd.none }
            , update = \_ model -> { model = model + 1, command = Cmd.none }
            , subscriptions = \_ -> Sub.none
            , onEvent = FromTui
            , view =
                \model ->
                    { windows =
                        [ { id = "counter"
                          , title = "Counter"
                          , rect = { x1 = 2, y1 = 2, x2 = 40, y2 = 8 }
                          , views =
                                [ StaticText
                                    { id = "count"
                                    , rect = { x1 = 2, y1 = 1, x2 = 30, y2 = 2 }
                                    , text = "clicks: " ++ String.fromInt model
                                    }
                                ]
                          }
                        ]
                    }
            , menuBar = []
            , statusLine =
                [ { text = "~Alt-X~ Exit", key = "Alt-X", cmd = "quit" } ]
            }

Build and run it with:

    gren make Main --output=main.js && gren-tui main.js


## Where the ports come from

Gren packages may not declare ports -- the compiler refuses, to keep the
package ecosystem free of JavaScript -- so the two ports are declared by your
application and handed over as a [`Ports`](#Ports) record, as above. The names
`tuiOut` and `tuiIn` are what the JavaScript runtime looks for.


## Ids are the contract

Every window and every view carries an `id`. Keep it stable across renders:
that is what lets the runtime patch a view in place rather than rebuild it, and
a rebuilt window loses its focus, its scroll position and its place in the
z-order.

Ids also disappear on their own. When a window closes -- including when the
user closes it from its frame -- everything in it is gone, and you find out
through a [`WindowClosed`](#Event) event. A model that ignores that event will
put the window straight back on the next render.


## The menu bar is part of the view too

Turbo Vision builds the menu bar and the status line inside its application
constructor, which makes them look like fixed configuration -- but that is only
where they start. Both live in members that can be swapped while the program
runs, so both are in [`Ui`](#Ui) alongside the windows, and changing one is an
ordinary model change. tvision's own `mmenu` example exists to demonstrate
exactly that, and `examples/mmenu` is it, in a dozen lines.

A menu bar is just a list of [`MenuItem`](#MenuItem)s: an entry with entries of
its own is a pull-down, and one without is a command sitting on the bar.


## Things Turbo Vision does that will surprise you

  - **`Enter` does not press the focused button**, or select a list item, or
    tick a check box. `Space` does all three. `Enter` means "the default action
    of this dialog", and only a button with `isDefault = True` answers it.

  - **Hotkeys are one flat namespace.** Inside a dialog the first control that
    claims `Alt-`*x* gets it. Worse, the status line's keys are global and beat
    even an open modal dialog, so a status entry bound to `Alt-N` makes every
    `~N~ame` field in the program unreachable.

  - **Window rectangles are desktop coordinates.** `y1 = 0` is the row under
    the menu bar, not the top of the screen. Rectangles *inside* a window are
    relative to that window, whose frame occupies row and column zero.

  - **The first click on an inactive window is spent activating it** and does
    not reach the control underneath. The same rule applies one level down: a
    control that can take focus and does not have it spends the first click
    taking it, so a scroll bar beside a focused canvas needs two clicks to
    move. A view that cannot take focus -- `takesFocus = False` -- has no
    first click to spend, which is one more reason to say so where it is true.

@docs Ports
@docs Program, ProgramConfiguration, defineProgram
@docs Ui, Window, View, Rect
@docs Grow, fixed, stretch, stretchWidth, stretchHeight, pinRight, pinBottom
@docs Span, Hue, line, plain, ink, on
@docs MenuItem, StatusItem, PopupItem, popupMenu
@docs Event, Value, DialogSpec
@docs dialog, quit, setEnabled, setDoubleClickDelay, focus
@docs setEditorText, readEditor, findInEditor, replaceInEditor
@docs messageBox, MessageButton, okButtons, okCancelButtons, yesNoButtons, yesNoCancelButtons
@docs fileDialog
@docs text, number, flag, flags, marks

-}

import Array exposing (Array)
import Init
import Json.Decode as Decode
import Json.Encode as Encode
import Node
import Task


-- PORTS


{-| The application's two ports, handed over once. See the note above on why
they cannot live in here.
-}
type alias Ports msg =
    { toJs : Encode.Value -> Cmd msg
    , fromJs : (Decode.Value -> msg) -> Sub msg
    }


{-| Bumped when the wire format changes. The runtime refuses a version it does
not know rather than rendering nothing and leaving you to wonder why: a Gren
package and an npm package version independently, and they will skew.

Version 2 added the cluster and label view types, a list box's `focused` and a
canvas's `cursor`. An older runtime would not have refused any of those -- it
would have passed them to the binding and quietly rebuilt the window on every
change instead of patching it, which is the kind of failure this number exists
to turn into a sentence.

Version 3 made a canvas line an array of coloured [`Span`](#Span)s rather than
a string, and gave a button `takesFocus`. Version 4 added the scroll bar view,
its [`Scrolled`](#Event) event, `isDouble` on a click, and `takesFocus` on a
canvas. Version 5 added [`focus`](#focus), which is the first message this
protocol has carried that names a view rather than describing the whole UI.
Version 6 added the [`Resized`](#Event) event, which is how a program finds
out how big the terminal is -- the first thing the model is told that it did
not ask for and cannot cause. Version 7 added [`Grows`](#View), which puts a
`grow` field on the view it wraps: an older runtime would pass it to a binding
that ignores unknown fields, and the view would silently not move. Version 8
added the [`Changed`](#Event) event and [`Value`](#Value). Version 9 added
[`popupMenu`](#popupMenu) and `isRight` on a [`Clicked`](#Event) event, which
go together: a context menu is opened by the model, and a right click is how
the model finds out it was asked for one. Version 10 added `allowed` on an
[`InputLine`](#View), the set of characters it will accept -- the last piece
of the hole the `Changed` event opened, and the only one of the two that
never has to say anything back. Version 11 added
[`MultiCheckBoxes`](#View) and the `Marks` shape of [`Value`](#Value), which
is the last of the stock controls. Version 12 added `overlays` to
[`Ui`](#Ui) -- views on the application rather than on the desktop, which is
what `TClockView` has always been and this had no way to say. Version 13
added the [`Editor`](#View) view with [`setEditorText`](#setEditorText),
[`readEditor`](#readEditor) and the [`Edited`](#Event) and
[`EditorText`](#Event) events -- the first view whose contents do not travel
with the render. Version 14 added [`findInEditor`](#findInEditor),
[`replaceInEditor`](#replaceInEditor) and the [`Searched`](#Event) event.
-}
protocolVersion : Int
protocolVersion =
    14


-- GEOMETRY


{-| A rectangle in character cells: `x1,y1` is the top-left corner and `x2,y2`
is one past the bottom-right, so `{ x1 = 2, y1 = 1, x2 = 30, y2 = 2 }` is a
single row 28 columns wide.

A window's rectangle is in **desktop** coordinates -- `y1 = 0` is the row below
the menu bar. A view's rectangle is relative to the window that contains it,
whose frame takes up row and column zero, so the usable area starts at 1.
-}
type alias Rect =
    { x1 : Int, y1 : Int, x2 : Int, y2 : Int }


{-| Which of a view's four edges follow its window when the window changes
size.

A window can be zoomed, resized, tiled, or carried along when the terminal
itself changes size, and by default the views inside it keep the rectangle the
model gave them -- so a window that got taller shows the same list box with
empty space underneath it. This is how a view says otherwise.

It is Turbo Vision's own `growMode`, one flag per edge, and Turbo Vision does
the arithmetic in `TGroup::changeBounds`. An edge that follows moves by
whatever the window moved; an edge that does not stays where it is. Which
means the interesting combinations are about *pairs*:

  - **right and bottom** -- the view stretches, keeping its top-left corner.
    That is [`stretch`](#stretch), and it is what a list box or a canvas
    filling a window wants.
  - **top and bottom** (or **left and right**) -- both edges move together, so
    the view keeps its size and slides. That is [`pinBottom`](#pinBottom) and
    [`pinRight`](#pinRight): a row of buttons that stays at the foot of the
    window however tall it gets.

Nothing has to say any of this. A view with no [`Grows`](#View) around it does
not move, which is what every view did before this existed.
-}
type alias Grow =
    { left : Bool, top : Bool, right : Bool, bottom : Bool }


{-| No edge follows: keep the rectangle exactly. The default, and only worth
naming when a model chooses a `Grow` at runtime.
-}
fixed : Grow
fixed =
    { left = False, top = False, right = False, bottom = False }


{-| Right and bottom follow, so the view grows and shrinks with the window
while its top-left corner stays put.
-}
stretch : Grow
stretch =
    { left = False, top = False, right = True, bottom = True }


{-| Only the right edge follows: as wide as the window, as tall as it was. -}
stretchWidth : Grow
stretchWidth =
    { left = False, top = False, right = True, bottom = False }


{-| Only the bottom edge follows: as tall as the window, as wide as it was. -}
stretchHeight : Grow
stretchHeight =
    { left = False, top = False, right = False, bottom = True }


{-| Both horizontal edges follow, so the view keeps its width and stays the
same distance from the window's right-hand edge.
-}
pinRight : Grow
pinRight =
    { left = True, top = False, right = True, bottom = False }


{-| Both vertical edges follow, so the view keeps its height and stays the same
distance from the foot of the window.
-}
pinBottom : Grow
pinBottom =
    { left = False, top = True, right = False, bottom = True }


-- VIEWS


{-| Everything that should be on screen right now: the menu bar across the top,
the status line across the bottom, the windows in between -- and `overlays`,
which are none of those.

Windows not in this list are closed; windows in it that are not on screen are
opened. There is no separate "open a window" command -- put it in the view and
it appears.

**`overlays` are views on the *application*, not on the desktop.** Turbo
Vision's `TClockView` and `THeapView` are inserted into `TProgram` rather than
into `TDeskTop`, and that is not an implementation detail: the desktop is the
patterned area that windows live in, and a clock in the top-right corner is
not in it. A view here is drawn above every window, cannot be covered by one,
never takes part in Tile or Cascade, and is in **screen** coordinates -- row 0
is the menu bar's row, which is where a clock usually goes.

    overlays =
        [ Grows
            { grow = Tui.pinRight
            , view =
                StaticText
                    { id = "clock"
                    , rect = { x1 = cols - 9, y1 = 0, x2 = cols, y2 = 1 }
                    , text = clock model.now
                    }
            }
        ]

The [`Grows`](#Grow) wrapper is what keeps it in the corner when the terminal
is resized; `TClockView` sets the same `growMode` in its own constructor.
Screen coordinates means the width to lay out against is the *screen's*, and
what [`Resized`](#Event) reports is the **desktop's** -- one row shorter at the
top and one at the bottom, and the same width.

The set is rebuilt whole when its shape changes and patched by id when it does
not, exactly as a window's contents are -- which is what lets a clock render
once a second without repainting the corner every time. Overlays are for
showing things; put anything the user has to reach in a window.
-}
type alias Ui =
    { menuBar : Array MenuItem
    , statusLine : Array StatusItem
    , windows : Array Window
    , overlays : Array View
    }


{-| A window on the desktop.

`id` must be stable across renders -- it is how the runtime recognises this as
the same window. `title` can change freely; it is patched in place.

Changing a window's `rect`, or the id, type or rectangle of anything inside it,
is a structural change: the window is closed and rebuilt, losing focus and
z-order. Changing only the *content* of its views is not.
-}
type alias Window =
    { id : String
    , title : String
    , rect : Rect
    , views : Array View
    }


{-| The controls.

  - `StaticText` -- a run of text. Longer than its rectangle is silently
    truncated, so budget the columns.
  - `Button` -- sends `cmd` as a [`Command`](#Event) event when pressed, or
    closes a [`dialog`](#dialog) with it. Press with `Space`; `Enter` only
    reaches a button with `isDefault = True`. `takesFocus = False` makes one
    that can still be pressed -- by mouse, or by its `~`*x*~ hotkey -- but never
    holds the caret, which is what a keypad or a toolbar wants when something
    else in the window is reading the keyboard. A `Canvas` has the same field
    for the same reason.
  - `InputLine` -- a text field. `value` is written to the field only when it
    changes *in the model*, so it never overwrites what the user is typing.
    `allowed` is the set of characters it will accept, as a string:
    `Just "0123456789"` is a field only digits can be typed into, and
    `Nothing` -- which is almost always what you want -- accepts anything.
    A rejected keystroke does not happen, so nothing is reported and there is
    nothing for the model to do about it.

    It filters *typing* and only typing. A `value` the model sets goes in
    whatever it contains: the model put it there, and validating what the
    model itself produced is the model's job. Turbo Vision would refuse to
    close the dialog and put up an error box; this does not, deliberately.
  - `History` -- the `\u{25BC}` drop-down beside an input line, holding what was
    typed into it before. It has no rectangle: it occupies the three columns
    immediately to the **right** of the field it names, which is where Turbo
    Vision puts every one of them, so leave three. **List the field before its
    history**, as with a `Label`. Clicking the arrow -- or pressing `Down` in
    the field -- opens a list of `items`; choosing one puts it in the field and
    arrives as an ordinary [`Changed`](#Event) event *on the field*, because
    that is what happened.

    `items` is the model's array and nothing else writes to it. Turbo Vision
    remembers the field for you, in one buffer shared by the whole program;
    here nothing is remembered until the model decides to remember it, which
    is usually one `Array.pushFirst` when a dialog is answered. That also
    means the list survives a restart if the model saves it, which Turbo
    Vision's never did.
  - `ListBox` -- gets a scroll bar of its own, in the single column
    immediately to the **right** of its rectangle, so leave one. (Turbo Vision
    puts it on the window's frame, which is right for a window that is a list
    and nothing else and wrong for anything with two panes in it.) Moving the
    highlight sends a
    [`Focused`](#Event) event; committing an entry (`Space`, or a double
    click) sends a [`Selected`](#Event) one. `focused` is that highlight seen
    from the other side: it is written to the list only when the model changes
    it, so it steers without fighting the arrow keys.
  - `CheckBoxes` -- a group of boxes, ticked with `Space`. `checked` is one
    flag per item.
  - `MultiCheckBoxes` -- the same cluster with more than two states per box.
    `marks` is one character per state, in order, drawn between the brackets:
    `" ?X"` is a box that cycles blank, `?`, `X`. `states` is one index into
    `marks` per item. Space, a click or the box's hotkey moves an item to the
    next state and wraps.

    Turbo Vision packs every box's state into one 32-bit word, so
    *items* × *bits per state* has to fit in 32 -- eight boxes of four states,
    sixteen of three, and the binding says so rather than dropping the last
    few.
  - `RadioButtons` -- a group of which exactly one is chosen; `selected` is its
    index.
  - `Label` -- text bound to another control by its id, so `Alt-`*x* on the
    label focuses the control. **List the control before its label**: the label
    has to name a view that already exists.
  - `ScrollBar` -- a scroll bar the model owns, as opposed to the one a list
    box makes for itself. Moving it sends a [`Scrolled`](#Event) event, and
    `value` written back from the model moves it. Whether it is horizontal or
    vertical is decided by its rectangle: one column wide is vertical.
  - `Canvas` -- paints exactly the lines it is given, and sends
    [`KeyPressed`](#Event) and [`Clicked`](#Event) events while focused. This is
    the escape hatch for anything the stock controls cannot express: Turbo
    Vision's own calendar and ASCII chart are views of this kind. A line is an
    array of coloured [`Span`](#Span)s; [`line`](#line) makes the common one,
    which is a whole row in the window's own colour. `cursor` is the terminal's
    own block cursor, in the canvas's coordinates -- the only piece of a canvas
    that is not made of characters. `Nothing` hides it.

    `takesFocus` means the same thing here as on a `Button`, and matters more:
    a focused canvas consumes **every** key it receives, `Tab` included, so a
    canvas that is only there to be looked at or clicked should say `False` or
    it will trap the caret. Clicks still arrive either way.

  - `Editor` — a text editor. It gets scroll bars of its own, in the column to
    the **right** and the row **below** its rectangle, so leave one of each.

    **It is the one view with no contents in it**, and that is the whole
    design. Everything else here is a function of the model and is re-rendered
    from it; a document is the first thing too big for that, because `view`
    runs on every tick of every subscription and a file has no business in a
    render message. So the editor owns the buffer and the model owns the
    *file*: [`setEditorText`](#setEditorText) puts a document in,
    [`readEditor`](#readEditor) asks for it back, and what arrives in between
    is an [`Edited`](#Event) event carrying whether the document is modified
    and where the caret is — three numbers, not a file.

    **Give it a fixed rectangle and let [`Grows`](#Grow) resize it.** This is
    the one sharp edge of a view whose contents are not in the view. A
    rectangle is structural — change one and the window is rebuilt — and for
    every other view that is merely wasteful, because the next render
    re-supplies the contents. A rebuilt editor is an *empty* one, and the
    document is gone, because there was never a copy of it in the render to
    put back. A rectangle computed from the model (from
    [`Resized`](#Event), say) will therefore throw the document away the first
    time the terminal changes size. The window's own rectangle is safe: that
    one is patched rather than rebuilt.

    Everything Turbo Vision's editor does, it does here: insert and overwrite,
    selection, one level of undo, a clipboard shared between editors, auto
    indent, word-left and word-right, and the block and line commands from
    Borland's keymap.

    The command names `"editor.cut"`, `"editor.copy"`, `"editor.paste"`,
    `"editor.clear"`, `"editor.undo"` and `"editor.selectAll"` are built in —
    put one on a menu and it reaches whichever editor has the caret without
    passing through `update` at all.

    Two things a menu entry cannot do on its own, both for the same reason:
    they need something only the model has. Saving needs a file, and writing
    one is a `Task` — so the model handles the command and answers with
    [`readEditor`](#readEditor). Searching needs a string, and asking for one
    is a dialog — so the model handles that command and answers with
    [`findInEditor`](#findInEditor).

`Grows` is the odd one, and the only constructor here that is not a widget: it
wraps another view to say which of its edges follow the window when the window
changes size. See [`Grow`](#Grow).

    Grows
        { grow = Tui.stretch
        , view = ListBox { id = "entries", rect = ..., items = ..., focused = 0 }
        }

It is opt-in because most views do not want it, and a wrapper rather than a
field on all twelve records so that a view that does not care says nothing at
all. It takes a record because a Gren variant takes at most one argument, which
is also what makes it look like every other constructor here. It encodes as a
field on the view it wraps, so nothing downstream has a `Grows` to handle.
Wrapping a wrapper is legal and the outer one wins.

The first control in the list gets focus when the window opens -- the first
that *can* take it, so a row of `takesFocus = False` buttons is skipped. Turbo
Vision itself focuses the *last* one added, which in a list written top to
bottom is the Cancel button; this diverges from that deliberately.

A check box the user ticks is state the model cannot see until something asks
for it, and the only thing that asks is a [`dialog`](#dialog) being answered.
Put clusters in dialogs, read them out of `values`, and keep the answer in the
model -- that is the shape every Turbo Vision form has, and it is why
`checked` and `selected` are written to the screen only when the *model*
changes them.
-}
type View
    = StaticText { id : String, rect : Rect, text : String }
    | Button { id : String, rect : Rect, title : String, cmd : String, isDefault : Bool, takesFocus : Bool }
    | InputLine { id : String, rect : Rect, maxLen : Int, value : String, allowed : Maybe String }
    | History { id : String, for : String, items : Array String }
    | ListBox { id : String, rect : Rect, items : Array String, focused : Int }
    | CheckBoxes { id : String, rect : Rect, items : Array String, checked : Array Bool }
    | MultiCheckBoxes { id : String, rect : Rect, items : Array String, marks : String, states : Array Int }
    | RadioButtons { id : String, rect : Rect, items : Array String, selected : Int }
    | ScrollBar { id : String, rect : Rect, value : Int, min : Int, max : Int, pageStep : Int, arrowStep : Int }
    | Label { id : String, rect : Rect, text : String, for : String }
    | Canvas { id : String, rect : Rect, lines : Array (Array Span), cursor : Maybe { x : Int, y : Int }, takesFocus : Bool }
    | Editor { id : String, rect : Rect }
    | Grows { grow : Grow, view : View }


{-| A run of characters on a [`Canvas`](#View) line, painted in one colour.

`Nothing` for either half means the colour the window's palette gives this
view, which is what you want almost everywhere -- it is how a canvas goes on
looking like the rest of the program. Name a colour only where the point *is*
the colour: today on a calendar, a tile that is out of place.

The two halves are separate because naming one is the common case. A span with
a foreground and no background sits on whatever the window is already using,
so a highlight does not have to know the colour scheme it is highlighting
against.

Build them with [`plain`](#plain), [`ink`](#ink) and [`on`](#on) rather than by
hand:

    [ plain "  ", ink Yellow "31", plain " " ]

-}
type alias Span =
    { text : String
    , fg : Maybe Hue
    , bg : Maybe Hue
    }


{-| The sixteen colours a terminal has had since 1981, which is also all that
Turbo Vision's palettes deal in. The bottom eight are the plain ones and the
top eight their bright counterparts; `Brown` is bright-shifted into `Yellow`,
and `LightGray` into `White`, which is why those two names look out of place.
-}
type Hue
    = Black
    | Blue
    | Green
    | Cyan
    | Red
    | Magenta
    | Brown
    | LightGray
    | DarkGray
    | LightBlue
    | LightGreen
    | LightCyan
    | LightRed
    | LightMagenta
    | Yellow
    | White


{-| A whole canvas line in the window's own colour -- the shape of nearly every
line on nearly every canvas.

    lines = Array.map Tui.line [ "Su Mo Tu We Th Fr Sa" ]

-}
line : String -> Array Span
line body =
    [ plain body ]


{-| One span in the window's own colour, for the parts of a mixed line that are
not the interesting part.
-}
plain : String -> Span
plain body =
    { text = body, fg = Nothing, bg = Nothing }


{-| One span in a colour of your choosing, on whatever background the window is
already using. This is the highlight: `ink Yellow "31"` marks today without
deciding what today is sitting on.
-}
ink : Hue -> String -> Span
ink hue body =
    { text = body, fg = Just hue, bg = Nothing }


{-| ...and put that span on a background of your choosing too.

    ink Magenta "  bypasses the palette  " |> on Black

-}
on : Hue -> Span -> Span
on hue span =
    { span | bg = Just hue }


-- MENUS


{-| An entry in a menu, or on the menu bar itself.

  - `Item` -- `cmd` arrives as a [`Command`](#Event) event. `key` is a hotkey
    that works anywhere (`"Alt-A"`, `"F5"`, `""` for none); `shortcut` is the
    hint drawn right-aligned in the menu, and is text only.
  - `Separator` -- a horizontal rule.
  - `SubMenu` -- a pull-down. Nests to any depth, and on the menu bar this is
    what a normal menu is.

A `~` in a title marks the highlighted letter: `"~F~ile"` draws as *F*ile.

Built-in command names work here too: `"quit"`, `"close"`, `"zoom"`,
`"resize"`, `"next"`, `"prev"`, `"menu"`, `"help"`, `"ok"`, `"cancel"`,
`"yes"`, `"no"`, `"cascade"`, `"tile"` — and the editor's own, which reach
whichever [`Editor`](#View) has the caret: `"editor.cut"`, `"editor.copy"`,
`"editor.paste"`, `"editor.clear"`, `"editor.undo"` and `"editor.selectAll"`.
Turbo Vision handles those itself and they do not arrive as events.

The editor's six are the only prefixed names here, and the prefix is the
point: everything else on this list is a word a program is unlikely to want
for itself, and an editor's vocabulary is made of everyday ones. A built-in
name takes the event silently, so a program's own Clear and the editor's
cannot both own the bare name -- and the program should have it.

Which makes the same list a set of names your program may not use for anything
else. Calling a command `"cancel"` because there is a Cancel entry on the menu
gets an entry that draws, a hotkey that works, and no event ever -- Turbo
Vision took it, and outside a dialog `cmCancel` does nothing at all. Nothing
reports this. Pick another name.

**One known limitation, and it is the menu bar's rather than this package's.**
`TMenuView::execute` runs an event loop of its own while a pull-down is open,
so for as long as one is down the program is stopped: no timers, no
subscriptions, no renders. Nothing is lost -- a `Time.every` that should have
fired arrives when the menu closes -- and a menu is open for a second at a
time, which is why this has never been in the way. It is why
[`popupMenu`](#popupMenu) is not built on Turbo Vision's own `TMenuPopup`,
and why a context menu does not have the problem.
-}
type MenuItem
    = Item { title : String, cmd : String, key : String, shortcut : String }
    | Separator
    | SubMenu { title : String, key : String, items : Array MenuItem }


{-| One entry on the status line.

Its `key` works **everywhere**, including over an open modal dialog: Turbo
Vision offers the status line every keystroke before anything else sees it. Pick
these carefully -- a status entry on `Alt-N` makes `Alt-N` unusable in every
dialog in the program.

An entry with an empty `cmd` is a hint: drawn, but not clickable.
-}
type alias StatusItem =
    { text : String, key : String, cmd : String }


-- EVENTS


{-| Something happened. Route these into your `Msg` with the `onEvent` field of
[`defineProgram`](#defineProgram).

  - `Command` -- a menu entry, status line entry or button, by its `cmd` name.
  - `Selected` -- an entry in a list box was chosen (`Space` or double click).
  - `Focused` -- the highlight in a list box moved, by arrow key, mouse or a
    render that replaced the list. This is how the model learns which entry an
    "Edit" or "Delete" button should act on; Turbo Vision's own examples read
    the list's `focused` member at the moment they need it, which a program
    that cannot call into C++ has no way to do.
  - `KeyPressed` -- a key reached a focused canvas. Names look like `"Left"`,
    `"F5"`, `"Alt-X"`, `"Ctrl-A"` or `"a"`.
  - `Clicked` -- a canvas was clicked, in the canvas's own coordinates.
    `isRight` says which button, and exists for one reason:
    [`popupMenu`](#popupMenu) takes a view and a point in it, which is exactly
    what this event carries.
    `isDouble` marks the second click of a double click; the first arrived on
    its own a moment earlier, so a view that acts on both will act twice.
  - `Scrolled` -- a [`ScrollBar`](#View) moved, by arrow, page, drag or key.
    A drag reports only where it ended: the intermediate positions are
    collapsed, because a model that re-rendered on each of them would redraw
    the window a dozen times per gesture.
  - `Resized` -- how big the **desktop** is, in character cells. It arrives
    once when the application starts and again whenever the terminal changes
    size, so a program that lays out against it never has to assume 80x25.
    The desktop rather than the screen because that is the coordinate system a
    [`Window`](#Window)'s rectangle is written in: the menu bar and the status
    line are Turbo Vision's and are already subtracted.
  - `Changed` -- the *user* moved a value: typed in an input line, ticked a
    check box, chose a radio button. This is the one event about a control
    whose state Turbo Vision would otherwise keep to itself until a dialog was
    answered, which is what made a cluster in an ordinary window invisible to
    the model. It reports what the view says *now*, so a model that stores it
    and renders it back writes nothing. Not sent for a value the model set
    itself -- only a change the model did not already know about is news.
  - `Edited` -- an [`Editor`](#View) was edited, or its caret moved. It carries
    `isModified`, `line` and `column` and **not** the document: a status line
    saying "12:4" and a Save that lights up when there is something to save are
    what a program wants on every keystroke, and a file is not. Coalesced per
    editor at the pump, so typing a word is one event.
  - `EditorText` -- the answer to [`readEditor`](#readEditor), and the only
    event that carries a document. Ask for one when you are about to write it
    to a file.
  - `Searched` -- the answer to [`findInEditor`](#findInEditor) and
    [`replaceInEditor`](#replaceInEditor). `matches` is how many were acted on:
    `0` or `1` for a find, however many were replaced otherwise. `0` is how a
    program says "not found" in its own words.
  - `DialogClosed` -- a [`dialog`](#dialog) was dismissed. `cmd` is the button
    that closed it (`"cancel"` if it was cancelled or closed from its frame),
    and `values` holds every field in it -- read them with [`text`](#text),
    [`number`](#number) and [`flag`](#flag).
  - `WindowClosed` -- the user closed a window from its frame. **Handle this**:
    if the model still lists the window, the next render reopens it.
  - `Unknown` -- an event this version of the package does not understand.
-}
type Event
    = Command String
    | Selected { id : String, index : Int, text : String }
    | Focused { id : String, index : Int, text : String }
    | KeyPressed { id : String, key : String }
    | Clicked { id : String, x : Int, y : Int, isDouble : Bool, isRight : Bool }
    | Scrolled { id : String, value : Int }
    | Resized { cols : Int, rows : Int }
    | Changed { id : String, value : Value }
    | Edited { id : String, isModified : Bool, line : Int, column : Int }
    | EditorText { id : String, text : String }
    | Searched { id : String, matches : Int }
    | DialogClosed { id : String, cmd : String, values : Decode.Value }
    | WindowClosed String
    | Unknown String


{-| What a [`Changed`](#Event) event carries. Four shapes because four kinds
of control have a value the user can move, and they are not the same kind of
thing:

  - `Text` -- an [`InputLine`](#View)'s contents, after every edit.
  - `Flags` -- one boolean per box of a [`CheckBoxes`](#View) cluster, in the
    order the items were given.
  - `Choice` -- which button of a [`RadioButtons`](#View) cluster is on.
  - `Marks` -- one state index per box of a [`MultiCheckBoxes`](#View)
    cluster, in the same order.

They line up with [`text`](#text), [`flags`](#flags), [`number`](#number) and
[`marks`](#marks), which read the same four out of a dialog's answer.
-}
type Value
    = Text String
    | Flags (Array Bool)
    | Choice Int
    | Marks (Array Int)


-- COMMANDS


{-| A modal dialog: the same shape as a [`Window`](#Window), plus the fact that
it is answered rather than merely shown.
-}
type alias DialogSpec =
    { id : String
    , title : String
    , rect : Rect
    , views : Array View
    }


{-| Open a modal dialog.

Modal means what it means in Turbo Vision -- input goes to this dialog and
nowhere else -- and *not* that anything stops: subscriptions keep firing and
tasks keep running behind it.

The answer arrives as a [`DialogClosed`](#Event) event carrying `id`, so this
is an ordinary `Cmd` that produces a `Msg`, like an HTTP request:

    update msg model =
        when msg is
            FromTui (Command "add") ->
                { model = model, command = Tui.dialog tui addEntryDialog }

            FromTui (DialogClosed closed) ->
                if closed.cmd == "ok" then
                    { model = { model | items = Array.pushLast (Tui.text "entry" closed.values) model.items }
                    , command = Cmd.none
                    }

                else
                    { model = model, command = Cmd.none }
-}
dialog : Ports msg -> DialogSpec -> Cmd msg
dialog ports spec =
    ports.toJs <|
        Encode.object
            [ { key = "type", value = Encode.string "dialog" }
            , { key = "spec"
              , value =
                    Encode.object
                        [ { key = "id", value = Encode.string spec.id }
                        , { key = "title", value = Encode.string spec.title }
                        , { key = "rect", value = encodeRect spec.rect }
                        , { key = "items", value = Encode.array encodeView spec.views }
                        ]
              }
            ]


{-| One button on a [`messageBox`](#messageBox). `cmd` is what comes back in
the [`DialogClosed`](#Event) event, and the four Turbo Vision uses --
`"ok"`, `"cancel"`, `"yes"`, `"no"` -- are built-in names that close the dialog
by themselves. Any other name closes nothing, which makes a message box with a
button that does not dismiss it, so use one of the four unless that is what you
meant.
-}
type alias MessageButton =
    { title : String, cmd : String }


{-| Just OK. -}
okButtons : Array MessageButton
okButtons =
    [ { title = "~O~K", cmd = "ok" } ]


{-| OK and Cancel. -}
okCancelButtons : Array MessageButton
okCancelButtons =
    [ { title = "~O~K", cmd = "ok" }
    , { title = "Cancel", cmd = "cancel" }
    ]


{-| Yes and No. Closing the box from its frame or with `Esc` still reports
`"cancel"`, which a two-button box has no button for -- handle it.
-}
yesNoButtons : Array MessageButton
yesNoButtons =
    [ { title = "~Y~es", cmd = "yes" }
    , { title = "~N~o", cmd = "no" }
    ]


{-| Yes, No and Cancel. -}
yesNoCancelButtons : Array MessageButton
yesNoCancelButtons =
    [ { title = "~Y~es", cmd = "yes" }
    , { title = "~N~o", cmd = "no" }
    , { title = "Cancel", cmd = "cancel" }
    ]


{-| A message box, as a [`DialogSpec`](#DialogSpec) ready to hand to
[`dialog`](#dialog).

    Tui.dialog tui <|
        Tui.messageBox
            { id = "confirm"
            , title = "Delete"
            , text = "Delete \"" ++ name ++ "\"?\nThis cannot be undone."
            , buttons = Tui.yesNoButtons
            , desktop = model.desktop
            }

The answer arrives as a [`DialogClosed`](#Event) carrying the `id` you gave it
and the `cmd` of the button that closed it -- so a message box is an ordinary
`Cmd` producing a `Msg`, exactly like any other dialog, and there is nothing
new to learn.

This is a *helper*, not a new kind of thing: it returns a spec you can pick
apart or adjust. Turbo Vision's own `messageBox()` is a function in the library
because it calls `execView`, the nested loop this binding does not have; here
a message box is fifteen lines of dialog that every program would otherwise
write for itself, so the package writes them.

`desktop` is what makes it centre, and it is the reason this could not have
been written before the [`Resized`](#Event) event: a rectangle is in desktop
coordinates and nothing in a pure `view` function knew how big the desktop was.
Pass the size the model was last told.

The box is sized to its longest line, up to the width of the desktop. `text`
may contain newlines; very long lines are wrapped by the static text inside,
which can overflow a box sized by line count -- break them yourself if that
matters.

-}
messageBox :
    { id : String
    , title : String
    , text : String
    , buttons : Array MessageButton
    , desktop : { cols : Int, rows : Int }
    }
    -> DialogSpec
messageBox box =
    let
        lines =
            String.split "\n" box.text

        longest =
            Array.foldl (\each wide -> max wide (String.count each)) 0 lines

        count =
            max 1 (Array.length box.buttons)

        -- Twelve columns each and two between, which is what a Turbo Vision
        -- dialog button measures.
        buttonsWide =
            (count * 12) + ((count - 1) * 2)

        width =
            clamp 1 box.desktop.cols (max (max 34 (longest + 8)) (buttonsWide + 6))

        height =
            clamp 1 box.desktop.rows (Array.length lines + 7)

        left =
            max 0 ((box.desktop.cols - width) // 2)

        top =
            max 0 ((box.desktop.rows - height) // 2)

        row =
            height - 4

        firstButton =
            max 2 ((width - buttonsWide) // 2)

        placed =
            Array.indexedMap
                (\index button ->
                    let
                        x =
                            firstButton + (index * 14)
                    in
                    Button
                        { id = box.id ++ "-" ++ button.cmd
                        , rect = { x1 = x, y1 = row, x2 = x + 12, y2 = row + 2 }
                        , title = button.title
                        , cmd = button.cmd
                        , isDefault = index == 0
                        , takesFocus = True
                        }
                )
                box.buttons
    in
    { id = box.id
    , title = box.title
    , rect = { x1 = left, y1 = top, x2 = left + width, y2 = top + height }
    , views =
        Array.pushFirst
            (StaticText
                { id = box.id ++ "-text"
                , rect =
                    { x1 = 3
                    , y1 = 2
                    , x2 = width - 3
                    , y2 = 2 + Array.length lines
                    }
                , text = box.text
                }
            )
            placed
    }


{-| A file or directory chooser, as a [`DialogSpec`](#DialogSpec) ready to hand
to [`dialog`](#dialog).

    Tui.dialog tui <|
        Tui.fileDialog
            { id = "chdir"
            , title = "Change directory"
            , path = Path.toPosixString model.here
            , name = ""
            , entries = Array.pushFirst ".." model.subdirectories
            , history = model.recentPaths
            , buttons = Tui.okCancelButtons
            , desktop = model.desktop
            }

`TFileDialog` and `TChDirDialog` read the directory themselves, from inside the
dialog, and there is no equivalent of that here on purpose: listing a directory
is a `Task`, so the model does the reading and hands over what it found. Which
means this is a *layout* -- it decides where the field, the list and the
buttons go, and nothing else. What the entries say, whether `".."` is among
them and what a name means are the program's business.

The answer arrives as a [`DialogClosed`](#Event) event, and two of its `values`
are the point:

  - `Tui.text "fileName" closed.values` -- what was typed in the field.
  - `Tui.number "fileList" closed.values` -- which row was highlighted, as an
    index into the `entries` you passed in. Look it up there rather than
    parsing the text back.

Those two ids are fixed rather than derived from `id`, because only one modal
dialog can be open at a time and a name you can write down beats a name you
have to construct. Do not give a view in an open *window* either of them. The
drop-down beside the field is `"fileHistory"` under the same rule.

`history` is what the field remembers, and the model is the only thing that
puts anything in it -- see [`View`](#View). Pass `[]` for a dialog that
remembers nothing; the arrow is still drawn, exactly as it is on the first run
of a Turbo Vision program.

**Navigating is the caller's job, and it is a reopen.** A dialog is a `Cmd`
that produces a `Msg`; it is not part of `view` and nothing patches it while it
is up. So "the user chose a directory" is an answer like any other: list the
new path, and open another one. That is the whole of it in `update`, and it is
why this needed no protocol change -- but it does mean the dialog blinks, and
a program that wants a file browser that never blinks wants a window rather
than a dialog.

-}
fileDialog :
    { id : String
    , title : String
    , path : String
    , name : String
    , entries : Array String
    , history : Array String
    , buttons : Array MessageButton
    , desktop : { cols : Int, rows : Int }
    }
    -> DialogSpec
fileDialog spec =
    let
        width =
            clamp 24 spec.desktop.cols 58

        height =
            clamp 12 spec.desktop.rows 18

        left =
            max 0 ((spec.desktop.cols - width) // 2)

        top =
            max 0 ((spec.desktop.rows - height) // 2)

        count =
            max 1 (Array.length spec.buttons)

        buttonsWide =
            (count * 12) + ((count - 1) * 2)

        firstButton =
            max 2 ((width - buttonsWide) // 2)

        buttonRow =
            height - 4

        -- One row of path above the buttons, and the list fills what is left.
        pathRow =
            buttonRow - 2

        placed =
            Array.indexedMap
                (\index button ->
                    let
                        x =
                            firstButton + (index * 14)
                    in
                    Button
                        { id = spec.id ++ "-" ++ button.cmd
                        , rect = { x1 = x, y1 = buttonRow, x2 = x + 12, y2 = buttonRow + 2 }
                        , title = button.title
                        , cmd = button.cmd
                        , isDefault = index == 0
                        , takesFocus = True
                        }
                )
                spec.buttons
    in
    { id = spec.id
    , title = spec.title
    , rect = { x1 = left, y1 = top, x2 = left + width, y2 = top + height }
    , views =
        Array.append
            [ InputLine
                -- Three columns short of where it would otherwise end,
                -- because the history drop-down goes in them.
                { id = "fileName"
                , rect = { x1 = 3, y1 = 2, x2 = width - 6, y2 = 3 }
                , maxLen = 255
                , value = spec.name
                , allowed = Nothing
                }
            , History
                { id = "fileHistory"
                , for = "fileName"
                , items = spec.history
                }
            -- After the field it names, which is what a label requires.
            , Label
                { id = "fileNameLabel"
                , rect = { x1 = 3, y1 = 1, x2 = 12, y2 = 2 }
                , text = "~N~ame"
                , for = "fileName"
                }
            , ListBox
                { id = "fileList"
                , rect = { x1 = 3, y1 = 4, x2 = width - 5, y2 = pathRow }
                , items = spec.entries
                , focused = 0
                }
            , StaticText
                { id = "filePath"
                , rect = { x1 = 3, y1 = pathRow, x2 = width - 3, y2 = pathRow + 1 }
                , text = spec.path
                }
            ]
            placed
    }


{-| One entry in a context menu, or the line between two groups of them.

`shortcut` is the right-aligned hint text (`"Ctrl-X"`), which is a label and
nothing else -- a context menu is open for a moment, so there is no global key
to bind. That is the difference from [`MenuItem`](#MenuItem), along with the
one that matters: there is no `SubMenu` here.

**A context menu is flat, and that is a decision rather than an omission.** A
submenu in Turbo Vision is a menu opened from inside the loop that is running
the menu above it, and that loop is a nested `getEvent` -- it stops timers,
subscriptions and renders for as long as it is up. `popupMenu` is driven by
the same pump as everything else here instead, which is what a flat menu makes
possible. Turbo Vision's own only context menu -- `TEditor`'s Cut, Copy, Paste
and Undo -- is flat too.
-}
type PopupItem
    = Entry { title : String, cmd : String, shortcut : String }
    | Divider


{-| A context menu, at a point in a view.

    Clicked click ->
        if click.isRight then
            { model = model
            , command =
                Tui.popupMenu tui
                    { view = click.id
                    , at = { x = click.x, y = click.y }
                    , items =
                        [ Entry { title = "Cu~t~", cmd = "cut", shortcut = "Shift-Del" }
                        , Entry { title = "~C~opy", cmd = "copy", shortcut = "Ctrl-Ins" }
                        , Divider
                        , Entry { title = "~D~elete", cmd = "delete", shortcut = "" }
                        ]
                    }
            }

        else
            ...

`view` and `at` are the id and the coordinates a [`Clicked`](#Event) event
hands you, so opening a menu where the user clicked needs no arithmetic. Any
view's id will do, and so will a window's; the point is in that view's own
coordinate system, and the menu is placed on the desktop from there, flipping
up or left if there is no room below or right.

**The answer is an ordinary [`Command`](#Event) event.** Nothing comes back
that says a menu was involved, because nothing should: `cmd = "delete"` here
reaches `update` exactly as `Item { cmd = "delete" }` on the menu bar does,
and a built-in name like `"quit"` is handled by Turbo Vision without a round
trip either way. Choosing nothing -- `Esc`, or a click outside -- sends
nothing at all.

It is modal while it is up, in the sense the rest of this package uses: input
goes to the menu and nowhere else, and the program carries on. Entries are
picked with the mouse, with the arrow keys and `Enter`, or by the letter the
`~` marks underline.

An entry whose command has been turned off with [`setEnabled`](#setEnabled) is
drawn greyed and cannot be chosen, exactly as it would be on the menu bar --
the menu reads the command set once, when it opens.
-}
popupMenu :
    Ports msg
    -> { view : String, at : { x : Int, y : Int }, items : Array PopupItem }
    -> Cmd msg
popupMenu ports spec =
    ports.toJs <|
        Encode.object
            [ { key = "type", value = Encode.string "popupMenu" }
            , { key = "view", value = Encode.string spec.view }
            , { key = "x", value = Encode.int spec.at.x }
            , { key = "y", value = Encode.int spec.at.y }
            , { key = "items", value = Encode.array encodePopupItem spec.items }
            ]


{-| Put a document into an [`Editor`](#View), replacing whatever is there.

    Loaded contents ->
        { model = { model | path = Just contents.path }
        , command = Tui.setEditorText tui "body" contents.text
        }

A `Cmd` and not a field on the view, which is the one place this package puts
state somewhere other than the model and the reason is in [`View`](#View): a
render happens on every tick of every subscription, and a document does not
belong in one. So a document goes in here and comes back through
[`readEditor`](#readEditor), twice per file rather than once per render.

The caret goes to the top, the selection is cleared, the undo history is
dropped and the document counts as unmodified -- it is a new document, not an
edit. Sending it is not an edit either, so no [`Edited`](#Event) event follows
unless the caret or the modified flag actually moved.
-}
setEditorText : Ports msg -> String -> String -> Cmd msg
setEditorText ports id body =
    ports.toJs <|
        Encode.object
            [ { key = "type", value = Encode.string "setEditorText" }
            , { key = "id", value = Encode.string id }
            , { key = "text", value = Encode.string body }
            ]


{-| Ask an [`Editor`](#View) for its document. The answer arrives as an
[`EditorText`](#Event) event.

    Command "save" ->
        { model = model, command = Tui.readEditor tui "body" }

    EditorText it ->
        { model = model
        , command =
            when model.path is
                Just path ->
                    FileSystem.writeFile permission (Bytes.fromString it.text) path
                        |> Task.attempt Saved

                Nothing ->
                    Cmd.none
        }

A `Cmd` producing a `Msg`, the shape [`dialog`](#dialog) established. Nothing
about it is a synchronous question: the message goes out, the document comes
back as an ordinary event, and the program carries on in between.

Ask when you are about to write the file. Asking on every keystroke would put
the document back on the wire once per character, which is exactly what the
[`Edited`](#Event) event exists to avoid.
-}
readEditor : Ports msg -> String -> Cmd msg
readEditor ports id =
    ports.toJs <|
        Encode.object
            [ { key = "type", value = Encode.string "readEditor" }
            , { key = "id", value = Encode.string id }
            ]


{-| Find the next occurrence of a string in an [`Editor`](#View), searching
forward from the caret and selecting what it finds. The answer arrives as a
[`Searched`](#Event) event carrying `0` or `1`.

    Command "find" ->
        { model = model
        , command = Tui.dialog tui (findDialog model)
        }

    DialogClosed closed ->
        if closed.id == "find" && closed.cmd == "ok" then
            { model = model
            , command =
                Tui.findInEditor tui "body"
                    { what = Tui.text "what" closed.values
                    , matchCase = Tui.flag "how" 0 closed.values
                    , wholeWords = Tui.flag "how" 1 closed.values
                    }
            }

        else
            ...

**Searching is two steps, and that is the shape rather than an omission.** A
search needs a string, asking for one is a dialog, and a dialog here is a `Cmd`
producing a `Msg` — so the program asks, and then it searches. It is the same
two steps `fileDialog` makes of Change Dir, one level down.

Turbo Vision's `cmFind` is not offered as a built-in command name for exactly
this reason: `TEditor::find` begins by asking `editorDialog` for the string,
and `editorDialog` is deliberately inert here because every prompt it raises is
a message box, which is a nested event loop.

Searching again is this same command issued a second time — keep what was
searched for in the model. Turbo Vision's own `Ctrl-L` also works and is not
told anything, because this leaves `TEditor`'s static search string set to
whatever was last asked for.
-}
findInEditor :
    Ports msg
    -> String
    -> { what : String, matchCase : Bool, wholeWords : Bool }
    -> Cmd msg
findInEditor ports id spec =
    ports.toJs <|
        Encode.object
            (Array.pushFirst
                { key = "type", value = Encode.string "searchEditor" } <|
                searchFields id
                    { what = spec.what
                    , replace = False
                    , replacement = ""
                    , matchCase = spec.matchCase
                    , wholeWords = spec.wholeWords
                    , all = False
                    }
            )


{-| Find and replace in an [`Editor`](#View). The answer is a
[`Searched`](#Event) event carrying how many were replaced.

`all = False` replaces the next match after the caret. `all = True` replaces
every match in the **document**, starting from the top — which is what the word
means, and is a small divergence from Turbo Vision: its own Replace All runs
from the caret, so it quietly depends on where the caret happens to be and
replaces nothing at all after a search that ran off the end.

    Tui.replaceInEditor tui "body"
        { what = "colour"
        , replacement = "color"
        , matchCase = True
        , wholeWords = True
        , all = True
        }

Turbo Vision asks before each replacement when `efPromptOnReplace` is set, and
that is not offered: the prompt is a message box, and a program that wants to
ask can search one match at a time and put up its own.
-}
replaceInEditor :
    Ports msg
    -> String
    ->
        { what : String
        , replacement : String
        , matchCase : Bool
        , wholeWords : Bool
        , all : Bool
        }
    -> Cmd msg
replaceInEditor ports id spec =
    ports.toJs <|
        Encode.object
            (Array.pushFirst
                { key = "type", value = Encode.string "searchEditor" } <|
                searchFields id
                    { what = spec.what
                    , replace = True
                    , replacement = spec.replacement
                    , matchCase = spec.matchCase
                    , wholeWords = spec.wholeWords
                    , all = spec.all
                    }
            )


{-| Everything but the `type`, which stays at the two call sites above. The
consistency check reads the kind of an outbound message out of the call site
itself rather than out of a string literal somewhere, so a helper that hid the
type would be sending something unchecked -- and it says so.
-}
searchFields :
    String
    ->
        { what : String
        , replace : Bool
        , replacement : String
        , matchCase : Bool
        , wholeWords : Bool
        , all : Bool
        }
    -> Array { key : String, value : Encode.Value }
searchFields id spec =
    [ { key = "id", value = Encode.string id }
    , { key = "what", value = Encode.string spec.what }
    , { key = "replace", value = Encode.bool spec.replace }
    , { key = "replacement", value = Encode.string spec.replacement }
    , { key = "matchCase", value = Encode.bool spec.matchCase }
    , { key = "wholeWords", value = Encode.bool spec.wholeWords }
    , { key = "all", value = Encode.bool spec.all }
    ]


{-| Quit. Any open dialog is cancelled on the way out, and the process exits
once the terminal has been restored.

The built-in command name `"quit"` on a menu entry or status line entry does
the same thing without a round trip through your `update`.
-}
quit : Ports msg -> Cmd msg
quit ports =
    ports.toJs (Encode.object [ { key = "type", value = Encode.string "quit" } ])


{-| Put the caret on a view, or bring a window to the front.

    Tui.focus tui "list"        -- raise the window called "list"
    Tui.focus tui "entryField"  -- and put the caret in a field inside one

The id is looked up as a window first and then as a view, because those are the
two things worth naming: raising a window selects it and focuses it, the way
clicking its frame would, and focusing a view moves the caret within whatever
window it is in.

The order of a window's `views` decides who has the caret when the window
*opens*, and that is the only say the model has otherwise -- so this is how a
program puts the caret back in the field an error was about, or answers "show
me that window" for a window that is already open and buried.

An id that names nothing is ignored. Nothing comes back: focus moves for
reasons of its own -- a click, a Tab, a window closing -- so a model that
tracked what it last asked for would be describing the past.

-}
focus : Ports msg -> String -> Cmd msg
focus ports id =
    ports.toJs <|
        Encode.object
            [ { key = "type", value = Encode.string "focus" }
            , { key = "id", value = Encode.string id }
            ]


{-| How long Turbo Vision waits before deciding that two clicks were two
clicks rather than one double click.

The unit is the original PC timer tick, 1/18.2 of a second, because that is
what `TEventQueue::doubleDelay` has always counted in. tvdemo's mouse dialog
exists to change this and nothing else, and `examples/mouse` is that dialog.

    Tui.setDoubleClickDelay tui 8

-}
setDoubleClickDelay : Ports msg -> Int -> Cmd msg
setDoubleClickDelay ports ticks =
    ports.toJs <|
        Encode.object
            [ { key = "type", value = Encode.string "doubleClickDelay" }
            , { key = "ticks", value = Encode.int ticks }
            ]


{-| Grey a command out everywhere it appears -- menu entries, status line
entries and buttons alike -- or bring it back.

    Tui.setEnabled tui "clear" (Array.length model.items > 0)

A disabled command cannot be triggered by any route, including its hotkey.

One limit inherited from Turbo Vision: only the first 146 distinct command
names in a program can be disabled. Beyond that they are numbered above the
range Turbo Vision allows to be greyed out, and `setEnabled` has no effect on
them.
-}
setEnabled : Ports msg -> String -> Bool -> Cmd msg
setEnabled ports command enabled =
    ports.toJs <|
        Encode.object
            [ { key = "type", value = Encode.string "setEnabled" }
            , { key = "cmd", value = Encode.string command }
            , { key = "on", value = Encode.bool enabled }
            ]


-- READING DIALOG VALUES


{-| Read an input line's text out of a [`DialogClosed`](#Event) event's
`values`. Missing or wrong-typed fields give `""`.
-}
text : String -> Decode.Value -> String
text field values =
    Decode.decodeValue (Decode.field field Decode.string) values
        |> Result.withDefault ""


{-| Read a number out of a dialog's `values` -- a list box's focused index, for
instance. Missing or wrong-typed fields give `0`.
-}
number : String -> Decode.Value -> Int
number field values =
    Decode.decodeValue (Decode.field field Decode.int) values
        |> Result.withDefault 0


{-| Read one check box out of a dialog's `values`, by the index of the box
within its group. Missing fields give `False`.
-}
flag : String -> Int -> Decode.Value -> Bool
flag field index values =
    flags field values
        |> Array.get index
        |> Maybe.withDefault False


{-| Read a whole group of check boxes out of a dialog's `values`, one flag per
box, in the order they were declared. Missing fields give `[]`.

This is the one to keep in a model: a record that came out of a form holds the
group as it was ticked, and handing the same array back to
[`CheckBoxes`](#View) reopens the form on it.
-}
flags : String -> Decode.Value -> Array Bool
flags field values =
    Decode.decodeValue (Decode.field field (Decode.array Decode.bool)) values
        |> Result.withDefault []


{-| Read a group of multi-state check boxes out of a dialog's `values`, one
state index per box, in the order they were declared. Missing fields give `[]`.

The [`MultiCheckBoxes`](#View) counterpart of [`flags`](#flags), and the same
advice applies: this is the array to keep in the model, and handing it back
reopens the form on it.
-}
marks : String -> Decode.Value -> Array Int
marks field values =
    Decode.decodeValue (Decode.field field (Decode.array Decode.int)) values
        |> Result.withDefault []


-- PROGRAM


{-| What [`defineProgram`](#defineProgram) returns, and the type your `main`
should be annotated with.
-}
type alias Program model msg =
    Node.Program model msg


{-| The same fields as `Node.defineProgram`, plus:

  - `view` -- the description of what should be on screen, rendered once at
    startup and again after every update.
  - `onEvent` -- how an [`Event`](#Event) becomes one of your messages.

`init` is a full `Init.Task`, so subsystems like `FileSystem` can be awaited
before the first model exists.
-}
type alias ProgramConfiguration model msg =
    { init : Node.Environment -> Init.Task { model : model, command : Cmd msg }
    , update : msg -> model -> { model : model, command : Cmd msg }
    , subscriptions : model -> Sub msg
    , view : model -> Ui
    , onEvent : Event -> msg
    }


{-| Build the program.

The whole view is sent after every update -- the entire description, every
time. Working out what actually changed is the runtime's job, exactly as a
virtual DOM does it, so a `view` that rebuilds its whole `Ui` on each call
costs nothing beyond the JSON.
-}
defineProgram : Ports msg -> ProgramConfiguration model msg -> Program model msg
defineProgram ports config =
    Node.defineProgram
        { init =
            \env ->
                Init.await (config.init env) <| \started ->
                    Node.startProgram
                        { model = started.model
                        , command =
                            Cmd.batch
                                [ started.command
                                , render ports config started.model
                                ]
                        }
        , update =
            \msg model ->
                let
                    stepped =
                        config.update msg model
                in
                { model = stepped.model
                , command =
                    Cmd.batch
                        [ stepped.command
                        , render ports config stepped.model
                        ]
                }
        , subscriptions =
            \model ->
                Sub.batch
                    [ config.subscriptions model
                    , ports.fromJs (decodeEvent >> config.onEvent)
                    ]
        }


render : Ports msg -> ProgramConfiguration model msg -> model -> Cmd msg
render ports config model =
    let
        ui =
            config.view model
    in
    ports.toJs <|
        Encode.object
            [ { key = "type", value = Encode.string "render" }
            , { key = "protocol", value = Encode.int protocolVersion }
            , { key = "menuBar", value = Encode.array encodeMenuItem ui.menuBar }
            , { key = "statusLine", value = Encode.array encodeStatusItem ui.statusLine }
            , { key = "windows", value = Encode.array encodeWindow ui.windows }
            , { key = "overlays", value = Encode.array encodeView ui.overlays }
            ]


-- ENCODERS


encodeRect : Rect -> Encode.Value
encodeRect r =
    Encode.array Encode.int [ r.x1, r.y1, r.x2, r.y2 ]


encodeWindow : Window -> Encode.Value
encodeWindow window =
    Encode.object
        [ { key = "id", value = Encode.string window.id }
        , { key = "title", value = Encode.string window.title }
        , { key = "rect", value = encodeRect window.rect }
        , { key = "items", value = Encode.array encodeView window.views }
        ]


encodeView : View -> Encode.Value
encodeView view =
    when view is
        Grows v ->
            Encode.object (encodeViewFields v.view ++ growFields v.grow)

        _ ->
            Encode.object (encodeViewFields view)


growFields : Grow -> Array { key : String, value : Encode.Value }
growFields mode =
    [ { key = "grow"
      , value =
            Encode.object
                [ { key = "left", value = Encode.bool mode.left }
                , { key = "top", value = Encode.bool mode.top }
                , { key = "right", value = Encode.bool mode.right }
                , { key = "bottom", value = Encode.bool mode.bottom }
                ]
      }
    ]


{-| The fields of one view, without any `grow` wrapped around it. Split out so
that the wrapper contributes its field in one place rather than in twelve.
-}
encodeViewFields : View -> Array { key : String, value : Encode.Value }
encodeViewFields view =
    when view is
        -- Wrapping a wrapper: the outer one has already contributed its field,
        -- so this only has to get past it to the view underneath.
        Grows v ->
            encodeViewFields v.view

        StaticText v ->
            [ { key = "type", value = Encode.string "staticText" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "text", value = Encode.string v.text }
            ]

        Button v ->
            [ { key = "type", value = Encode.string "button" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "title", value = Encode.string v.title }
            , { key = "cmd", value = Encode.string v.cmd }
            , { key = "default", value = Encode.bool v.isDefault }
            , { key = "focusable", value = Encode.bool v.takesFocus }
            ]

        InputLine v ->
            [ { key = "type", value = Encode.string "inputLine" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "maxLen", value = Encode.int v.maxLen }
            , { key = "value", value = Encode.string v.value }
            , { key = "allowed"
              , value =
                    -- The empty string and Nothing are the same thing to the
                    -- binding: a filter that allows nothing is not a filter
                    -- anybody wants, and sending one shape for one meaning is
                    -- what keeps the differ from repainting fields.
                    Encode.string (Maybe.withDefault "" v.allowed)
              }
            ]

        History v ->
            [ { key = "type", value = Encode.string "history" }
            , { key = "id", value = Encode.string v.id }
            , { key = "for", value = Encode.string v.for }
            , { key = "items", value = Encode.array Encode.string v.items }
            ]

        ListBox v ->
            [ { key = "type", value = Encode.string "listBox" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "items", value = Encode.array Encode.string v.items }
            , { key = "focused", value = Encode.int v.focused }
            ]

        CheckBoxes v ->
            [ { key = "type", value = Encode.string "checkBoxes" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "items", value = Encode.array Encode.string v.items }
            , { key = "value", value = Encode.array Encode.bool v.checked }
            ]

        MultiCheckBoxes v ->
            [ { key = "type", value = Encode.string "multiCheckBoxes" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "items", value = Encode.array Encode.string v.items }
            , { key = "marks", value = Encode.string v.marks }
            , { key = "value", value = Encode.array Encode.int v.states }
            ]

        RadioButtons v ->
            [ { key = "type", value = Encode.string "radioButtons" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "items", value = Encode.array Encode.string v.items }
            , { key = "value", value = Encode.int v.selected }
            ]

        ScrollBar v ->
            [ { key = "type", value = Encode.string "scrollBar" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "value", value = Encode.int v.value }
            , { key = "min", value = Encode.int v.min }
            , { key = "max", value = Encode.int v.max }
            , { key = "pageStep", value = Encode.int v.pageStep }
            , { key = "arrowStep", value = Encode.int v.arrowStep }
            ]

        Label v ->
            [ { key = "type", value = Encode.string "label" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "text", value = Encode.string v.text }
            , { key = "for", value = Encode.string v.for }
            ]

        Editor v ->
            [ { key = "type", value = Encode.string "editor" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            ]

        Canvas v ->
            [ { key = "type", value = Encode.string "canvas" }
            , { key = "id", value = Encode.string v.id }
            , { key = "rect", value = encodeRect v.rect }
            , { key = "lines", value = Encode.array (Encode.array encodeSpan) v.lines }
            , { key = "selectable", value = Encode.bool v.takesFocus }
            , { key = "cursorAt"
              , value =
                    when v.cursor is
                        Just at ->
                            Encode.array Encode.int [ at.x, at.y ]

                        Nothing ->
                            Encode.null
              }
            ]


{-| A span with no colour is sent as `{text}` alone, so a canvas that never
mentions colour produces the same JSON it produced before colour existed. The
runtime diffs these as JSON, and two shapes for one meaning would repaint every
canvas on every render.
-}
encodeSpan : Span -> Encode.Value
encodeSpan span =
    let
        half key hue =
            when hue is
                Just it ->
                    [ { key = key, value = Encode.int (hueCode it) } ]

                Nothing ->
                    []
    in
    Encode.object
        ([ { key = "text", value = Encode.string span.text } ]
            ++ half "fg" span.fg
            ++ half "bg" span.bg
        )


hueCode : Hue -> Int
hueCode hue =
    when hue is
        Black ->
            0

        Blue ->
            1

        Green ->
            2

        Cyan ->
            3

        Red ->
            4

        Magenta ->
            5

        Brown ->
            6

        LightGray ->
            7

        DarkGray ->
            8

        LightBlue ->
            9

        LightGreen ->
            10

        LightCyan ->
            11

        LightRed ->
            12

        LightMagenta ->
            13

        Yellow ->
            14

        White ->
            15


encodeMenuItem : MenuItem -> Encode.Value
encodeMenuItem item =
    when item is
        Separator ->
            Encode.object [ { key = "separator", value = Encode.bool True } ]

        Item i ->
            Encode.object
                [ { key = "title", value = Encode.string i.title }
                , { key = "cmd", value = Encode.string i.cmd }
                , { key = "key", value = Encode.string i.key }
                , { key = "shortcut", value = Encode.string i.shortcut }
                ]

        SubMenu s ->
            Encode.object
                [ { key = "title", value = Encode.string s.title }
                , { key = "key", value = Encode.string s.key }
                , { key = "items", value = Encode.array encodeMenuItem s.items }
                ]


{-| The same wire shape a menu item uses, minus the case that would nest. The
binding parses both with the same function and refuses a submenu there, which
is the belt to this type's braces.
-}
encodePopupItem : PopupItem -> Encode.Value
encodePopupItem item =
    when item is
        Divider ->
            Encode.object [ { key = "separator", value = Encode.bool True } ]

        Entry i ->
            Encode.object
                [ { key = "title", value = Encode.string i.title }
                , { key = "cmd", value = Encode.string i.cmd }
                , { key = "key", value = Encode.string "" }
                , { key = "shortcut", value = Encode.string i.shortcut }
                ]


encodeStatusItem : StatusItem -> Encode.Value
encodeStatusItem item =
    Encode.object
        [ { key = "text", value = Encode.string item.text }
        , { key = "key", value = Encode.string item.key }
        , { key = "cmd", value = Encode.string item.cmd }
        ]


-- DECODING EVENTS


decodeEvent : Decode.Value -> Event
decodeEvent raw =
    Decode.decodeValue eventDecoder raw
        |> Result.withDefault (Unknown "undecodable event")


eventDecoder : Decode.Decoder Event
eventDecoder =
    Decode.field "type" Decode.string
        |> Decode.andThen
            (\kind ->
                when kind is
                    "command" ->
                        Decode.map Command (Decode.field "cmd" Decode.string)

                    "select" ->
                        Decode.map3
                            (\id index body -> Selected { id = id, index = index, text = body })
                            (Decode.field "id" Decode.string)
                            (Decode.field "index" Decode.int)
                            (Decode.field "text" Decode.string)

                    "focus" ->
                        Decode.map3
                            (\id index body -> Focused { id = id, index = index, text = body })
                            (Decode.field "id" Decode.string)
                            (Decode.field "index" Decode.int)
                            (Decode.field "text" Decode.string)

                    "key" ->
                        Decode.map2
                            (\id key -> KeyPressed { id = id, key = key })
                            (Decode.field "id" Decode.string)
                            (Decode.field "key" Decode.string)

                    "click" ->
                        Decode.map5
                            (\id x y doubled right ->
                                Clicked
                                    { id = id
                                    , x = x
                                    , y = y
                                    , isDouble = doubled
                                    , isRight = right
                                    }
                            )
                            (Decode.field "id" Decode.string)
                            (Decode.field "x" Decode.int)
                            (Decode.field "y" Decode.int)
                            (Decode.field "doubled" Decode.bool)
                            (Decode.field "right" Decode.bool)

                    "edited" ->
                        Decode.map4
                            (\id isModified row col ->
                                Edited
                                    { id = id
                                    , isModified = isModified
                                    , line = row
                                    , column = col
                                    }
                            )
                            (Decode.field "id" Decode.string)
                            (Decode.field "modified" Decode.bool)
                            (Decode.field "line" Decode.int)
                            (Decode.field "column" Decode.int)

                    "editorText" ->
                        Decode.map2
                            (\id body -> EditorText { id = id, text = body })
                            (Decode.field "id" Decode.string)
                            (Decode.field "text" Decode.string)

                    "searched" ->
                        Decode.map2
                            (\id count -> Searched { id = id, matches = count })
                            (Decode.field "id" Decode.string)
                            (Decode.field "matches" Decode.int)

                    "scroll" ->
                        Decode.map2
                            (\id value -> Scrolled { id = id, value = value })
                            (Decode.field "id" Decode.string)
                            (Decode.field "value" Decode.int)

                    "resized" ->
                        Decode.map2
                            (\cols rows -> Resized { cols = cols, rows = rows })
                            (Decode.field "cols" Decode.int)
                            (Decode.field "rows" Decode.int)

                    "changed" ->
                        Decode.map2
                            (\id value -> Changed { id = id, value = value })
                            (Decode.field "id" Decode.string)
                            (Decode.field "value" valueDecoder)

                    "dialogClosed" ->
                        Decode.map3
                            (\id command values -> DialogClosed { id = id, cmd = command, values = values })
                            (Decode.field "id" Decode.string)
                            (Decode.field "cmd" Decode.string)
                            (Decode.field "values" Decode.value)

                    "windowClosed" ->
                        Decode.map WindowClosed (Decode.field "id" Decode.string)

                    other ->
                        Decode.succeed (Unknown other)
            )


{-| The JSON shapes a value arrives as are distinct types, so which one it is
does not have to be said twice. `Flags` before `Marks` because an array of
booleans is also an array, and a cluster of check boxes is the commoner one.
-}
valueDecoder : Decode.Decoder Value
valueDecoder =
    Decode.oneOf
        [ Decode.map Text Decode.string
        , Decode.map Flags (Decode.array Decode.bool)
        , Decode.map Marks (Decode.array Decode.int)
        , Decode.map Choice Decode.int
        ]

module Tool.Ascii exposing (Model, command, init, menu, menuItem, mode, update, view, windowId)

{-| The ASCII chart: 128 codes in a grid you can walk around in, and a line
underneath saying what the selected one is in every base a programmer asks for.

gren-tvision has an ASCII chart of its own -- `examples/ascii`, a port of
tvdemo's -- and this is deliberately not that one. Three differences, each of
which is the point:

**It is ASCII.** The original chart is code page 437: 256 cells of smiley
faces and box drawing, because that is what an IBM PC could put on a screen in
1994. What a programmer wants today is 0 to 127 and nothing else.

**Control codes have names.** Which is the whole reason to reach for this
rather than count on your fingers: the cell for 7 cannot show a glyph, but the
line underneath can say `BEL  bell  Ctrl-G  \a`, and that is the answer you
came for. The grid shows a `·` in every cell that has nothing to draw, and the
names carry the meaning.

**There are two of it.** The grid is a chart you point at; the list is the
thing `man ascii` prints, one code per line with its bases and its name, and
they answer different questions. Which one you are looking at is a mode --
`Tab` toggles it -- and the *selected code* is shared, so switching keeps your
place. Two tools would not have that property, and neither would two windows.

**It is a window, not a program.** `examples/ascii` *is* an application: it
owns the menu bar, the status line and the event loop. Here it is one tool
among several -- a `Model`, an `update` that is handed the events the shell
received, and a `view` returning one `Tui.Window`. Nothing else about it
changes, which is the thing worth knowing: a Turbo Vision program written as
`view : Model -> Ui` demotes to a component by deleting its `main`.

One rule this file has to respect, and it is Turbo Vision's rather than ours.
A focused canvas consumes every key it is given -- `JsCanvas::handleEvent`
clears the event -- so the arrows, `Home`, `End` and every printable character
belong to the chart while it has focus. What still works is anything the menu
bar or the status line claims first: both are `ofPreProcess` views
(`tmenubar.cpp:32`, `tstatusl.cpp:35`), so their hotkeys are seen *before* the
focused view. That is why `F6`, `Alt-F3` and `Alt-X` still get you out of here,
and it is the reason every key predc must not lose is on the menu or the
status line.

-}

import Array exposing (Array)
import Ascii
import Char
import Chart exposing (Mode(..))
import Math
import String
import Theme exposing (Inks)
import Tui exposing (Hue(..), MenuItem(..), Span, View(..))


-- NAMES


command : String
command =
    "tool.ascii"


windowId : String
windowId =
    "ascii"


canvasId : String
canvasId =
    "ascii.grid"


scrollId : String
scrollId =
    "ascii.scroll"


menuItem : MenuItem
menuItem =
    Item { title = "~A~SCII chart", cmd = command, key = "Alt-A", shortcut = "Alt-A" }


{-| The tool's own menu, and **its title carries no underlined letter**: a menu
*bar* title claims its Alt key for as long as the menu is on the bar, which is
as long as this window is open, and there are none left.

The tick is a character in the title, because Turbo Vision has no checkable
menu item -- the same answer the theme and week menus give.

Neither entry carries a `key`. A menu accelerator would be claimed
program-wide, and `Tab` is only free *here*: the chart is a focused canvas,
which consumes every key it is given, so nothing else in predc could have
wanted it. The entries name it as a `shortcut`, which is a label rather than a
binding.
-}
menu : Model -> MenuItem
menu model =
    SubMenu
        { title = "Chart"
        , key = ""
        , items = Array.map (modeItem model.mode) Chart.all
        }


modeItem : Mode -> Mode -> MenuItem
modeItem current it =
    Item
        { title =
            (if it == current then
                "√ "

             else
                "  "
            )
                ++ Chart.title it
        , cmd = "ascii." ++ Chart.toKey it
        , key = ""
        , shortcut = "Tab"
        }


-- MODEL


{-| Which form is on screen, and it is `Chart.Mode` rather than a union of this
module's own because it is *remembered*: `Config` has to name its type, and a
config module reaching into a tool for it would be the dependency the wrong way
round. [`mode`](#mode) is how the shell reads it back.
-}
mode : Model -> Mode
mode model =
    model.mode


{-| One number, and now four more.

The chart was a pure function of the selected code and the grid still is. The
list is a pure function of the code *and* of how much of it is on screen, which
is what the other four are for: which mode, where the window has been scrolled
to, how many rows it can show, and how big the desktop is -- because unlike the
grid, the list is worth making as tall as the screen allows.
-}
type alias Model =
    { code : Int
    , mode : Mode
    -- The first code drawn in the list. Only ever moved to keep the selection
    -- in sight or by the scroll bar, and meaningless in `Grid`.
    , top : Int
    -- How many list rows fit, which starts as what the window was built at and
    -- follows `WindowResized` after that.
    , rows : Int
    , desktop : { cols : Int, rows : Int }
    }


init : Mode -> { cols : Int, rows : Int } -> Model
init opensIn desktop =
    let
        model =
            { code = 0
            , mode = opensIn
            , top = 0
            , rows = 0
            , desktop = desktop
            }
    in
    { model | rows = listRows model }


columns : Int
columns =
    16


{-| Two columns per cell, so the grid is legible rather than a wall.
-}
cellWidth : Int
cellWidth =
    2


{-| `0_ ` down the left-hand side.
-}
labelWidth : Int
labelWidth =
    3


-- HOW BIG THE LIST IS


{-| The whole table, and the one number both layouts are written against.
-}
codes : Int
codes =
    128


{-| The list window, which is the primitive the row count is taken from rather
than the other way round.

That order matters and the other one was wrong. Deriving the height from a row
count means a floor on the rows becomes a window taller than the desktop, and
on a fourteen-row terminal the bottom frame went off the bottom of the screen
-- so the rectangle is clamped to the desktop first and the rows are whatever
is left. `y2` is at most the desktop's own height, at least enough to be worth
scrolling, and never more than the table needs: a window taller than a hundred
and twenty-eight rows of content would be a list with space under it.
-}
listBox : Model -> Tui.Rect
listBox model =
    let
        width =
            paneWidth model

        left =
            max 0 (min 6 (model.desktop.cols - width))
    in
    { x1 = left
    , y1 = 1
    , x2 = left + width
    , y2 = clamp 10 model.desktop.rows (1 + codes + 6)
    }


{-| Rows of list on screen.

Six of the window's rows are not list -- the two frame rows, the header, the
two lines that spell the selected code out, and the blank between them -- and
this is the same arithmetic `WindowResized` does to a rectangle somebody
dragged, which is why both are written against the rectangle rather than one
against the desktop.
-}
listRows : Model -> Int
listRows model =
    let
        box =
            listBox model
    in
    clamp 3 codes (box.y2 - box.y1 - 6)


{-| The window in each mode, which is the only reason this tool knows how big
the desktop is.

The grid is 48 by 15 and always was: sixteen columns of eight rows is the chart
and there is no more of it to show. The list is as tall as the screen allows
and wider, because the column that makes it worth having is the meaning --
`end of transmission block` is twenty-five characters and does not fit beside
four number columns in forty-eight.
-}
frame : Model -> Tui.Rect
frame model =
    when model.mode is
        Grid ->
            { x1 = 6, y1 = 2, x2 = 54, y2 = 17 }

        List ->
            listBox model


listWidth : Int
listWidth =
    64


{-| The width the list actually has, which is the window's.
-}
paneWidth : Model -> Int
paneWidth model =
    min listWidth model.desktop.cols


moveTo : Int -> Model -> Model
moveTo code model =
    scrollInto { model | code = clamp 0 (codes - 1) code }


{-| Move the list so that the selected code is on it.

The least it can, rather than centring: a `Down` at the bottom edge should
scroll one row, which is what every list on the machine does and what makes the
position of the selection mean something.
-}
scrollInto : Model -> Model
scrollInto model =
    { model
        | top =
            clamp
                (model.code - model.rows + 1)
                model.code
                (clamp 0 (maxTop model) model.top)
    }


maxTop : Model -> Int
maxTop model =
    max 0 (codes - model.rows)


-- UPDATE


{-| The shell hands over every event it was given; a tool answers for its own
ids and ignores the rest. Nothing is routed by window, because an event knows
which *view* it came from and that is the finer-grained fact.
-}
update : Tui.Event -> Model -> Model
update event model =
    when event is
        Tui.KeyPressed pressed ->
            if pressed.id == canvasId then
                pressKey pressed.key model

            else
                model

        Tui.Clicked spot ->
            if spot.id == canvasId then
                click spot.x spot.y model

            else
                model

        Tui.Command "ascii.grid" ->
            showing Grid model

        Tui.Command "ascii.list" ->
            showing List model

        -- The bar moves the *view* and not the selection, which is what a
        -- scroll bar means everywhere else: you are looking somewhere else for
        -- a moment, and the next arrow key brings the selection back into
        -- sight along with it.
        Tui.Scrolled it ->
            if it.id == scrollId then
                { model | top = clamp 0 (maxTop model) it.value }

            else
                model

        -- The desktop decides how tall the list may be, so a terminal that
        -- changed size is a window that should have changed with it.
        Tui.Resized size ->
            let
                grown =
                    { model | desktop = size }
            in
            scrollInto { grown | rows = listRows grown }

        -- And the *window* decides how tall it actually is, which is a
        -- different number the moment somebody drags the frame.
        Tui.WindowResized it ->
            if it.id == windowId then
                let
                    dragged =
                        { model | rows = clamp 6 codes (it.rect.y2 - it.rect.y1 - 6) }
                in
                scrollInto dragged

            else
                model

        _ ->
            model


{-| Change mode, and put the selection back on screen for the mode being
entered -- `rows` means nothing in the grid, so the list has to be told where
it is the moment it becomes the thing on screen.
-}
showing : Mode -> Model -> Model
showing wanted model =
    let
        switched =
            { model | mode = wanted }
    in
    scrollInto { switched | rows = listRows switched }


{-| How far `Up` and `Down` go, which is a row -- and a row is sixteen codes
in the grid and one in the list.
-}
step : Model -> Int
step model =
    when model.mode is
        Grid ->
            columns

        List ->
            1


{-| And how far a page goes, which in the list is a screenful rather than a
number written down: a window somebody made taller pages further, because that
is what "a page" means.
-}
page : Model -> Int
page model =
    when model.mode is
        Grid ->
            4 * columns

        List ->
            max 1 (model.rows - 1)


pressKey : String -> Model -> Model
pressKey key model =
    when key is
        "Left" ->
            moveTo (model.code - 1) model

        "Right" ->
            moveTo (model.code + 1) model

        -- A row is sixteen codes in the grid and one in the list, which is
        -- the only thing the arrows have to know about the mode.
        "Up" ->
            moveTo (model.code - step model) model

        "Down" ->
            moveTo (model.code + step model) model

        "Home" ->
            moveTo 0 model

        "End" ->
            moveTo (codes - 1) model

        "PgUp" ->
            moveTo (model.code - page model) model

        "PgDn" ->
            moveTo (model.code + page model) model

        -- **`Tab`, because every printable key is spoken for.** Typing a
        -- character to jump to its code is the best thing this tool does, so
        -- `g` and `l` are 103 and 108 and cannot also be commands. `Tab` is
        -- free precisely because the chart is a focused canvas: nothing else
        -- in the window can be tabbed to, and `JsCanvas::handleEvent` would
        -- have swallowed the key anyway.
        "Tab" ->
            showing
                (when model.mode is
                    Grid ->
                        List

                    List ->
                        Grid
                )
                model

        other ->
            -- A printable key jumps to itself, which is the fastest way to ask
            -- "what is the code for this character". Every other key's name is
            -- longer than one character, so this needs no other guard -- and
            -- the ones outside ASCII are simply not on the chart.
            when String.popFirst other is
                Just { first, rest } ->
                    if String.isEmpty rest && Char.toCode first < codes then
                        moveTo (Char.toCode first) model

                    else
                        model

                Nothing ->
                    model


{-| A click arrives in the canvas's own coordinates, so undoing the header row
and the row labels is all there is to it. A click on either of them lands on
the nearest cell rather than being ignored: the user pointed at a row, and the
row is the answer.
-}
click : Int -> Int -> Model -> Model
click x y model =
    when model.mode is
        Grid ->
            let
                atColumn =
                    clamp 0 (columns - 1) ((x - labelWidth) // cellWidth)

                atRow =
                    clamp 0 7 (y - 1)
            in
            moveTo (atRow * columns + atColumn) model

        -- Row zero is the header, and a click on it lands on the top row for
        -- the same reason a click on the grid's labels lands on the nearest
        -- cell: the user pointed at the list, and the list is the answer.
        List ->
            moveTo (model.top + max 0 (y - 1)) model


-- THE CHART


{-| The header row and eight rows of sixteen. Control codes are drawn in their
own colour, which is the only way to see at a glance where the unprintable
third of the table stops.

Which colours, though, is a question `Hue` makes the model answer, and
`examples/palette` in gren-tvision is the essay on what that costs: naming a
colour outright means knowing what it lands on. Which is why they arrive as
`Inks` rather than being written here. This chart has now been repainted twice
for that exact reason -- once when the window's interior turned out to be light
grey by accident, and again when fixing that made it blue -- and a program with
three themes cannot be repainted a third time by hand. `Theme.Inks` names the
four roles a canvas here needs and every theme answers for its own ground.

The dots being the dim ones is right whatever the ground: `·` is a placeholder,
and the line below is where the meaning is.
-}
grid : Inks -> Model -> Array (Array Span)
grid inks model =
    Array.pushFirst (header inks) (Array.map (row inks model) (Array.range 0 7))


header : Inks -> Array Span
header inks =
    [ Tui.ink inks.ruler
        (String.repeat labelWidth " "
            ++ String.join " " (Array.map Ascii.hexDigit (Array.range 0 (columns - 1)))
        )
    ]


{-| A label, then sixteen one-character cells with a space between them. The
gaps are spans of their own so that the selected cell can be exactly one column
wide: a highlight that swallowed the gap would be a two-column block sitting
half over the next character.
-}
row : Inks -> Model -> Int -> Array Span
row inks model r =
    Array.pushFirst
        (Tui.ink inks.ruler (Ascii.hexDigit r ++ "_ "))
        (Array.intersperse (Tui.plain " ")
            (Array.map (\c -> cell inks model (r * columns + c)) (Array.range 0 (columns - 1)))
        )


{-| The selected cell is painted rather than merely pointed at.

`examples/ascii` shows its selection with the terminal's own block cursor and
nothing else, which is honest for a demonstration of what `cursor` does and
not enough for a tool. Whether that cursor is visible at all belongs to the
terminal: a thin bar, a hollow box, a blink somebody turned off, a multiplexer
that hides it. So the chart says which cell is selected in the only way that
is certainly on screen -- white on blue, painted by the model -- and keeps the
hardware cursor there as well, for the terminals that do show it and for the
tests, which can read a cursor position but not a highlight's meaning.
-}
cell : Inks -> Model -> Int -> Span
cell inks model code =
    if code == model.code then
        Tui.on inks.selected.bg (Tui.ink inks.selected.fg (Ascii.glyph code))

    else if Ascii.isControl code then
        Tui.ink inks.dim (Ascii.glyph code)

    else
        Tui.plain (Ascii.glyph code)


-- THE LIST


{-| One code per line, which is what `man ascii` prints and what the grid
cannot say.

The columns are built by one function so that the header cannot drift out of
line with the rows -- the alternative is two strings padded by hand, and they
agree until somebody widens a column in one of them.
-}
listLine : String -> String -> String -> String -> String -> String
listLine dec hex oct sym name =
    String.padLeft 3 ' ' dec
        ++ "  "
        ++ String.padLeft 3 ' ' hex
        ++ "  "
        ++ String.padLeft 3 ' ' oct
        ++ "  "
        ++ String.padRight 4 ' ' sym
        ++ "  "
        ++ name


{-| The symbol column: the mnemonic where there is one, and the character
otherwise.

`SP` is in the names table and is the reason this is not "the glyph, or the
name when there is no glyph" -- a space *has* a glyph, it is blank, and a row
that showed it would be a row with nothing in the one column that is supposed
to identify it.
-}
symbolOf : Int -> String
symbolOf code =
    when Ascii.named code is
        Just it ->
            it.name

        Nothing ->
            Ascii.glyph code


{-| The name column, which is empty for a printable character and is the whole
reason to open this mode for everything else.
-}
nameOf : Int -> String
nameOf code =
    when Ascii.named code is
        Just it ->
            let
                chord =
                    Ascii.chord code

                escape =
                    Ascii.escape code
            in
            it.meaning
                ++ (if String.isEmpty chord then
                        ""

                    else if String.isEmpty escape then
                        "  (" ++ chord ++ ")"

                    else
                        "  (" ++ chord ++ ", " ++ escape ++ ")"
                   )

        Nothing ->
            ""


{-| The header and the rows that are on screen.

Only the visible slice is built. A hundred and twenty-eight rows is not a lot,
and building all of them and slicing afterwards would be the same picture --
but `view` runs on every tick of every subscription, and the rule that keeps
this program cheap is that a render costs what is on the screen.
-}
list : Inks -> Model -> Array (Array Span)
list inks model =
    Array.pushFirst
        [ Tui.ink inks.ruler
            (padded model (listLine "Dec" "Hex" "Oct" "Sym" "Name"))
        ]
        (Array.map (listRow inks model)
            (Array.range model.top (min (codes - 1) (model.top + model.rows - 1)))
        )


{-| Painted across the **whole** width when it is the selected one, which is
why every row is padded to the canvas rather than left ragged: a highlight that
stopped at the last character of the text would be a different length on every
row, and a list is read down its left edge.
-}
listRow : Inks -> Model -> Int -> Array Span
listRow inks model code =
    let
        text =
            padded model
                (listLine (String.fromInt code)
                    (String.padLeft 2 '0' (Ascii.radix 16 code))
                    (String.padLeft 3 '0' (Ascii.radix 8 code))
                    (symbolOf code)
                    (nameOf code)
                )
    in
    if code == model.code then
        [ Tui.on inks.selected.bg (Tui.ink inks.selected.fg text) ]

    else if Ascii.isControl code then
        [ Tui.ink inks.dim text ]

    else
        [ Tui.plain text ]


{-| Every row padded to the pane, because the selected one is painted across
its whole width and a highlight that stopped at the last character of the text
would be a different length on every row. A list is read down its left edge and
a ragged right one says nothing.
-}
padded : Model -> String -> String
padded model text =
    String.padRight (paneWidth model - 4) ' ' text


{-| Where the block cursor goes, and `Nothing` when the selected code is not
on screen -- which the list can be and the grid cannot.

A cursor parked at the edge of a list it is not on would be pointing at the
wrong code, and the terminal draws it whether or not the model meant it.
-}
cursorAt : Model -> Maybe { x : Int, y : Int }
cursorAt model =
    when model.mode is
        Grid ->
            Just
                { x = labelWidth + Math.modBy columns model.code * cellWidth
                , y = 1 + model.code // columns
                }

        List ->
            if model.code < model.top || model.code >= model.top + model.rows then
                Nothing

            else
                Just { x = 0, y = 1 + model.code - model.top }


-- VIEW


view : Inks -> Model -> Tui.Window
view inks model =
    let
        box =
            frame model

        -- The last usable row inside the window, which both layouts hang their
        -- bottom two lines off.
        foot =
            box.y2 - box.y1 - 2
    in
    { id = windowId
    , title =
        when model.mode is
            Grid ->
                "ASCII Chart"

            List ->
                "ASCII Chart - list"
    , rect = box
    -- **The one field that makes a mode change a rebuild.** Everything else
    -- about these two layouts could have been patched -- the window's
    -- rectangle has `setBounds`, a canvas's lines are content -- but `resize`
    -- becomes the window's `sizeLimits` at the moment it is built and there is
    -- no call that changes them, so the differ compares it and a model that
    -- changes it gets a new window. Which is the right trade here rather than
    -- something to work around: the grid genuinely has nothing more to show
    -- and should not offer a handle that reveals blank space, the list
    -- genuinely does, and a rebuild the user asked for by pressing Tab costs a
    -- repaint of one window.
    , resize =
        when model.mode is
            Grid ->
                Tui.fixedSize

            List ->
                Tui.resizeHeight
    , palette = Tui.BlueWindow
    , canClose = True
    , canMove = True
    , views =
        when model.mode is
            Grid ->
                [ Canvas
                    { id = canvasId
                    , rect = { x1 = 2, y1 = 1, x2 = 46, y2 = 10 }
                    , lines = grid inks model
                    , cursor = cursorAt model
                    , takesFocus = True
                    }
                , StaticText
                    { id = "ascii.bases"
                    , rect = { x1 = 2, y1 = 11, x2 = 46, y2 = 12 }
                    , text = Ascii.bases model.code
                    }
                , StaticText
                    { id = "ascii.naming"
                    , rect = { x1 = 2, y1 = 12, x2 = 46, y2 = 13 }
                    , text = Ascii.naming model.code
                    }
                ]

            List ->
                -- The canvas before the bar, which is the rule a `Label`
                -- follows and for the same reason -- and the bar is left
                -- `for = ""` anyway, because the list is the only thing in
                -- this window that scrolls and a wheel turn should be taken
                -- wherever the pointer is.
                [ Grows
                    { grow = Tui.stretch
                    , view =
                        Canvas
                            { id = canvasId
                            , rect =
                                { x1 = 2
                                , y1 = 1
                                , x2 = paneWidth model - 3
                                , y2 = foot - 2
                                }
                            , lines = list inks model
                            , cursor = cursorAt model
                            , takesFocus = True
                            }
                    }
                , Grows
                    { grow = Tui.stretchHeight
                    , view =
                        ScrollBar
                            { id = scrollId
                            , rect =
                                { x1 = paneWidth model - 3
                                , y1 = 1
                                , x2 = paneWidth model - 2
                                , y2 = foot - 2
                                }
                            , value = model.top
                            , min = 0
                            , max = maxTop model
                            , pageStep = page model
                            , arrowStep = 1
                            , for = ""
                            }
                    }
                -- The same two lines the grid has, in the same order, kept
                -- rather than dropped as redundant: a row of the list is
                -- necessarily terse, and the code you are on is worth spelling
                -- out in full in the one place it is always in the same
                -- position.
                , Grows
                    { grow = acrossTheFoot
                    , view =
                        StaticText
                            { id = "ascii.bases"
                            , rect = { x1 = 2, y1 = foot - 1, x2 = paneWidth model - 2, y2 = foot }
                            , text = Ascii.bases model.code
                            }
                    }
                , Grows
                    { grow = acrossTheFoot
                    , view =
                        StaticText
                            { id = "ascii.naming"
                            , rect = { x1 = 2, y1 = foot, x2 = paneWidth model - 2, y2 = foot + 1 }
                            , text = Ascii.naming model.code
                            }
                    }
                ]
    }


{-| Both horizontal edges and both vertical ones follow, so a line stays the
same distance from the bottom frame while the window grows. There is no name
for it in `Tui` because only a footer wants it.
-}
acrossTheFoot : Tui.Grow
acrossTheFoot =
    { left = False, top = True, right = True, bottom = True }

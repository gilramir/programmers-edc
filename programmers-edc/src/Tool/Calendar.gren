module Tool.Calendar exposing (Model, Msg(..), Step, answered, command, init, menu, menuItem, update, view, windowId)

{-| A month, with the day of the week each date falls on and the number of the
week it is in.

The month grid is `gren-tvision`'s calendar example, which is tvdemo's
`calendar.cpp` in Gren, and the two findings that port made are the reason this
one is straightforward. **"What day is it" is a field rather than something the
view reads**, so the calendar renders any month it is handed and today is only
the one that gets picked out; `TCalendarView`'s constructor calls `localtime()`
and therefore *is* today, which is why the C++ cannot be tested and this can.
And **waiting for the clock is visible**: `Time.here` and `Time.now` are tasks,
so the first render happens before either has answered and the window says so
rather than drawing a month that might be the wrong one.

What is new here is the left-hand column, and the thing it forced. A week
number means nothing without saying which day a week starts on, so the two are
one setting -- see [`Week`](Week) -- and choosing it moves the columns as well
as the numbers. It lives in the config file because it is a fact about the
person rather than about the month they are looking at.

-}

import Json.Decode
import Math
import Task
import Theme exposing (Inks)
import Time
import Tui exposing (MenuItem(..), Span, View(..))
import Week


-- NAMES


command : String
command =
    "tool.calendar"


windowId : String
windowId =
    "calendar"


canvasId : String
canvasId =
    "calendar.grid"


footerId : String
footerId =
    "calendar.keys"


gotoDialogId : String
gotoDialogId =
    "calendar.goto.dialog"


monthFieldId : String
monthFieldId =
    "calendar.goto.month"


yearFieldId : String
yearFieldId =
    "calendar.goto.year"


{-| `Alt-K`, which is in no way a mnemonic for "calendar", and the reason is
worth writing down because the next tool will hit it too.

**A button's caption claims an Alt key for as long as its window is open**, and
the menu bar is `ofPreProcess`, so a menu accelerator beats it silently. Every
letter of *Calendar* was already spoken for -- `C` is the time converter, `A`
the ASCII chart, `D` the hex viewer, `R` the calculator, `E` the decoder's
Encoding menu, `N` and `L` two buttons (`~L~ive clock` in the converter,
`C~l~ear` in the decoder). Taking `Alt-L` for this took it away from both of
those, which is exactly what three pty drivers said when they failed.

`J`, `K`, `Q` and `V` were what was left. The underlined letter in the title is
a different question -- it only applies while the Tools menu is open -- so that
stays on the `l` where a reader will look for it.

**That census was too strict, and `Tool.Env` corrects it.** It counted every
`~x~` in the sources, including the ones inside pull-down items, which claim
nothing outside their own open menu -- `TMenuView::findHotKey` matches an
item's `key`, not the underlined letter in its title. `E`, `P` and `Q` were
free as well; see `Tool/Env.gren` and FINDINGS.
-}
menuItem : Tui.MenuItem
menuItem =
    Item { title = "Ca~l~endar", cmd = command, key = "Alt-K", shortcut = "Alt-K" }


{-| The tool's own menu, which exists so that the keys have somewhere to be
written down. Every entry is a key the canvas already answers.
-}
menu : MenuItem
menu =
    SubMenu
        { title = "~M~onth"
        , key = ""
        , items =
            [ Item { title = "~P~revious", cmd = "calendar.prev", key = "", shortcut = "Up" }
            , Item { title = "~N~ext", cmd = "calendar.next", key = "", shortcut = "Down" }
            , Tui.Separator
            -- No "previous year" / "next year", deliberately. Stepping a year
            -- at a time is a poor answer to "show me March 2019": it is nine
            -- presses of one key and then eleven of another, counting as you
            -- go, and you cannot tell how far you have got without reading the
            -- heading each time. Naming the month is one keystroke and a
            -- question, so that is the only way out of this month other than
            -- walking to the next one.
            , Item { title = "~G~o to month...", cmd = "calendar.goto", key = "", shortcut = "g" }
            , Item { title = "~T~oday", cmd = "calendar.today", key = "", shortcut = "t" }
            ]
        }


-- MODEL


type alias Date =
    { year : Int, month : Int, day : Int }


type alias Model =
    { -- Which month is on screen. `Nothing` until the clock answers, which is
      -- the one state this tool can be in that it cannot draw a month for.
      showing : Maybe { year : Int, month : Int }
    , today : Maybe Date
    -- A dialog centres itself on the desktop, so the tool has to know how big
    -- it is. Seeded and then kept current by `Resized`, which the shell passes
    -- on to every open tool.
    , desktop : { cols : Int, rows : Int }
    -- Whatever the last **Go to** could not make sense of. There is nowhere
    -- else to say it: a dialog that has been answered is gone.
    , message : String
    }


type Msg
    = GotToday Date


type alias Step =
    { model : Model, command : Cmd Msg }


{-| The zone and the instant are two tasks and both are needed before the word
"today" means anything: `Time.now` is UTC and a calendar is a local thing.

`Time.here` answers an offset rather than a zone name -- its own doc comment
says it hands back `Etc/GMT-5` -- and an offset is all a calendar wants. The
converter needs the name and pays a port for it; this does not.

**And the desktop is handed over rather than guessed**, which it used to be. It
said `{ cols = 80, rows = 23 }` and waited for a `Tui.Resized` to correct
it -- but `Resized` fires when the size *changes*, so on any terminal that was
never resized the guess stood for the whole run. The only thing that reads it
is [`gotoDialog`](#gotoDialog), which centres itself in what it believes the
desktop to be, so on an eighteen-row terminal the dialog was placed for a
twenty-three-row one and its bottom five rows, `OK` and `Cancel` among them,
were off the screen. `Help` guards against exactly this and says so; this
window had the hole `Help`'s comment describes.

-}
init : { cols : Int, rows : Int } -> Step
init desktop =
    { model =
        { showing = Nothing
        , today = Nothing
        , desktop = desktop
        , message = ""
        }
    , command =
        Task.map2
            (\zone now ->
                { year = Time.toYear zone now
                , month = monthNumber (Time.toMonth zone now)
                , day = Time.toDay zone now
                }
            )
            Time.here
            Time.now
            |> Task.perform GotToday
    }


monthNumber : Time.Month -> Int
monthNumber month =
    when month is
        Time.Jan ->
            1

        Time.Feb ->
            2

        Time.Mar ->
            3

        Time.Apr ->
            4

        Time.May ->
            5

        Time.Jun ->
            6

        Time.Jul ->
            7

        Time.Aug ->
            8

        Time.Sep ->
            9

        Time.Oct ->
            10

        Time.Nov ->
            11

        Time.Dec ->
            12


monthName : Int -> String
monthName month =
    when month is
        1 ->
            "January"

        2 ->
            "February"

        3 ->
            "March"

        4 ->
            "April"

        5 ->
            "May"

        6 ->
            "June"

        7 ->
            "July"

        8 ->
            "August"

        9 ->
            "September"

        10 ->
            "October"

        11 ->
            "November"

        _ ->
            "December"


-- UPDATE


{-| The clock's answer, which is also the first month shown.
-}
answered : Msg -> Model -> Model
answered msg model =
    when msg is
        GotToday date ->
            { model
                | today = Just date
                , showing = Just { year = date.year, month = date.month }
            }


update : Tui.Ports Msg -> Tui.Event -> Model -> Step
update ports event model =
    when event is
        Tui.Resized size ->
            still { model | desktop = size }

        Tui.KeyPressed pressed ->
            if pressed.id == canvasId then
                if pressed.key == "g" || pressed.key == "G" then
                    ask ports { model | message = "" }

                else
                    still (pressKey pressed.key { model | message = "" })

            else
                still model

        Tui.Command cmd ->
            if cmd == "calendar.goto" then
                ask ports { model | message = "" }

            else if String.startsWith "calendar." cmd then
                still (runCommand (String.dropFirst 9 cmd) { model | message = "" })

            else
                still model

        -- Every open tool is handed every event, so the guard on the id is
        -- what says this dialog was this tool's.
        Tui.DialogClosed closed ->
            if closed.id == gotoDialogId then
                answerGoto closed model

            else
                still model

        _ ->
            still model


still : Model -> Step
still model =
    { model = model, command = Cmd.none }


ask : Tui.Ports Msg -> Model -> Step
ask ports model =
    { model = model, command = Tui.dialog ports (gotoDialog model) }


{-| What the dialog was answered with.

Both fields are read even when one of them is wrong, so the message can name
the one that is: "not a month" and "not a year" are different mistakes and a
single "bad input" would make the reader check both.
-}
answerGoto : { id : String, cmd : String, values : Json.Decode.Value } -> Model -> Step
answerGoto closed model =
    if closed.cmd /= "ok" then
        still model

    else
        let
            month =
                monthFrom (String.trim (Tui.text monthFieldId closed.values))

            year =
                yearFrom (String.trim (Tui.text yearFieldId closed.values))
        in
        when { month = month, year = year } is
            { month = Just m, year = Just y } ->
                still { model | showing = Just { year = y, month = m } }

            { month = Nothing } ->
                still
                    { model | message = "Not a month: " ++ Tui.text monthFieldId closed.values }

            _ ->
                still
                    { model | message = "Not a year: " ++ Tui.text yearFieldId closed.values }


{-| A year predc can actually draw.

One to 9999, which is not arbitrary. `Week.weekdayOf` is Zeller's congruence
and `Week.numberOf` divides by 4, 100 and 400, and integer division truncates
toward zero -- so both go quietly wrong for a year at or below zero rather than
failing. Every date in the allowed range was checked against Python's
`datetime` before this bound was written down: five dates in each of the 9,999
years, no mismatches in either the weekday or the ISO week.

Refusing outside it rather than clamping, because a calendar that answered a
different year than the one asked for would be wrong in the one way a calendar
must never be.
-}
yearFrom : String -> Maybe Int
yearFrom raw =
    when String.toInt raw is
        Just year ->
            if year >= 1 && year <= 9999 then
                Just year

            else
                Nothing

        Nothing ->
            Nothing


{-| A month as a number or by name, because both are what somebody types.

`9`, `sep` and `September` are the same month, and a prefix is enough: no two
month names share three letters. Nothing here guesses between a number and a
name -- a string of digits is a number and anything else is a name, which is
the whole rule.
-}
monthFrom : String -> Maybe Int
monthFrom raw =
    when String.toInt raw is
        Just number ->
            if number >= 1 && number <= 12 then
                Just number

            else
                Nothing

        Nothing ->
            let
                wanted =
                    String.toLower raw
            in
            if String.count wanted < 3 then
                Nothing

            else
                Array.range 1 12
                    |> Array.keepIf
                        (\number ->
                            String.startsWith wanted (String.toLower (monthName number))
                        )
                    |> Array.first


pressKey : String -> Model -> Model
pressKey key model =
    when key is
        "Up" ->
            shift -1 model

        "Down" ->
            shift 1 model

        "t" ->
            toToday model

        "T" ->
            toToday model

        _ ->
            model


runCommand : String -> Model -> Model
runCommand name model =
    when name is
        "prev" ->
            shift -1 model

        "next" ->
            shift 1 model

        "today" ->
            toToday model

        _ ->
            model


{-| Move by whole months, carrying into the year.

Written as an absolute month count rather than as a conditional, because "one
before January" and "twelve before anything" are the same arithmetic and a
branch for each is a branch to get wrong.
-}
shift : Int -> Model -> Model
shift months model =
    when model.showing is
        Just showing ->
            let
                count =
                    (showing.year * 12) + (showing.month - 1) + months
            in
            { model
                | showing =
                    Just
                        { year = count // 12
                        , month = Math.modBy 12 count + 1
                        }
            }

        Nothing ->
            model


toToday : Model -> Model
toToday model =
    when model.today is
        Just date ->
            { model | showing = Just { year = date.year, month = date.month } }

        Nothing ->
            model


{-| Name a month outright, rather than walking to it.

**The month is a field with a drop-down on it**, which is Turbo Vision's
`THistory`: the `▼` beside the field opens the twelve names, and choosing one
writes it into the field. That is the shape this wants and it took a while to
see. A list *beside* a field would have been two ways to answer one question
and no way to keep them agreeing -- a dialog's views are built once and the
differ has no path into an open modal, so nothing could move the list when the
field was typed in, or the reverse. A drop-down that fills the field has one
value by construction.

So typing still works, and typing a number is the short way: `9`, `sep` and
`September` are the same month. The list is for the far commoner case of not
wanting to remember whether September is 9 or 10.

Both fields are prefilled with what is on screen, so "same month, other year"
-- the commonest thing anybody does here -- is one edit.

The field goes in the `views` array *before* the `Label` that names it and
before the `History` that drops down from it: both name a view that has to
exist already, and listing them the other way round throws out of the builder
and takes the dialog with it.
-}
gotoDialog : Model -> Tui.DialogSpec
gotoDialog model =
    let
        width =
            clamp 24 model.desktop.cols 42

        height =
            clamp 8 model.desktop.rows 11

        left =
            max 0 ((model.desktop.cols - width) // 2)

        top =
            max 0 ((model.desktop.rows - height) // 2)

        showing =
            Maybe.withDefault { year = 2000, month = 1 } model.showing
    in
    { id = gotoDialogId
    , title = "Go to month"
    , rect = { x1 = left, y1 = top, x2 = left + width, y2 = top + height }
    , views =
        [ InputLine
            { id = monthFieldId
            , rect = { x1 = 11, y1 = 2, x2 = width - 6, y2 = 3 }
            , maxLen = 12
            , value = monthName showing.month
            , allowed = Nothing
            }
        , History
            { id = "calendar.goto.months"
            , for = monthFieldId
            , items = Array.map monthName (Array.range 1 12)
            }
        , Label
            { id = "calendar.goto.monthLabel"
            , rect = { x1 = 3, y1 = 2, x2 = 11, y2 = 3 }
            , text = "~M~onth"
            , for = monthFieldId
            }
        , InputLine
            { id = yearFieldId
            , rect = { x1 = 11, y1 = 4, x2 = 20, y2 = 5 }
            , maxLen = 6
            , value = String.fromInt showing.year
            , allowed = Just "0123456789"
            }
        , Label
            { id = "calendar.goto.yearLabel"
            , rect = { x1 = 3, y1 = 4, x2 = 11, y2 = 5 }
            , text = "~Y~ear"
            , for = yearFieldId
            }
        , StaticText
            { id = "calendar.goto.hint"
            , rect = { x1 = 3, y1 = 6, x2 = width - 3, y2 = 7 }
            , text = "pick a month, or type 1-12"
            }
        , Button
            { id = "calendar.goto.ok"
            , rect = { x1 = width - 28, y1 = height - 4, x2 = width - 16, y2 = height - 2 }
            , title = "~O~K"
            , cmd = "ok"
            , isDefault = True
            , takesFocus = True
            }
        , Button
            { id = "calendar.goto.cancel"
            , rect = { x1 = width - 15, y1 = height - 4, x2 = width - 3, y2 = height - 2 }
            , title = "Cancel"
            , cmd = "cancel"
            , isDefault = False
            , takesFocus = True
            }
        ]
    }


-- VIEW


{-| The grid's rows: the month and year, the day headings, and six weeks.

Six and not five, because the longest a month can be laid out in is six weeks
and a window that changed height between months would be worse than a blank row
in the ones that do not need it. See [`weeks`](#weeks).
-}
gridRows : Int
gridRows =
    8


{-| Every row of the window's interior: the grid, the two month buttons, and
the line of keys under them.

Written down as one number because it is the *window's* height as well, and the
two disagreeing is what left this window with two blank rows under its last
line for as long as it has existed. The window was `rows + 4` tall against a
canvas of `rows`, which is the frame's two plus two that were nothing -- and a
window with `Tui.fixedSize` on it is a window nobody can drag the mistake out
of.
-}
rows : Int
rows =
    gridRows + buttonRows + 1


{-| A Turbo Vision button is two rows: the caption and the shadow under it.
-}
buttonRows : Int
buttonRows =
    2


{-| Wide enough for the line of keys under the grid, which is wider than the
grid: four columns for the week number and three for each of seven days is
twenty-five, and `Up/Down month   g go to   t today` is thirty-three.

The line is why this is written down rather than left implicit. A canvas cuts
at its width without a mark, so a hint one column too long arrives looking like
a shorter hint -- which is how `Copied 130 -- the terminal did not` reached
somebody's screen, in this same program, a few hours ago.
-}
canvasWidth : Int
canvasWidth =
    34


view : Inks -> Week.Rule -> Model -> Tui.Window
view inks rule model =
    { id = windowId
    , title = "Calendar"
    -- `rows + 2` and not `rows + 4`: the two are the frame, and the extra two
    -- were two rows of nothing under the last line of the window.
    , rect = { x1 = 24, y1 = 4, x2 = 24 + canvasWidth + 4, y2 = 4 + rows + 2 }
    , resize = Tui.fixedSize
    , palette = Tui.BlueWindow
    , canClose = True
    , canMove = True
    , views =
        [ Canvas
            { id = canvasId
            , rect = { x1 = 2, y1 = 1, x2 = 2 + canvasWidth, y2 = 1 + gridRows }
            , lines = grid inks rule model
            , cursor = Nothing
            , takesFocus = True
            }
        , monthButton "prev" "▲ Prev" 2
        , monthButton "next" "▼ Next" 14
        , Canvas
            { id = footerId
            , rect =
                { x1 = 2
                , y1 = 1 + gridRows + buttonRows
                , x2 = 2 + canvasWidth
                , y2 = 2 + gridRows + buttonRows
                }
            , lines = [ footer inks model ]
            , cursor = Nothing
            , takesFocus = False
            }
        ]
    }


{-| One of the two month buttons, which exist because `Up` and `Down` were the
only way to walk a month and a person who has just opened a calendar has no
reason to try them.

**Previous and next only.** A button per year was asked about and left out for
the reason the menu already gives: stepping a year at a time is a poor answer
to "show me March 2019", and **Go to month** answers it in one question. Two
buttons are a pair somebody reads at a glance; four are a control panel.

**`takesFocus = False`**, which is the calculator's keypad rule and matters for
the same reason: the grid is a focused `Canvas` reading every keystroke -- `t`,
`g`, `Up`, `Down` -- and a button that could hold the caret would take `Up` and
`Down` away from the very thing it is a shortcut for.

**And no `~` in the captions.** A button's tilde makes an `Alt`-letter, and
every one worth having here is a tool's: `Alt-P` is the environment list and
`Alt-N` is nothing yet but will be. The keys these stand for are `Up` and
`Down`, which need no accelerator and are named on the line underneath.

The arrows are the keys, not the direction of time: `▲` is `Up` and `Up`
goes back a month, which is what a calendar scrolled upward does.
-}
monthButton : String -> String -> Int -> View
monthButton name title x =
    Tui.Button
        { id = "calendar.button." ++ name
        , rect = { x1 = x, y1 = 1 + gridRows, x2 = x + 11, y2 = 1 + gridRows + buttonRows }
        , title = title
        , cmd = "calendar." ++ name
        , isDefault = False
        , takesFocus = False
        }


{-| The month itself. The line of keys is a canvas of its own now, because the
two buttons sit between them and a canvas is one rectangle.
-}
grid : Inks -> Week.Rule -> Model -> Array (Array Span)
grid inks rule model =
    when { showing = model.showing, today = model.today } is
        { showing = Just showing, today = Just today } ->
            [ heading inks showing
            , headings inks rule
            ]
                ++ weeks inks rule showing today

        _ ->
            -- One turn of the event loop, and the honest thing to show: a
            -- month drawn before the clock answered could be the wrong one.
            [ [ Tui.ink inks.dim "  asking the clock..." ] ]


{-| The keys, or whatever went wrong.

Standing rather than shown once, which is the calculator's lesson: a hint that
`update` clears on the next keystroke is a hint nobody has read. It is also the
answer to the question this window otherwise raises -- somebody who opens a
calendar and sees one month has no way to guess that Up and Down are what move
it, and a menu they have to go looking for is not an answer.
-}
footer : Inks -> Model -> Array Span
footer inks model =
    if String.isEmpty model.message then
        Theme.hint inks "~Up~/~Down~ month   ~g~ go to   ~t~ today"

    else
        [ Tui.ink inks.alert model.message ]


heading : Inks -> { year : Int, month : Int } -> Array Span
heading inks showing =
    let
        text =
            monthName showing.month ++ " " ++ String.fromInt showing.year
    in
    [ Tui.ink inks.ruler
        (String.repeat (max 0 ((canvasWidth - String.count text) // 2)) " " ++ text)
    ]


headings : Inks -> Week.Rule -> Array Span
headings inks rule =
    [ Tui.ink inks.ruler ("Wk  " ++ String.join " " (Week.dayNames rule)) ]


{-| Six rows of seven, which is every month there is: the longest a month can
be laid out in is six weeks, and drawing a fixed six keeps the window one size.
-}
weeks : Inks -> Week.Rule -> { year : Int, month : Int } -> Date -> Array (Array Span)
weeks inks rule showing today =
    let
        first =
            Week.weekdayOf showing.year showing.month 1

        -- How many blank cells before the 1st, given where this rule starts
        -- its weeks. `+ 7` because the difference can be negative.
        lead =
            Math.modBy 7 (first - Week.startsOn rule + 7)

        length =
            Week.daysIn showing.year showing.month
    in
    Array.range 0 5
        |> Array.map
            (\row ->
                let
                    days =
                        Array.range 0 6
                            |> Array.map (\column -> (row * 7) + column - lead + 1)

                    inMonth =
                        Array.keepIf (\day -> day >= 1 && day <= length) days
                in
                when Array.first inMonth is
                    Nothing ->
                        -- A row with nothing in it is still drawn, so the
                        -- window does not change height between months.
                        [ Tui.plain "" ]

                    Just anchor ->
                        [ Tui.ink inks.ruler
                            (String.padLeft 2
                                ' '
                                (String.fromInt
                                    (Week.numberOf rule showing.year showing.month anchor)
                                )
                                ++ "  "
                            )
                        ]
                            ++ Array.map (cell inks showing today length) days
            )


cell : Inks -> { year : Int, month : Int } -> Date -> Int -> Int -> Span
cell inks showing today length day =
    if day < 1 || day > length then
        Tui.plain "   "

    else if day == today.day && showing.month == today.month && showing.year == today.year then
        Tui.ink inks.alert (String.padLeft 2 ' ' (String.fromInt day) ++ " ")

    else
        Tui.plain (String.padLeft 2 ' ' (String.fromInt day) ++ " ")

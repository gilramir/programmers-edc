module Tool.Env exposing (Model, Step, command, init, menu, menuItem, update, view, windowId)

{-| Every environment variable predc's own process has, one per line, name and
value.

The thing a person actually wants when they ask "is `NO_COLOR` set in here?" or
"what did tmux do to `TERM`?" -- questions that are one `env | grep` away in a
shell and, over ssh with three windows already open, further away than that
sounds.

**It is a snapshot from before the first frame, and there is no Refresh.**
`Node.getEnvironmentVariables` is an `Init.Task`, so the shell reads it once on
the way in and hands it here. That is not a limitation worked around: a
process's environment is only changed by the process itself, and predc never
changes its own, so what is on the screen cannot go stale. A Refresh would
redraw the same list and quietly imply that it might not.

**The search box filters rather than jumps.** `n`-for-next is the right shape
for a hex dump, where the answer is a position in something too big to see; a
list of forty names is not that. Typing `proxy` and being shown the four
variables with `proxy` in them *is* the question, and the status line says
`4 of 47` so nothing is hidden without a count. Emptying the box brings
everything back.

Matching is case-insensitive by default and the check box says so, because a
person hunting for `http_proxy` should not have to know whether this machine
spells it in capitals. The needle is matched against `NAME=value`, so `PATH=`
finds the variable and not the twenty others that mention a path.

-}

import Dict exposing (Dict)
import Theme exposing (Inks)
import Tui exposing (MenuItem(..), Span, View(..))


-- NAMES


command : String
command =
    "tool.env"


windowId : String
windowId =
    "env"


findId : String
findId =
    "env.find"


caseId : String
caseId =
    "env.case"


listId : String
listId =
    "env.list"


scrollId : String
scrollId =
    "env.bar"


{-| `Alt-P`, for the **p**rocess's environment -- and because it was one of two
letters left.

The count is worth writing down, because this file corrects it. `Tool.Calendar`
and `Tool.Random` both say the free letters were `J`, `K`, `Q` and `V`, which
was measured by looking for `~x~` anywhere in the sources -- and that is too
strict by a wide margin. `TMenuView::findHotKey` matches `p->keyCode`, the
accelerator, and **not** the underlined letter in an item's title
(`tmnuview.cpp:557`); an entry inside a pull-down claims its letter only while
that pull-down is on the screen. What actually claims an `Alt` key is a menu
*bar* title, an item's `key`, and a caption on a view in an open window.

Counted that way, `E`, `P` and `Q` were free. `E` would have been the obvious
one and is not free after all: `Tool.Unicode`'s menu is `~E~ncoding`, which is
on the bar whenever the decoder is open. So `P`, and `Q` is what is left for
whatever comes next.
-}
menuItem : MenuItem
menuItem =
    Item { title = "En~v~ironment variables", cmd = command, key = "Alt-P", shortcut = "Alt-P" }


{-| The tool's own menu, and **its title has no underlined letter on purpose**.

Every letter of *Search* is spoken for by something that can be on the screen at
the same time: `S` is the converter's `~S~top clock` button, `e` is the
decoder's `~E~ncoding` menu, `a` the ASCII chart, `r` the calculator, `c` the
converter and `h` Help. A menu bar title beats a button silently, so underlining
any of them would take a key away from another window without a word.

A caption with no `~` in it claims nothing -- the same rule `Tool.Random`'s
buttons use, applied to a bar title. The menu still opens with the mouse and
with `F10`, and everything on it has a one-letter key on the list itself.
-}
menu : MenuItem
menu =
    SubMenu
        { title = "Search"
        , key = ""
        , items =
            [ Item { title = "~F~ind box", cmd = "env.find", key = "", shortcut = "/" }
            , Item { title = "Match ~c~ase", cmd = "env.case", key = "", shortcut = "c" }
            , Item { title = "Show them a~l~l", cmd = "env.all", key = "", shortcut = "" }
            , Tui.Separator
            , Item { title = "Cop~y~ what is shown", cmd = "env.copy", key = "", shortcut = "y" }
            ]
        }


-- MODEL


type alias Pair =
    { name : String, value : String }


type alias Model =
    { -- Every variable, sorted by name, exactly as the process was handed it.
      -- Never written to again: see the note at the top about Refresh.
      all : Array Pair
    , needle : String
    , matchCase : Bool
    -- The first *display line* on screen, not the first variable. A value
    -- longer than the window wraps onto continuation lines, so the two are
    -- different numbers and scrolling is about the one you can see.
    , top : Int
    , rows : Int
    , copied : Bool
    , message : String
    }


type alias Step msg =
    { model : Model, command : Cmd msg }


openRows : Int
openRows =
    14


lineWidth : Int
lineWidth =
    76


{-| The widest a name column gets before the values start losing room.

Names are usually short and occasionally not -- `LESS_TERMCAP_us` and
`npm_package_json` are real -- and a single outlier should not push every value
twenty columns right. Past this the name is written whole anyway and the value
starts one space after it, out of line with the rest. Out of line is honest;
cut off would not be.
-}
namesAtMost : Int
namesAtMost =
    24


init : Dict String String -> Model
init vars =
    { all =
        Dict.foldl
            (\name value sofar -> Array.pushLast { name = name, value = value } sofar)
            []
            vars
    , needle = ""
    , matchCase = False
    , top = 0
    , rows = openRows
    , copied = False
    , message = ""
    }


-- WHAT IS SHOWN


{-| The variables the needle picks out, in the order they were in.

An empty needle picks out everything, which is what makes the filter feel like
a filter rather than a mode: there is no "searching" state to leave.
-}
shown : Model -> Array Pair
shown model =
    if String.isEmpty model.needle then
        model.all

    else
        Array.keepIf (matches model) model.all


matches : Model -> Pair -> Bool
matches model pair =
    let
        subject =
            pair.name ++ "=" ++ pair.value
    in
    if model.matchCase then
        String.contains model.needle subject

    else
        String.contains (String.toLower model.needle) (String.toLower subject)


{-| How wide the name column is: the widest name being shown, within reason.

The widest name *being shown* rather than the widest there is, so filtering to
one variable does not leave it sitting behind twenty spaces somebody else
needed.
-}
column : Array Pair -> Int
column pairs =
    pairs
        |> Array.map (\pair -> String.count pair.name)
        |> Array.maximum
        |> Maybe.withDefault 1
        |> clamp 1 namesAtMost


{-| Every variable as the lines it takes up.

A value wider than the window wraps to the next line, indented to the value
column, rather than being cut off at the frame -- which is the thing this
program keeps finding fixed spaces doing in silence. `PATH` is six lines here
and that is the correct number of lines for `PATH`.
-}
laidOut : Array Pair -> Array { name : String, text : String }
laidOut pairs =
    let
        wide =
            column pairs

        room =
            max 8 (lineWidth - wide - 2)
    in
    Array.mapAndFlatten
        (\pair ->
            let
                gap =
                    max 1 ((wide + 2) - String.count pair.name)

                indent =
                    String.repeat (wide + 2) " "

                first rest =
                    pair.name ++ String.repeat gap " " ++ rest
            in
            when folded room pair.value is
                [] ->
                    [ { name = pair.name, text = first "" } ]

                chunks ->
                    Array.indexedMap
                        (\index chunk ->
                            { name = pair.name
                            , text =
                                if index == 0 then
                                    first chunk

                                else
                                    indent ++ chunk
                            }
                        )
                        chunks
        )
        pairs


folded : Int -> String -> Array String
folded room text =
    let
        go rest acc =
            if String.count rest <= room then
                Array.pushLast rest acc

            else
                go (String.dropFirst room rest)
                    (Array.pushLast (String.takeFirst room rest) acc)
    in
    if String.isEmpty text then
        [ "" ]

    else
        go text []


-- UPDATE


update : Tui.Ports msg -> Tui.Event -> Model -> Step msg
update ports event model =
    when event is
        Tui.WindowResized it ->
            if it.id == windowId then
                still (scrollTo model.top { model | rows = rowsIn (it.rect.y2 - it.rect.y1) })

            else
                still model

        Tui.Changed it ->
            if it.id == findId then
                when it.value is
                    Tui.Text text ->
                        -- Back to the top on every keystroke, because the list
                        -- underneath has changed and a scroll position into the
                        -- old one means nothing.
                        still { model | needle = text, top = 0, message = "" }

                    _ ->
                        still model

            else if it.id == caseId then
                when it.value is
                    Tui.Flags ticks ->
                        still
                            { model
                                | matchCase = Maybe.withDefault False (Array.first ticks)
                                , top = 0
                                , message = ""
                            }

                    _ ->
                        still model

            else
                still model

        Tui.Scrolled bar ->
            if bar.id == scrollId then
                still (scrollTo bar.value model)

            else
                still model

        Tui.KeyPressed pressed ->
            if pressed.id == listId then
                pressKey ports pressed.key { model | message = "" }

            else
                still model

        Tui.Copied it ->
            if model.copied then
                still
                    { model
                        | copied = False
                        , message =
                            if it.toSystem then
                                "Copied to the clipboard."

                            else
                                "Copied; F1 if it does not paste."
                    }

            else
                still model

        Tui.Command cmd ->
            when cmd is
                "env.find" ->
                    { model = { model | message = "" }, command = Tui.focus ports findId }

                "env.case" ->
                    still { model | matchCase = not model.matchCase, top = 0, message = "" }

                "env.all" ->
                    still { model | needle = "", top = 0, message = "" }

                "env.copy" ->
                    copyShown ports model

                _ ->
                    still model

        _ ->
            still model


{-| The keys the list answers to.

`/` is the one worth explaining: it moves the caret to the search box. A
focused canvas consumes every key it is given -- `JsCanvas::handleEvent` says
so -- and `Tab` is a key, so a canvas is the end of a window's tab ring rather
than a station on it. Without a way back the list would be a one-way door, and
`/` is the way back that a person coming from `less` or `vim` will try first.
-}
pressKey : Tui.Ports msg -> String -> Model -> Step msg
pressKey ports key model =
    when key is
        "Up" ->
            still (scrollTo (model.top - 1) model)

        "Down" ->
            still (scrollTo (model.top + 1) model)

        "PgUp" ->
            still (scrollTo (model.top - model.rows) model)

        "PgDn" ->
            still (scrollTo (model.top + model.rows) model)

        "Home" ->
            still (scrollTo 0 model)

        "End" ->
            still (scrollTo (lastTop model) model)

        "/" ->
            { model = model, command = Tui.focus ports findId }

        "c" ->
            still { model | matchCase = not model.matchCase, top = 0 }

        "C" ->
            still { model | matchCase = not model.matchCase, top = 0 }

        "y" ->
            copyShown ports model

        "Y" ->
            copyShown ports model

        _ ->
            still model


still : Model -> Step msg
still model =
    { model = model, command = Cmd.none }


scrollTo : Int -> Model -> Model
scrollTo where_ model =
    { model | top = clamp 0 (lastTop model) where_ }


lastTop : Model -> Int
lastTop model =
    max 0 (Array.length (laidOut (shown model)) - model.rows)


{-| How many rows of a window this tall are the list.

Five are spoken for: two frame rows, the row the search box is on, the blank
under it, and the status line at the bottom.
-}
rowsIn : Int -> Int
rowsIn height =
    max 1 (height - 5)


{-| What is on the screen, as `NAME=value` -- one line each, unwrapped.

Unwrapped because a copy is for pasting somewhere else, and the wrapping is a
fact about this window rather than about the variable. Filtered because the
filter is the selection: there is no cursor in this list and no need for one,
since narrowing to the variable you want takes fewer keystrokes than walking to
it would.
-}
copyShown : Tui.Ports msg -> Model -> Step msg
copyShown ports model =
    let
        picked =
            shown model
    in
    if Array.isEmpty picked then
        still { model | message = "Nothing to copy." }

    else
        { model = { model | copied = True, message = "" }
        , command =
            Tui.copyToClipboard ports
                (String.join "\n"
                    (Array.map (\pair -> pair.name ++ "=" ++ pair.value) picked)
                )
        }


-- VIEW


view : Inks -> Model -> Tui.Window
view inks model =
    let
        picked =
            shown model
    in
    { id = windowId
    , title = "Environment"
    , rect = { x1 = 0, y1 = 1, x2 = 79, y2 = 6 + openRows }
    , resize = Tui.resizeHeight
    , palette = Tui.BlueWindow
    , canClose = True
    , canMove = True
    , views =
        -- The search box first, so it holds the caret when the window opens.
        -- Typing is what this tool is for, and the list is already drawn.
        [ InputLine
            { id = findId
            , rect = { x1 = 9, y1 = 1, x2 = 45, y2 = 2 }
            , maxLen = 128
            , value = model.needle
            , allowed = Nothing
            }
        , Label
            { id = "env.find.label"
            , rect = { x1 = 2, y1 = 1, x2 = 9, y2 = 2 }
            , text = "Search"
            , for = findId
            }
        , CheckBoxes
            { id = caseId
            -- No `~` in the caption: it would claim an `Alt` letter for as
            -- long as this window is open, and there are none going spare.
            -- `c` on the list toggles it, and so does the menu.
            , rect = { x1 = 48, y1 = 1, x2 = 66, y2 = 2 }
            , items = [ "Match case" ]
            , checked = [ model.matchCase ]
            , available = []
            }
        , Grows
            { grow = Tui.stretchHeight
            , view =
                Canvas
                    { id = listId
                    , rect = { x1 = 1, y1 = 3, x2 = 1 + lineWidth, y2 = 3 + openRows }
                    , lines = display inks model picked
                    , cursor = Nothing
                    , takesFocus = True
                    }
            }
        , Grows
            { grow = Tui.stretchHeight
            , view =
                ScrollBar
                    { id = scrollId
                    , rect = { x1 = 2 + lineWidth, y1 = 3, x2 = 3 + lineWidth, y2 = 3 + openRows }
                    , value = model.top
                    , min = 0
                    , max = lastTop model
                    , pageStep = model.rows
                    , arrowStep = 1
                    -- The list is the only thing in this window that scrolls,
                    -- so the wheel is taken from anywhere in it.
                    , for = ""
                    }
            }
        , Grows
            { grow = Tui.pinBottom
            , view =
                StaticText
                    { id = "env.status"
                    -- To `1 + lineWidth` and not past it: the scroll bar
                    -- above sits *on* the frame's right wall, and a status
                    -- line as wide as the scroll bar would rub the wall out
                    -- on its own row and leave the window looking torn.
                    , rect =
                        { x1 = 1
                        , y1 = 3 + openRows
                        , x2 = 1 + lineWidth
                        , y2 = 4 + openRows
                        }
                    , text = status model picked
                    }
            }
        ]
    }


{-| The list, scrolled, with the needle picked out inside each row.

Every row on screen is a match while a needle is typed -- that is what
filtering means -- so marking whole rows would say nothing and would put
fifteen lines of inverse video on the screen to say it. Marking the *matched
text* answers the question the eye actually has, which is why this row is here:
`CMAKE_INCLUDE_PATH` and `DBUS_SESSION_BUS_ADDRESS` both match `path`, and only
one of them matches in its name.
-}
display : Inks -> Model -> Array Pair -> Array (Array Span)
display inks model picked =
    if Array.isEmpty picked then
        [ [ Tui.ink inks.dim ("Nothing matches " ++ quoted model.needle ++ ".") ] ]

    else
        laidOut picked
            |> Array.dropFirst model.top
            |> Array.takeFirst model.rows
            |> Array.map (\row -> lit inks model row.text)


{-| One line, split into the needle and everything else.

Scanned character by character over the *original* text rather than by finding
an index in a lower-cased copy of it, which is the version that would be
subtly wrong: lower-casing is not always length-preserving (Turkish dotted
capital I becomes two code points), so an offset found in the copy does not
always mean the same place in the original. A line is at most seventy-six
characters and a needle is short, so comparing in place costs nothing worth
saving.
-}
lit : Inks -> Model -> String -> Array Span
lit inks model text =
    let
        chars =
            String.toArray text

        len =
            String.count model.needle
    in
    if len == 0 then
        [ Tui.plain text ]

    else
        let
            slice from count =
                String.fromArray (Array.takeFirst count (Array.dropFirst from chars))

            same a b =
                if model.matchCase then
                    a == b

                else
                    String.toLower a == String.toLower b

            marked body =
                Tui.on inks.marking.bg (Tui.ink inks.marking.fg body)

            pushPlain body acc =
                if String.isEmpty body then
                    acc

                else
                    Array.pushLast (Tui.plain body) acc

            go index plainFrom acc =
                if index > Array.length chars - len then
                    pushPlain (slice plainFrom (Array.length chars - plainFrom)) acc

                else if same (slice index len) model.needle then
                    go (index + len)
                        (index + len)
                        (acc
                            |> pushPlain (slice plainFrom (index - plainFrom))
                            |> Array.pushLast (marked (slice index len))
                        )

                else
                    go (index + 1) plainFrom acc
        in
        go 0 0 []


status : Model -> Array Pair -> String
status model picked =
    if not (String.isEmpty model.message) then
        model.message

    else
        let
            howMany =
                if String.isEmpty model.needle then
                    String.fromInt (Array.length model.all) ++ " variables"

                else
                    String.fromInt (Array.length picked)
                        ++ " of "
                        ++ String.fromInt (Array.length model.all)
                        ++ " match "
                        ++ quoted model.needle
        in
        howMany
            ++ (if model.matchCase then
                    ", matching case"

                else
                    ""
               )
            -- `Tab` is on the hint because the search box has the caret when
            -- the window opens and a focused canvas is the end of the tab
            -- ring: the three one-letter keys belong to the list, and the way
            -- to the list is `Tab`. `/` is the way back.
            ++ "   Tab list   / search   c case   y copy"


quoted : String -> String
quoted text =
    "\"" ++ text ++ "\""

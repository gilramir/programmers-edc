module Tool.Calc exposing (Model, command, init, menu, menuItem, update, view, windowId)

{-| An RPN calculator that works in the bases a programmer works in, on
integers that do not overflow.

Reverse Polish because the alternative is writing an expression parser and a
precedence table for a window four inches wide, and because a stack you can see
is easier to trust than a line of text with brackets in it. Type a number,
press `Enter` to push it, press an operator to consume the top two.

Three things about the design are worth stating.

**It is keyboard-first, and that is why the display is a canvas.** A focused
canvas consumes every key it is given, which is exactly what a calculator
wants: `7` is a digit and not a hunt for a button captioned 7. It is also why
the buttons say `takesFocus = False` -- the trap `TCalculator` avoids by
clearing `ofSelectable` on all twenty of its keys, with no comment saying why.
The keys that must still work from in here -- `Alt-X`, `F5`, `F6`, `Alt-F3` --
do, because the menu bar and the status line are `ofPreProcess` views and are
offered a key before the focused view is.

**The integers are `BigInt`, so `uint64` arithmetic is exact.** A Gren `Int` is
a double: `2^64 - 1` is not representable, and `//` is worse than that. The
width is a *view* rather than a type -- the stack holds exact integers, and
`u64` or `i64` decides how they are shown and whether they are marked as having
overflowed. Nothing is silently truncated; if a value does not fit the width
you are looking through, it says so.

**Division promotes rather than truncating, and what it promotes to is
exact.** `10 2 /` is `5` and stays an integer; `7 2 /` is `3.5`, because a
calculator that answered `3` would be wrong in the way that costs an
afternoon. The other half of that is `BigDecimal` rather than `Float`:
`0.1 0.2 +` is `0.3` and not `0.30000000000000004`, and dividing two
sixty-four-bit integers keeps every digit of the answer instead of the
fifty-three bits a double would have had left. The one division that cannot
be exact is the one that does not terminate, and that answer is written with
a leading `~` for the same reason a value that does not fit its width is
marked `ovf`. `%` is there for the truncating answer, and works on integers
only.

**It is not sealed off from the rest of the machine.** A number you already
have is pasted into what you are typing with `v`, and a result is copied off
the stack with `y` -- because a calculator whose answers can only be read and
retyped is one you stop using for the numbers that matter, which are the long
ones. Both go through the one clipboard `gren-tvision/doc/clipboard.md`
describes, so a copy here and a paste in the hex viewer are the same text even
over ssh, where no terminal will hand a clipboard over.

-}

import Array exposing (Array)
import BigDecimal exposing (BigDecimal)
import BigInt exposing (BigInt)
import Char
import Math
import String
import Theme exposing (Inks)
import Tui exposing (Hue(..), MenuItem(..), Span, View(..))


-- NAMES


command : String
command =
    "tool.calc"


windowId : String
windowId =
    "calc"


canvasId : String
canvasId =
    "calc.display"


menuItem : MenuItem
menuItem =
    Item { title = "~R~PN calculator", cmd = command, key = "Alt-R", shortcut = "Alt-R" }


-- MODEL


type Base
    = Dec
    | Hex
    | Oct
    | Bin


{-| A decimal, and whether it is the whole of the answer.

`rounded` is set by the only operation that can lose a digit -- a division
that does not terminate -- and anything computed from such a value carries it
onwards, because a sum is no more exact than what went into it. It is the
`ovf` of the decimal side: a fact about what is being shown that the number
itself cannot carry.

`show` writes it as a leading `~` rather than a word after the digits, and
the reason is the display. Twenty significant digits of a small quotient is
already most of a thirty-five-column line, so a marker on the right is the
first thing to fall off the end of it -- and the marker falling off a number
too long to show is precisely the case it exists for.

-}
type alias Decimal =
    { amount : BigDecimal
    , rounded : Bool
    }


type Value
    = Whole BigInt
    | Real Decimal


{-| The stack's last element is its top, which is the end everything happens
at and the end `Array.pushLast` is cheap at.
-}
type alias Model =
    { stack : Array Value
    , entry : String
    , base : Base
    , width : Maybe { bits : Int, signed : Bool }
    -- A paste asked for and not yet answered. Every open tool is handed every
    -- event, so without this a paste made in the hex viewer would land in the
    -- calculator's entry as well.
    , awaiting : Bool
    -- Whether the last copy was this tool's. `Copied` reaches every open tool
    -- and says only whether anything outside took the text, so the answer has
    -- to be waited for -- but not the text itself: the value is on the screen
    -- already, and a message naming it could not fit beside the caveat.
    , copied : Bool
    , message : String
    }


init : Model
init =
    { stack = []
    , entry = ""
    , base = Dec
    , width = Nothing
    , awaiting = False
    , copied = False
    , message = ""
    }


rows : Int
rows =
    5


{-| How wide the canvas is, and therefore how long a message may be.

Written down because it was not, and a line that does not fit is cut off
without a mark: `Copied 130 -- the terminal did not confirm it.` arrived on
screen as `Copied 130 -- the terminal did not`, which reads like a finished
sentence and says the opposite of the truth. Every message below is written to
fit this, and `messageLine` marks anything that still does not.
-}
canvasWidth : Int
canvasWidth =
    34


-- UPDATE


{-| Everything the calculator can hand back. The arithmetic produces none of
it -- only the clipboard does, and only ever an outbound port send, which is
why this is polymorphic in the message type the way the decoder's is: there is
no reply to map, so the shell's own ports go in unchanged.
-}
type alias Step msg =
    { model : Model, command : Cmd msg }


still : Model -> Step msg
still model =
    { model = model, command = Cmd.none }


{-| The two clipboard keys are taken out before `pressKey`, and the two
clipboard commands before `runCommand`, so that the arithmetic underneath stays
a pure `Model -> Model`. That is worth the two extra branches: everything this
calculator is actually about can go on being tested without a `Cmd` in sight.
-}
update : Tui.Ports msg -> Tui.Event -> Model -> Step msg
update ports event model =
    when event is
        Tui.KeyPressed pressed ->
            if pressed.id == canvasId then
                let
                    quiet =
                        { model | message = "" }
                in
                when pressed.key is
                    -- `y` for the copy, as in the hex viewer and the decoder.
                    -- `v` for the paste and *not* `p`, which is the hex
                    -- viewer's: `p` here has been Drop since the day this was
                    -- written, and a key that drops the top of somebody's
                    -- stack when they meant to paste is the worst possible
                    -- place to be consistent. Neither is a hex digit, which
                    -- is what makes them free at all.
                    "y" ->
                        copyLevel ports 1 quiet

                    "v" ->
                        askClipboard ports quiet

                    other ->
                        still (pressKey other quiet)

            else
                still model

        -- The guard is not politeness: every open tool is handed every event,
        -- and `awaiting` is what says this one asked.
        Tui.ClipboardText it ->
            if model.awaiting then
                still (pasted it { model | awaiting = False })

            else
                still model

        Tui.Copied it ->
            if model.copied then
                still
                    { model
                        | copied = False
                        , message =
                            if it.toSystem then
                                "Copied to the clipboard."

                            else
                                -- Not "nothing took it", and not the hex
                                -- viewer's longer sentence either, which does
                                -- not fit here and arrived cut off mid-clause.
                                -- The `OSC 52` goes out every time; what is
                                -- unknown is whether anything downstream took
                                -- it -- tmux's default `set-clipboard
                                -- external` swallows it and answers nothing,
                                -- so this is the *normal* reading inside tmux
                                -- even when the copy worked. Hence a
                                -- conditional rather than a failure, and a key
                                -- to press if it turns out to matter.
                                "Copied; F1 if it does not paste."
                    }

            else
                still model

        Tui.Command cmd ->
            if String.startsWith "calc." cmd then
                let
                    name =
                        String.dropFirst 5 cmd

                    quiet =
                        { model | message = "" }
                in
                if name == "paste" then
                    askClipboard ports quiet

                else if name == "copy.all" then
                    copyAll ports quiet

                else if String.startsWith "copy." name then
                    when String.toInt (String.dropFirst 5 name) is
                        Just level ->
                            copyLevel ports level quiet

                        Nothing ->
                            still quiet

                else
                    still (runCommand name quiet)

            else
                still model

        _ ->
            still model


{-| The menu and the buttons both arrive here. They are the same commands,
which is the point of having both: a button is a mouse's way of pressing a key.
-}
runCommand : String -> Model -> Model
runCommand name model =
    when name is
        "dec" ->
            { model | base = Dec }

        "hex" ->
            { model | base = Hex }

        "oct" ->
            { model | base = Oct }

        "bin" ->
            { model | base = Bin }

        "width.none" ->
            { model | width = Nothing }

        "width.u32" ->
            { model | width = Just { bits = 32, signed = False } }

        "width.i32" ->
            { model | width = Just { bits = 32, signed = True } }

        "width.u64" ->
            { model | width = Just { bits = 64, signed = False } }

        "width.i64" ->
            { model | width = Just { bits = 64, signed = True } }

        "enter" ->
            enter model

        "drop" ->
            drop model

        "swap" ->
            swap model

        "dup" ->
            dup model

        "clear" ->
            { model | stack = [], entry = "" }

        _ ->
            binaryNamed name model


binaryNamed : String -> Model -> Model
binaryNamed name model =
    when name is
        "add" ->
            binary add model

        "sub" ->
            binary subtract model

        "mul" ->
            binary multiply model

        "div" ->
            binary divide model

        "rem" ->
            binary remainder model

        "and" ->
            binary (bits BigInt.and) model

        "or" ->
            binary (bits BigInt.or) model

        "xor" ->
            binary (bits BigInt.xor) model

        "shl" ->
            binary (shift True) model

        "shr" ->
            binary (shift False) model

        "not" ->
            unary complement model

        "neg" ->
            unary negate model

        _ ->
            model


pressKey : String -> Model -> Model
pressKey key model =
    when key is
        "Enter" ->
            enter model

        "Backspace" ->
            { model | entry = String.dropLast 1 model.entry }

        "Esc" ->
            { model | entry = "" }

        -- Cycling with Tab rather than binding four keys: in hex the letters
        -- a to f are digits, so the base cannot be chosen by its initial.
        -- `w` is free for the same reason -- it is not a hex digit.
        "Tab" ->
            { model | base = nextBase model.base }

        "w" ->
            { model | width = nextWidth model.width }

        "+" ->
            binary add model

        "-" ->
            binary subtract model

        "*" ->
            binary multiply model

        "/" ->
            binary divide model

        "%" ->
            binary remainder model

        "&" ->
            binary (bits BigInt.and) model

        "|" ->
            binary (bits BigInt.or) model

        "^" ->
            binary (bits BigInt.xor) model

        "<" ->
            binary (shift True) model

        ">" ->
            binary (shift False) model

        "~" ->
            unary complement model

        "n" ->
            unary negate model

        "s" ->
            swap model

        "p" ->
            drop model

        "u" ->
            dup model

        "z" ->
            { model | stack = [], entry = "" }

        other ->
            when String.popFirst other is
                Just { first, rest } ->
                    if String.isEmpty rest && accepts model.base first then
                        { model | entry = model.entry ++ String.fromChar first }

                    else
                        model

                Nothing ->
                    model


{-| Exact, then the four widths, then back. A cycle rather than five keys,
because the menu is where a particular width is chosen and this is for looking
at the same number through each in turn.
-}
nextWidth : Maybe { bits : Int, signed : Bool } -> Maybe { bits : Int, signed : Bool }
nextWidth width =
    when width is
        Nothing ->
            Just { bits = 64, signed = False }

        Just { bits = 64, signed = False } ->
            Just { bits = 64, signed = True }

        Just { bits = 64, signed = True } ->
            Just { bits = 32, signed = False }

        Just { bits = 32, signed = False } ->
            Just { bits = 32, signed = True }

        _ ->
            Nothing


nextBase : Base -> Base
nextBase base =
    when base is
        Dec ->
            Hex

        Hex ->
            Oct

        Oct ->
            Bin

        Bin ->
            Dec


{-| Which characters may be typed, which depends on the base you are in. `_` is
allowed everywhere and ignored on the way in, so `dead_beef` can be typed the
way it would be written; `.` only in decimal, because a hexadecimal float is
not a thing this calculator has an opinion about.
-}
accepts : Base -> Char -> Bool
accepts base char =
    let
        raw =
            Char.toCode char

        -- Lowercase by arithmetic: `Char` has no `toLower`, and the only
        -- letters that reach here are A-F.
        code =
            if raw >= 0x41 && raw <= 0x5A then
                raw + 0x20

            else
                raw

        digit =
            if code >= 0x30 && code <= 0x39 then
                code - 0x30

            else if code >= 0x61 && code <= 0x66 then
                code - 0x61 + 10

            else
                99
    in
    if char == '_' then
        True

    else if char == '.' then
        base == Dec

    else
        digit < radix base


radix : Base -> Int
radix base =
    when base is
        Dec ->
            10

        Hex ->
            16

        Oct ->
            8

        Bin ->
            2


-- THE CLIPBOARD


{-| Ask for the clipboard and remember that it was this tool asking.

The message is not decoration. `readClipboard` is a request, and on a terminal
that owns the clipboard the answer comes back through the input stream and may
take a moment or never arrive at all -- so "waiting" is the one state this tool
can be in that it cannot otherwise draw.
-}
askClipboard : Tui.Ports msg -> Model -> Step msg
askClipboard ports model =
    { model = { model | awaiting = True, message = "Asking for the clipboard..." }
    , command = Tui.readClipboard ports
    }


{-| The clipboard answered, and what came back goes where the digits go.

**Into the entry rather than onto the stack**, because that is what was asked
for: a pasted number is a typed number, and `Enter` is still what pushes it.
It appends for the same reason -- paste after typing `1` and you have `1` and
then what you pasted, which is what a field would have done.

**Read in the base showing, and refused otherwise.** `0xFF` pasted while the
calculator is in decimal is not 255 here; it is an error with a sentence,
because a calculator that quietly changed base under a paste would answer a
different question than the one asked and look right doing it. That is the hex
viewer's rule about `p` and `P` in another costume.

The one thing it does forgive is predc's own prefix. `show` writes `0xDEAD_BEEF`
and the underscores were always typeable; the `0x` was not, so a value copied
off this stack could not be pasted back into it. Stripping the prefix *of the
base already showing* is not sniffing -- it is the round trip closing.
-}
pasted : { text : String, fromSystem : Bool } -> Model -> Model
pasted answer model =
    let
        cleaned =
            String.trim answer.text
    in
    if String.isEmpty cleaned then
        { model
            | message =
                if answer.fromSystem then
                    "The clipboard is empty."

                else
                    -- Nothing outside answered *and* nothing here has copied:
                    -- the state every ssh session is permanently in, where it
                    -- is a fact about the terminal and not about a clipboard.
                    -- Thirty-four columns will not hold that, so it is a
                    -- pointer at the window that explains it instead.
                    "No clipboard here -- F1 says why."
        }

    else
        let
            candidate =
                model.entry ++ withoutPrefix model.base cleaned
        in
        when parse model.base candidate is
            Just _ ->
                -- The "asking" line goes with the answer. It is the only
                -- message here that describes a question rather than a result,
                -- so leaving it up would say the calculator was still waiting
                -- while the number sat on the screen in front of it.
                { model | entry = candidate, message = "" }

            Nothing ->
                { model
                    | message =
                        -- Bounded, because what was pasted is somebody else's
                        -- text and can be any length at all.
                        "Not a "
                            ++ baseName model.base
                            ++ " number: "
                            ++ (if String.count cleaned > 15 then
                                    String.takeFirst 14 cleaned ++ "…"

                                else
                                    cleaned
                               )
                }


{-| Drop the prefix `show` writes for this base, and no other. In decimal the
prefix is empty, and dropping nothing from the front is what that means.
-}
withoutPrefix : Base -> String -> String
withoutPrefix base text =
    let
        mark =
            prefix base
    in
    if not (String.isEmpty mark) && String.startsWith mark text then
        String.dropFirst (String.count mark) text

    else
        text


{-| Copy one level of the stack, numbered the way the display numbers it: `1`
is the top, which is where the last answer is.

The guard on `index` is [`Array.get`](https://packages.gren-lang.org)'s trap
rather than defensiveness -- a negative index counts from the *end* in Gren, so
asking an empty stack for level 1 would hand back its own last value if there
were one, and the same mistake once put a stale row on this program's screen.
-}
copyLevel : Tui.Ports msg -> Int -> Model -> Step msg
copyLevel ports level model =
    let
        index =
            Array.length model.stack - level
    in
    if index < 0 then
        still { model | message = "There is nothing on level " ++ String.fromInt level ++ "." }

    else
        when Array.get index model.stack is
            Just value ->
                sending ports (plainly model value) model

            Nothing ->
                still { model | message = "There is nothing on level " ++ String.fromInt level ++ "." }


{-| The whole stack, one value to a line, in the order the window shows them --
deepest first, so the last line is the top and the last answer.
-}
copyAll : Tui.Ports msg -> Model -> Step msg
copyAll ports model =
    if Array.isEmpty model.stack then
        still { model | message = "The stack is empty." }

    else
        sending ports
            (String.join "\n" (Array.map (plainly model) model.stack))
            model


sending : Tui.Ports msg -> String -> Model -> Step msg
sending ports text model =
    { model = { model | copied = True, message = "" }
    , command = Tui.copyToClipboard ports text
    }


{-| A value as the window shows it, without the `ovf` beside it.

The marker is an annotation and not part of the number -- the digits next to it
*are* the value seen through the width chosen, which is the thing worth
copying. Everything else `show` writes is kept, including the `~` on an
inexact division: a number that is not quite the answer must not be copied as
though it were.
-}
plainly : Model -> Value -> String
plainly model value =
    String.trim (String.replace "  ovf" "" (show model value))


-- THE STACK


{-| Push what has been typed. With nothing typed, `Enter` duplicates the top,
which is what every RPN calculator does and what makes `dup` reachable without
a second key.
-}
enter : Model -> Model
enter model =
    if String.isEmpty model.entry then
        dup model

    else
        when parse model.base model.entry is
            Just value ->
                { model | stack = Array.pushLast value model.stack, entry = "" }

            Nothing ->
                { model | message = "not a number: " ++ model.entry }


{-| An operator acts on what is on the stack, so anything half-typed is pushed
first -- `2 Enter 3 +` and `2 Enter 3 Enter +` mean the same thing.
-}
commit : Model -> Model
commit model =
    if String.isEmpty model.entry then
        model

    else
        enter model


drop : Model -> Model
drop model =
    { model | stack = Array.dropLast 1 model.stack }


dup : Model -> Model
dup model =
    when Array.last model.stack is
        Just top ->
            { model | stack = Array.pushLast top model.stack }

        Nothing ->
            model


swap : Model -> Model
swap model =
    when popTwo model.stack is
        Just it ->
            { model | stack = Array.pushLast it.first (Array.pushLast it.second it.rest) }

        Nothing ->
            { model | message = "swap needs two" }


{-| The top two, or nothing at all.

The length is checked before the indices are computed, and that is not
belt-and-braces: **`Array.get` counts from the end when the index is
negative**, so a stack of one would answer `get -1` with its own only value
and every binary operator would quietly work on one number twice.
-}
popTwo : Array Value -> Maybe { first : Value, second : Value, rest : Array Value }
popTwo stack =
    if Array.length stack < 2 then
        Nothing

    else
        when { top = Array.last stack, next = Array.get (Array.length stack - 2) stack } is
            { top = Just top, next = Just next } ->
                Just { first = next, second = top, rest = Array.dropLast 2 stack }

            _ ->
                Nothing


binary : (Value -> Value -> Result String Value) -> Model -> Model
binary operation model =
    let
        ready =
            commit model
    in
    when popTwo ready.stack is
        Just it ->
            when operation it.first it.second is
                Ok value ->
                    { ready | stack = Array.pushLast value it.rest }

                Err problem ->
                    { ready | message = problem }

        Nothing ->
            { ready | message = "needs two values" }


unary : (Value -> Result String Value) -> Model -> Model
unary operation model =
    let
        ready =
            commit model
    in
    when Array.last ready.stack is
        Just top ->
            when operation top is
                Ok value ->
                    { ready | stack = Array.pushLast value (Array.dropLast 1 ready.stack) }

                Err problem ->
                    { ready | message = problem }

        Nothing ->
            { ready | message = "needs a value" }


-- ARITHMETIC


{-| Read what was typed, in the base it was typed in. The separators come out
first: both readers take an underscore *between two digits*, and `accepts`
lets one be typed anywhere, including at the end of a number still being
typed.
-}
parse : Base -> String -> Maybe Value
parse base text =
    let
        cleaned =
            String.replace "_" "" text
    in
    if base == Dec && String.contains "." cleaned then
        BigDecimal.fromString cleaned
            |> Maybe.map (\amount -> Real { amount = amount, rounded = False })

    else
        Maybe.map Whole (BigInt.fromStringWithBase (radix base) cleaned)


add : Value -> Value -> Result String Value
add a b =
    Ok (arithmetic BigInt.add BigDecimal.add a b)


subtract : Value -> Value -> Result String Value
subtract a b =
    Ok (arithmetic (\x y -> x |> BigInt.subBy y) (\x y -> x |> BigDecimal.subBy y) a b)


multiply : Value -> Value -> Result String Value
multiply a b =
    Ok (arithmetic BigInt.mul BigDecimal.mul a b)


{-| Two integers stay an integer; anything else is done in decimal, where
`add`, `subBy` and `mul` widen rather than round and so cannot lose anything
that was not lost before they were called. Which is why the only thing to
work out about the answer is whether an operand was already short of digits.
-}
arithmetic : (BigInt -> BigInt -> BigInt) -> (BigDecimal -> BigDecimal -> BigDecimal) -> Value -> Value -> Value
arithmetic whole decimal a b =
    when { left = a, right = b } is
        { left = Whole x, right = Whole y } ->
            Whole (whole x y)

        _ ->
            Real
                { amount = decimal (toDecimal a) (toDecimal b)
                , rounded = isRounded a || isRounded b
                }


{-| An integer when it divides, a decimal when it does not. A programmer's
calculator answering `3` to `7 2 /` would be wrong in the expensive way; one
that answered `3.5` to `10 2 /` would have thrown away the fact that the
answer is an integer. `%` is the truncating one.

The decimal half is where this used to quietly stop being a calculator you
could trust. It divided two `Float`s, so `18446744073709551615 3 /` answered
with the nearest double -- a run of zeroes where the last five digits belong
-- in the one program whose whole claim is that a `uint64` is exact.

-}
divide : Value -> Value -> Result String Value
divide a b =
    when { left = a, right = b } is
        { left = Whole x, right = Whole y } ->
            when x |> BigInt.quotRemBy y is
                Just answer ->
                    if BigInt.isZero answer.remainder then
                        Ok (Whole answer.quotient)

                    else
                        inDecimal a b

                Nothing ->
                    Err "divide by zero"

        _ ->
            inDecimal a b


{-| Divide in decimal: exactly when the quotient terminates, and to enough
places to be worth reading when it does not.

`divBy` answers `Nothing` for a zero divisor and for a quotient that runs
forever, and does not say which. The divisor is asked first so that the
`Nothing` left over can only mean the second.

-}
inDecimal : Value -> Value -> Result String Value
inDecimal a b =
    let
        x =
            toDecimal a

        y =
            toDecimal b
    in
    if BigDecimal.isZero y then
        Err "divide by zero"

    else
        when x |> BigDecimal.divBy y is
            Just answer ->
                Ok (Real { amount = answer, rounded = isRounded a || isRounded b })

            Nothing ->
                when x |> BigDecimal.divByTo (placesFor x y) BigDecimal.HalfEven y is
                    Just answer ->
                        Ok (Real { amount = answer, rounded = True })

                    Nothing ->
                        Err "divide by zero"


{-| How far a non-terminating quotient is worked out.

Twenty *significant* digits rather than twenty decimal places, because the
difference between those two is exactly the case a programmer's calculator
walks into: `1` divided by the largest `uint64` begins nineteen zeroes after
the point, and twenty places of it would be one digit of answer and nineteen
of nothing. A quotient's magnitude is within one of the difference of the two
magnitudes, and one digit either way does not matter when the number is only
going to be read.

-}
placesFor : BigDecimal -> BigDecimal -> Int
placesFor dividend divisor =
    max significant (significant - (magnitude dividend - magnitude divisor))


significant : Int
significant =
    20


{-| Where the leading digit sits: `10 ^ (magnitude v - 1) <= abs v < 10 ^ magnitude v`
for a non-zero `v`. Zero has no leading digit and answers `0`.
-}
magnitude : BigDecimal -> Int
magnitude value =
    if BigDecimal.isZero value then
        0

    else
        String.count (BigInt.toString (BigInt.abs (BigDecimal.unscaled value)))
            - BigDecimal.scale value


remainder : Value -> Value -> Result String Value
remainder a b =
    when { left = a, right = b } is
        { left = Whole x, right = Whole y } ->
            when x |> BigInt.quotRemBy y is
                Just answer ->
                    Ok (Whole answer.remainder)

                Nothing ->
                    Err "divide by zero"

        _ ->
            Err "% needs whole numbers"


bits : (BigInt -> BigInt -> BigInt) -> Value -> Value -> Result String Value
bits operation a b =
    when { left = a, right = b } is
        { left = Whole x, right = Whole y } ->
            Ok (Whole (operation x y))

        _ ->
            Err "bitwise needs whole numbers"


shift : Bool -> Value -> Value -> Result String Value
shift left a b =
    when { value = a, count = b } is
        { value = Whole x, count = Whole y } ->
            when BigInt.toInt y is
                Just count ->
                    Ok
                        (Whole
                            (if left then
                                x |> BigInt.shiftLeftBy count

                             else
                                x |> BigInt.shiftRightBy count
                            )
                        )

                Nothing ->
                    Err "shift count is absurd"

        _ ->
            Err "shifts need whole numbers"


complement : Value -> Result String Value
complement value =
    when value is
        Whole x ->
            Ok (Whole (BigInt.complement x))

        Real _ ->
            Err "~ needs a whole number"


negate : Value -> Result String Value
negate value =
    when value is
        Whole x ->
            Ok (Whole (BigInt.negate x))

        Real it ->
            Ok (Real { it | amount = BigDecimal.negate it.amount })


{-| An integer becomes a decimal exactly. `fromBigInt` is a change of
representation and not a conversion, which is what `BigInt.toFloat` was, and
why mixing an integer into a decimal sum used to cost every digit past the
fifty-third.
-}
toDecimal : Value -> BigDecimal
toDecimal value =
    when value is
        Whole x ->
            BigDecimal.fromBigInt x

        Real it ->
            it.amount


isRounded : Value -> Bool
isRounded value =
    when value is
        Whole _ ->
            False

        Real it ->
            it.rounded


-- SHOWING


{-| What a value looks like in the base and width currently being looked
through.

The width is a lens and not a cast: the stack keeps the exact number, and this
shows what a register that wide would hold. When the two differ -- when the
value would not have fitted -- it says `ovf` rather than quietly showing the
wrapped one as though it were the answer.

-}
show : Model -> Value -> String
show model value =
    when value is
        Real it ->
            (if it.rounded then
                "~"

             else
                ""
            )
                ++ BigDecimal.toString it.amount

        Whole x ->
            when model.width is
                Nothing ->
                    marked model x

                Just width ->
                    let
                        viewed =
                            if width.signed then
                                BigInt.toSigned width.bits x

                            else
                                BigInt.maskTo width.bits x

                        fits =
                            if width.signed then
                                BigInt.fitsSigned width.bits x

                            else
                                BigInt.fitsUnsigned width.bits x
                    in
                    marked model viewed
                        ++ (if fits then
                                ""

                            else
                                "  ovf"
                           )


marked : Model -> BigInt -> String
marked model value =
    let
        digits =
            BigInt.toStringWithBase (radix model.base) (BigInt.abs value)

        sign =
            if BigInt.isNegative value then
                "-"

            else
                ""
    in
    sign ++ prefix model.base ++ group model.base digits


prefix : Base -> String
prefix base =
    when base is
        Dec ->
            ""

        Hex ->
            "0x"

        Oct ->
            "0o"

        Bin ->
            "0b"


{-| Underscores every four digits in the bases where counting them is the
whole difficulty, and none in decimal where it is not. They are separators the
calculator will also accept as input, so a value can be read off the screen and
typed straight back in.
-}
group : Base -> String -> String
group base digits =
    if base == Dec || String.count digits <= 4 then
        digits

    else
        let
            go rest acc =
                if String.count rest <= 4 then
                    rest ++ acc

                else
                    go (String.dropLast 4 rest) ("_" ++ String.takeLast 4 rest ++ acc)
        in
        go digits ""


baseName : Base -> String
baseName base =
    when base is
        Dec ->
            "dec"

        Hex ->
            "hex"

        Oct ->
            "oct"

        Bin ->
            "bin"


widthName : Maybe { bits : Int, signed : Bool } -> String
widthName width =
    when width is
        Nothing ->
            "exact"

        Just it ->
            (if it.signed then
                "i"

             else
                "u"
            )
                ++ String.fromInt it.bits


-- VIEW


menu : Model -> MenuItem
menu model =
    SubMenu
        { title = "~C~alc"
        , key = ""
        , items =
            [ SubMenu
                { title = "~B~ase"
                , key = ""
                , items =
                    [ Item { title = tick (model.base == Dec) ++ "~D~ecimal", cmd = "calc.dec", key = "", shortcut = "" }
                    , Item { title = tick (model.base == Hex) ++ "~H~exadecimal", cmd = "calc.hex", key = "", shortcut = "" }
                    , Item { title = tick (model.base == Oct) ++ "~O~ctal", cmd = "calc.oct", key = "", shortcut = "" }
                    , Item { title = tick (model.base == Bin) ++ "~B~inary", cmd = "calc.bin", key = "", shortcut = "" }
                    ]
                }
            , SubMenu
                { title = "~W~idth"
                , key = ""
                , items =
                    [ Item { title = tick (model.width == Nothing) ++ "~E~xact", cmd = "calc.width.none", key = "", shortcut = "" }
                    , Item { title = tick (model.width == Just { bits = 64, signed = False }) ++ "~u~64", cmd = "calc.width.u64", key = "", shortcut = "" }
                    , Item { title = tick (model.width == Just { bits = 64, signed = True }) ++ "~i~64", cmd = "calc.width.i64", key = "", shortcut = "" }
                    , Item { title = tick (model.width == Just { bits = 32, signed = False }) ++ "u3~2~", cmd = "calc.width.u32", key = "", shortcut = "" }
                    , Item { title = tick (model.width == Just { bits = 32, signed = True }) ++ "i3~2~", cmd = "calc.width.i32", key = "", shortcut = "" }
                    ]
                }
            , Tui.Separator
            , Item { title = "Dro~p~", cmd = "calc.drop", key = "", shortcut = "p" }
            , Item { title = "~S~wap", cmd = "calc.swap", key = "", shortcut = "s" }
            , Item { title = "D~u~plicate", cmd = "calc.dup", key = "", shortcut = "u" }
            , Item { title = "C~l~ear stack", cmd = "calc.clear", key = "", shortcut = "z" }
            , Tui.Separator
            -- `y` copies the top, which is the answer you just worked out and
            -- is what the key is for. Any *other* level needs somewhere to say
            -- which, and this is it -- with the value written beside the
            -- number, so the menu is the thing that shows what is about to be
            -- copied rather than a mode on the canvas with a cursor in it that
            -- has to be moved, drawn, and put back whenever the stack changes.
            , SubMenu
                { title = "Cop~y~"
                , key = ""
                , items = copyItems model
                }
            , Item { title = "Paste number", cmd = "calc.paste", key = "", shortcut = "v" }
            ]
        }


{-| One entry per level that has something on it, deepest last so that the top
of the stack -- the level `y` copies -- is nearest the bottom of the box, as it
is nearest the entry line on the canvas.

A level holding nothing is left out rather than greyed: the point of the list
is to show what would be copied, and there is no answer to write beside an
empty one. An empty stack therefore leaves only **All of it**, which says the
stack is empty when it is chosen -- and nothing here carries an empty command,
which is a thing to keep true rather than an accident. See FINDINGS.
-}
copyItems : Model -> Array MenuItem
copyItems model =
    let
        depth =
            Array.length model.stack
    in
    (Array.range 1 depth
        |> Array.map
            (\level ->
                Item
                    { title =
                        String.fromInt level
                            ++ ":  "
                            ++ (when Array.get (depth - level) model.stack is
                                    Just value ->
                                        plainly model value

                                    Nothing ->
                                        ""
                               )
                    , cmd = "calc.copy." ++ String.fromInt level
                    , key = ""
                    , shortcut =
                        if level == 1 then
                            "y"

                        else
                            ""
                    }
            )
        |> Array.reverse
    )
        ++ [ Tui.Separator
           , Item { title = "~A~ll of it", cmd = "calc.copy.all", key = "", shortcut = "" }
           ]


{-| A menu has no radio buttons, so the current choice is marked in its
caption. `\u{25CF}` is what Turbo Vision's own checked items use.
-}
tick : Bool -> String
tick on =
    if on then
        "● "

    else
        "  "


view : Inks -> Model -> Tui.Window
view inks model =
    { id = windowId
    , title = "RPN Calculator"
    -- Down and to the right of the chart's, so that opening both leaves each
    -- window's title bar reachable. Where a window *starts* is the only say
    -- the model has about its position: after that it is the user's, and
    -- Turbo Vision's.
    , rect = { x1 = 20, y1 = 3, x2 = 58, y2 = 22 }
    -- Its size is not the user's, though. A keypad, a stack and two lines of
    -- text are what this window holds, all of them a fixed size, and a bigger
    -- window would be the same keypad with a gap beside it.
    , resize = Tui.fixedSize
    , palette = Tui.BlueWindow
    , canClose = True
    , canMove = True
    , views =
        [ Canvas
            { id = canvasId
            , rect = { x1 = 2, y1 = 1, x2 = 2 + canvasWidth, y2 = 9 }
            , lines = display inks model
            , cursor = Just { x = 2 + String.count model.entry, y = rows + 1 }
            , takesFocus = True
            }
        , keypadButton "add" "~+~" 2 10
        , keypadButton "sub" "~-~" 10 10
        , keypadButton "mul" "~*~" 18 10
        , keypadButton "div" "~/~" 26 10
        , keypadButton "and" "~&~" 2 12
        , keypadButton "or" "~|~" 10 12
        , keypadButton "xor" "~^~" 18 12
        , keypadButton "not" "Not" 26 12
        , keypadButton "enter" "Ent" 2 14
        , keypadButton "drop" "Drop" 10 14
        , keypadButton "swap" "Swap" 18 14
        , keypadButton "dup" "Dup" 26 14
        ]
    }


{-| `takesFocus = False` is the whole reason a keypad and a keyboard can share
one window: a button that could hold the caret would eat the next digit typed
at it. `TCalculator` clears `ofSelectable` on all twenty of its keys for
exactly this reason and does not say so anywhere.
-}
keypadButton : String -> String -> Int -> Int -> View
keypadButton name title x y =
    Tui.Button
        { id = "calc.key." ++ name
        , rect = { x1 = x, y1 = y, x2 = x + 7, y2 = y + 2 }
        , title = title
        , cmd = "calc." ++ name
        , isDefault = False
        , takesFocus = False
        }


display : Inks -> Model -> Array (Array Span)
display inks model =
    stackLines inks model
        ++ [ entryLine inks model, modeLine inks model, messageLine inks model ]


{-| The stack, deepest first, so the top of it sits nearest what is being
typed. Levels that hold nothing are still drawn: a calculator whose display
changes height as it fills is a calculator you cannot read at a glance.
-}
stackLines : Inks -> Model -> Array (Array Span)
stackLines inks model =
    let
        depth =
            Array.length model.stack
    in
    Array.range 0 (rows - 1)
        |> Array.map
            (\row ->
                let
                    level =
                        rows - row

                    label =
                        Tui.ink inks.ruler (String.padLeft 2 ' ' (String.fromInt level) ++ ": ")

                    index =
                        depth - level
                in
                -- The guard is the whole of it: `Array.get` counts from the
                -- end when the index is negative, so an empty level would
                -- otherwise show the top of the stack again.
                if index < 0 then
                    [ label ]

                else
                    when Array.get index model.stack is
                        Just value ->
                            [ label, Tui.plain (show model value) ]

                        Nothing ->
                            [ label ]
            )


entryLine : Inks -> Model -> Array Span
entryLine inks model =
    [ Tui.ink inks.ruler "> ", Tui.plain model.entry ]


{-| The two modes, labelled.

They were an unlabelled `dec exact` at the right-hand end of the entry line,
and the first person to look at the calculator asked what they were -- fairly,
since the only thing that explained them was a hint that `update` wiped on the
next keystroke. A word that has to be remembered from a message that is gone is
not a label.
-}
modeLine : Inks -> Model -> Array Span
modeLine inks model =
    [ Tui.ink inks.ruler "base "
    , Tui.plain (String.padRight 8 ' ' (baseName model.base))
    , Tui.ink inks.ruler "width "
    , Tui.plain (widthName model.width)
    ]


{-| Whatever went wrong, or -- when nothing has -- how to change the two modes
above. The hint is *standing* rather than shown once: it costs a line that has
nothing else to do, and it is the answer to the question the mode line raises.
-}
messageLine : Inks -> Model -> Array Span
messageLine inks model =
    if String.isEmpty model.message then
        -- Thirty-four columns is the canvas, and this spends all of them.
        -- It was `Tab changes base, w changes width` at thirty-three; the two
        -- clipboard keys are worth the word "changes" twice over, because a
        -- key nothing mentions is a key nobody presses.
        [ Tui.ink inks.dim "Tab base, w width, y copy, v paste" ]

    else
        -- The ellipsis is the point. A canvas cuts a line off at its width
        -- without a mark, so an overlong message arrives looking like a
        -- finished sentence -- `Copied 130 -- the terminal did not` was one,
        -- and it said the opposite of what it meant. Every message here is
        -- written to fit `canvasWidth`; this is what makes a future one that
        -- does not fit look wrong instead of look fine.
        [ Tui.ink inks.alert
            (if String.count model.message > canvasWidth then
                String.takeFirst (canvasWidth - 1) model.message ++ "…"

             else
                model.message
            )
        ]

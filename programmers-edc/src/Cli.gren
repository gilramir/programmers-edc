module Cli exposing (Command(..), parser)

{-| predc's command line.

The program is a desktop with tools on it, and the command line says which tool
you came for. That is the whole of it: there is no batch mode, no flag that
changes what a tool does, and nothing here that cannot be reached from the
Tools menu a second later. `predc hex dump.bin` exists because a person who
already knows which file they want should not have to walk a file dialog to it.

Parsing is a pure function -- `Argparse.Parser.run` takes the tokens and hands
back a result -- so this module holds no `Task`, prints nothing, and is the
same value whether it is being run or being read. `Main` decides what to do
with each answer, which is where the interesting half is: a `--help` must print
and exit *without* Turbo Vision ever taking the terminal, and that is a
decision only `init` can make. See `Tui.defineProgramOrExit`.

-}

import Argparse.Parser as Parser
import Argparse.PrettyPrinter as PP
import FileSystem.Path exposing (Path)


{-| Which tool to open on the way in.

There is no constructor for "no tool": an empty command line never reaches the
parser, because `Argparse.Parser.run` answers an empty argument list with the
help text and that is not what `predc` on its own means. `Main` checks for it
first.
-}
type Command
    = Ascii
    | Calc
    | Calendar
    | Encode
    | Env
    -- `Nothing` is `predc notes`, which opens the window on whichever note
    -- comes first; a name opens that one, and says so if there is no such
    -- note rather than inventing it. Making a note is `Ctrl-N` in the window,
    -- because a command line that creates files as a side effect of a typo is
    -- not what anybody means by opening a notes app.
    | Notes (Maybe String)
    | Random
    | Time
    | Unicode
    -- `Nothing` is `predc hex`, which opens the viewer with no file in it --
    -- the same window the Tools menu opens, and a Ctrl-O away from a file.
    | Hex (Maybe Path)


parser : Parser.App Command
parser =
    { name = "predc"
    , version = "0.1.0"
    , intro =
        PP.verticalBlock
            [ PP.words
                "The programmer's every-day carry: small tools, one terminal window."
            , PP.empty
            , PP.words
                ("With no command predc opens the desktop with nothing on it, and every "
                    ++ "tool is on the Tools menu. A command opens that tool's window on "
                    ++ "the way in; the program is the same either way, and the other "
                    ++ "tools are still one menu away."
                )
            ]
    -- Two words this parser never sees, documented by the only thing that
    -- can document them. `--record` belongs to `bin/predc.js` and is spliced
    -- out of the argument list before Gren is handed it, because a parser
    -- that answers an unknown word with an exit cannot also be the place a
    -- launcher's flag is declared. That is a fine trade until somebody has
    -- to be *told* the flag exists, which is exactly when they need it: they
    -- have hit something, and the help text is where they will look.
    , outro =
        PP.verticalBlock
            [ PP.words "Reporting a bug:"
            , PP.empty
            , PP.words
                ("predc --record FILE COMMAND writes every event the program saw "
                    ++ "into FILE, so a bug that is easier to hit than to describe can "
                    ++ "be sent rather than explained. That file has everything you "
                    ++ "typed in it. Look at it before you send it."
                )
            , PP.empty
            , PP.words
                ("Clipboard and editor contents are left out. --record-verbatim FILE "
                    ++ "keeps those too, and is only worth using if you were asked for it."
                )
            ]
    , commands =
        Parser.defineGroup
            |> Parser.withCommand
                { word = "ascii"
                , arguments = Parser.noArgs
                , flags = Parser.noFlags
                , commonDescription = Just "Open the ASCII chart."
                , summary = "The `ascii` command opens the ASCII chart:"
                , example = PP.words "predc ascii"
                , builder = \_args _flags -> Ascii
                }
            |> Parser.withCommand
                { word = "calc"
                , arguments = Parser.noArgs
                , flags = Parser.noFlags
                , commonDescription = Just "Open the RPN calculator."
                , summary = "The `calc` command opens the RPN calculator:"
                , example = PP.words "predc calc"
                , builder = \_args _flags -> Calc
                }
            -- `cal` rather than `calendar`, which is what `cal(1)` has
            -- trained everybody to type. It is one letter from `calc` and both
            -- are real commands, so a slip opens the wrong tool -- which costs
            -- a glance and a retype, since neither does anything but appear.
            -- Worth the short word.
            |> Parser.withCommand
                { word = "cal"
                , arguments = Parser.noArgs
                , flags = Parser.noFlags
                , commonDescription = Just "Open the calendar."
                , summary = "The `cal` command opens the calendar, on this month:"
                , example = PP.words "predc cal"
                , builder = \_args _flags -> Calendar
                }
            |> Parser.withCommand
                { word = "encode"
                , arguments = Parser.noArgs
                , flags = Parser.noFlags
                , commonDescription = Just "Open the encoder and decoder."
                , summary = "The `encode` command opens the encoder, with nothing in it and nothing chosen for you:"
                , example = PP.words "predc encode"
                , builder = \_args _flags -> Encode
                }
            |> Parser.withCommand
                { word = "env"
                , arguments = Parser.noArgs
                , flags = Parser.noFlags
                , commonDescription = Just "Open the environment variable list."
                , summary = "The `env` command opens the environment variables predc's own process has:"
                , example = PP.words "predc env"
                , builder = \_args _flags -> Env
                }
            |> Parser.withCommand
                { word = "notes"
                , arguments =
                    Parser.optionalArg
                        { value = Parser.stringParser
                        , help = "The note to open, if you already know which one"
                        }
                , flags = Parser.noFlags
                , commonDescription = Just "Open the notes."
                , summary = "The `notes` command opens the notes window, on a note if you name one:"
                , example =
                    PP.verticalBlock
                        [ PP.words "predc notes"
                        , PP.words "predc notes \"Release checklist\""
                        ]
                , builder = \name _flags -> Notes name
                }
            |> Parser.withCommand
                { word = "random"
                , arguments = Parser.noArgs
                , flags = Parser.noFlags
                , commonDescription = Just "Open the random values tool."
                , summary = "The `random` command opens the random values tool, with five UUIDs already made:"
                , example = PP.words "predc random"
                , builder = \_args _flags -> Random
                }
            |> Parser.withCommand
                { word = "time"
                , arguments = Parser.noArgs
                , flags = Parser.noFlags
                , commonDescription = Just "Open the time zone converter."
                , summary = "The `time` command opens the time zone converter, at the current moment:"
                , example = PP.words "predc time"
                , builder = \_args _flags -> Time
                }
            |> Parser.withCommand
                { word = "unicode"
                , arguments = Parser.noArgs
                , flags = Parser.noFlags
                , commonDescription = Just "Open the Unicode decoder."
                , summary = "The `unicode` command opens the Unicode decoder, with nothing in it:"
                , example = PP.words "predc unicode"
                , builder = \_args _flags -> Unicode
                }
            |> Parser.withCommand
                { word = "hex"
                , arguments =
                    Parser.optionalArg
                        { value = Parser.pathParser
                        , help = "The file to open, if you already know which one"
                        }
                , flags = Parser.noFlags
                , commonDescription = Just "Open the hex dump viewer."
                , summary = "The `hex` command opens the hex dump viewer, on a file if you name one:"
                , example =
                    PP.verticalBlock
                        [ PP.words "predc hex"
                        , PP.words "predc hex /bin/ls"
                        ]
                , builder = \path _flags -> Hex path
                }
    }

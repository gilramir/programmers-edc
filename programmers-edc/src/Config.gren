module Config exposing (Config, default, load, save, where_)

{-| What predc remembers between runs, which was one field and is now two.

Five decisions, and the first two are about what *not* to do.

**Nothing here reports an error.** A missing config file is the normal case on
a first run; an unreadable one is a directory somebody made read-only; a
corrupt one is a half-written file from a machine that lost power. All three
have the same right answer -- start in the defaults -- and none of them is
worth a dialog in front of a program somebody opened to look at a hex dump.
`load` therefore returns a `Task Never Config` and every failure funnels into
[`default`](#default).

**The write is fire-and-forget too**, and for the same reason turned around: a
theme that failed to save is a theme that comes back next time, which the user
will notice and can act on. A modal box saying so is the worse outcome.

**It is read during `init`, not after it.** `Node.getEnvironmentVariables` and
`FileSystem.readFile` are both `Task`s and `Init.awaitTask` takes a
`Task Never a`, so the whole load happens before the first frame is drawn.
Doing it afterwards works and costs a visible flash: the program would open in
Borland and repaint into the saved theme a moment later, once, every time.

**Every field decodes on its own, and a missing one is its default rather than
a failed parse.** That is what [`optional`](#) below is for, and the reason is
the upgrade: a file written by the version before this one has a `theme` and
no `timezones`, and reading it must keep the theme. A decoder built out of
required fields would have thrown the whole file away and put the user back in
Borland for having used an older predc yesterday.

**And the file is TOML, so that it can be commented -- which is what makes the
fifth decision necessary.** A format with comments in it is a format somebody
opens in an editor, and a program that writes such a file by serialising its
own model deletes every word the user wrote the moment the theme changes. So
nothing here serialises. `save` re-reads the file and edits the document it
parsed: see [`save`](#save).

-}

import Bytes exposing (Bytes)
import Chart
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Task exposing (Task)
import Theme
import Toml
import Toml.Decode as Decode
import Toml.Edit as Edit
import Week


type alias Config =
    { theme : Theme.Name
    -- The time zones the converter shows, in the order it shows them.
    --
    -- `Maybe` rather than a bare array, and the distinction is the whole point
    -- of the field: `Nothing` is *never configured*, which renders as the
    -- machine's own zone, and `Just []` is *configured to nothing*, which
    -- renders as UTC and POSIX alone. Without the distinction, emptying the
    -- list would put the local zone straight back the next time predc started
    -- and there would be no way to say what the user plainly said.
    , timezones : Maybe (Array String)
    -- Which week numbering the calendar uses, which also decides the day a
    -- week starts on -- one setting, because a week number means nothing
    -- without the other half. Not a `Maybe`: unlike the zone list, "never
    -- configured" and "ISO" are the same calendar, so there is nothing for the
    -- absence to mean.
    , weeks : Week.Rule
    -- Which of the ASCII chart's two forms it opens in. A mode rather than a
    -- taste -- the grid and the list answer different questions -- and it is
    -- remembered for the same reason the theme is: predc is a program people
    -- leave open and close with the window, and a mode that survived only a
    -- tidy exit is a mode that gets lost.
    , chart : Chart.Mode
    }


default : Config
default =
    { theme = Theme.Borland
    , timezones = Nothing
    , weeks = Week.Iso
    , chart = Chart.Grid
    }


{-| `$XDG_CONFIG_HOME/predc/config.toml`, or `~/.config/predc/config.toml`
when that is not set, which is what the XDG base directory specification says
to do and what everything else on a Linux machine already does.

`Nothing` when neither variable is set -- a program run by something with no
environment at all -- and the caller treats that as "no config", which is the
same as not having one.
-}
where_ : Dict String String -> Maybe Path
where_ env =
    let
        base =
            when Dict.get "XDG_CONFIG_HOME" env is
                Just dir ->
                    if String.isEmpty dir then
                        Maybe.map (\home -> home ++ "/.config") (Dict.get "HOME" env)

                    else
                        Just dir

                Nothing ->
                    Maybe.map (\home -> home ++ "/.config") (Dict.get "HOME" env)
    in
    Maybe.map (\dir -> Path.fromPosixString (dir ++ "/predc/config.toml")) base


load : FileSystem.Permission -> Maybe Path -> Task Never Config
load permission path =
    when path is
        Nothing ->
            Task.succeed default

        Just it ->
            FileSystem.readFile permission it
                |> Task.map parse
                |> Task.onError (\_ -> Task.succeed default)


{-| `Toml.Decode.fromBytes` and not `Toml.parseBytes` followed by
`fromDocument`, because reading is all this does: the document the parse built
is thrown away here, and `save` reads it again from the file rather than being
handed a copy that went stale while predc was open. Bytes rather than a
`String` because two of the things that make a TOML file invalid -- a bad
UTF-8 sequence, and whether there was a byte order mark -- are decided before
there is a `String` to look at.
-}
parse : Bytes -> Config
parse bytes =
    Decode.fromBytes decoder bytes
        |> Result.withDefault default


{-| `andMap` and not `map3`, which is what a fourth field costs: the numbered
`mapN`s stop at three here and the pipeline does not stop at all.
-}
decoder : Decode.Decoder Config
decoder =
    Decode.succeed
        (\theme timezones weeks chart ->
            { theme = theme, timezones = timezones, weeks = weeks, chart = chart }
        )
        |> Decode.andMap (optional "theme" (Decode.map Theme.fromKey Decode.string) default.theme)
        |> Decode.andMap (Decode.maybe (Decode.field "timezones" (Decode.array Decode.string)))
        |> Decode.andMap (optional "weeks" (Decode.map Week.fromKey Decode.string) default.weeks)
        |> Decode.andMap (optional "chart" (Decode.map Chart.fromKey Decode.string) default.chart)


{-| A field that may not be there, and is its default when it is not.

`Decode.maybe` wrapped around the field rather than around the value, which is
the distinction `optionalField`'s own doc comment warns about: this succeeds
with the default both when the key is absent and when what is under it is the
wrong shape, and those are the same thing to a program that never reports a
config error.

`timezones` does not go through this, because for that field "absent" and "an
empty array" are different answers and `Maybe` is the value rather than the
handling of a mistake.
-}
optional : String -> Decode.Decoder a -> a -> Decode.Decoder a
optional key decoder_ fallback =
    Decode.maybe (Decode.field key decoder_)
        |> Decode.map (Maybe.withDefault fallback)


{-| Read the file, change what has moved, write it back.

**The read is the point of the whole module.** The file is TOML because TOML
carries comments, and a file with comments in it is one somebody edits by hand
-- so it is read at the moment of writing rather than at start-up. Anything
the user changed with an editor while predc was open survives, which it would
not if the document parsed during `init` were kept in the model and written
out over the top hours later.

Four outcomes, and only two of them write:

  - **No file, or one that cannot be read.** `Toml.empty` is the document with
    nothing in it and every key is missing from it, so creating the file is
    `apply` run against that -- the same code, rather than a second path with a
    second copy of the file's shape in it to drift.
  - **A file that parses.** Change what has moved and write it back. Every
    other byte -- the comments, the blank lines, the alignment, a key some
    later predc will understand -- comes back out as it went in.
  - **A file that does not parse.** Leave it alone entirely. It is a file
    somebody is in the middle of editing, and a typo in it is worth less than
    the rest of the file is; `load` has already fallen back to the defaults,
    so predc runs either way. The setting comes back next time, which is the
    same fire-and-forget the write has always been.
  - **No path at all.** Nothing to write to.

`makeDirectory` with `recursive = True` so that a first run creates
`~/.config/predc` as well as the file in it, and so that an existing directory
is not an error.

-}
save : FileSystem.Permission -> Maybe Path -> Config -> Task Never {}
save permission path config =
    when path is
        Nothing ->
            Task.succeed {}

        Just it ->
            FileSystem.readFile permission it
                |> Task.map (\bytes -> Toml.parseBytes bytes |> Result.toMaybe)
                -- A file that is not there is a file to create. A file that is
                -- there and does not parse is the one case above that answers
                -- `Just Nothing`, and writes nothing.
                |> Task.onError (\_ -> Task.succeed (Just Toml.empty))
                |> Task.andThen
                    (\parsed ->
                        when parsed is
                            Nothing ->
                                Task.succeed {}

                            Just document ->
                                write permission it (apply config document)
                    )


write : FileSystem.Permission -> Path -> Toml.Document -> Task Never {}
write permission path document =
    FileSystem.makeDirectory permission { recursive = True } (Path.parentPath path |> Maybe.withDefault path)
        |> Task.andThen (\_ -> FileSystem.writeFile permission (Toml.toBytes document) path)
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


{-| The config as changes to a document, which may be a document with nothing
in it.

`Toml.Edit.introduce` rather than `set`, because a key predc invents should
arrive with a sentence saying what it is for -- and should arrive with it
*once*. `introduce` writes the comments only for a key that was not already in
the document, so a user who deleted the explanation, or rewrote it in Korean,
does not have predc correcting them on the next theme change.

A `Nothing` for `timezones` removes the key rather than writing a `null`, for
the same reason it wrote no key at all in the JSON this replaced: absent is
what "never configured" means to the decoder above, and a second spelling of
one thing is a second thing to keep in step. TOML makes the argument on its own
as well -- it has no null. Removing takes the explanation with it and putting
the key back brings it again, which is what makes writing it once coherent
rather than a way to lose it for good.

Nothing here asks whether a value is changing, and that is a property of
`Toml.Edit.set` rather than an oversight: setting a value the file already has
leaves the line exactly as it is written. It matters most for the key predc is
*not* changing. Setting a value replaces the whitespace inside it, so somebody
who spread their zones over four lines with a note against each would otherwise
find them flattened onto one by a save about the theme.

-}
apply : Config -> Toml.Document -> Toml.Document
apply config document =
    document
        |> Edit.introduce
            [ "theme" ]
            { blankBefore = True
            , leading = [ " Which colour scheme predc opens in: borland, midnight, or gren." ]
            , trailing = Nothing
            }
            (Edit.string (Theme.toKey config.theme))
        |> (when config.timezones is
                Just zones ->
                    Edit.introduce [ "timezones" ]
                        { blankBefore = True
                        , leading =
                            [ " The time zones the time converter shows, in the order it"
                            , " shows them. Delete the key to go back to this machine's own"
                            , " zone; an empty list shows UTC and POSIX alone."
                            ]
                        , trailing = Nothing
                        }
                        (Edit.array (Array.map Edit.string zones))

                Nothing ->
                    Edit.remove [ "timezones" ]
           )
        -- Written only when it is not the default, which is `timezones`'s rule
        -- rather than `theme`'s and is the right one here. predc's bargain with
        -- a hand-written file is that it changes the one thing it was asked to
        -- change -- `drive_theme.py` asserts that byte for byte -- and adding a
        -- key somebody never asked about, because they picked a colour scheme,
        -- is not that. Choosing US writes it, with the sentence that says what
        -- it is; choosing ISO back takes both away again, and the file is as it
        -- was.
        |> (when config.weeks is
                Week.Iso ->
                    Edit.remove [ "weeks" ]

                other ->
                    Edit.introduce [ "weeks" ]
                        { blankBefore = True
                        , leading =
                            [ " How the calendar numbers weeks, and therefore which day a"
                            , " week starts on: iso (Monday, the week holding 4 January)"
                            , " or us (Sunday, the week holding 1 January). Absent is iso."
                            ]
                        , trailing = Nothing
                        }
                        (Edit.string (Week.toKey other))
           )
        -- **Introduced or set, never removed**, which is not the rule the two
        -- keys above follow and is the right one for a key you can toggle with
        -- a keystroke.
        --
        -- `introduce` with `blankBefore = True` adds a blank line above the
        -- block and `remove` does not take it away again, so the pair is not a
        -- round trip: every list-then-grid cycle leaves one more empty line in
        -- somebody's config file. `weeks` has the same hole and gets away with
        -- it because it is changed from a menu once in a blue moon; `chart` is
        -- `Tab`, and a file that grew a blank line every time somebody
        -- compared the two charts would be predc doing exactly what this
        -- module exists to promise it does not. The bug is `gren-toml`'s and
        -- is written up there; when it is fixed this can become the same
        -- `remove` the others use.
        --
        -- So: choosing the list writes the key with its explanation, and
        -- choosing the grid back writes `grid` into the key that is already
        -- there. `member` is what keeps the promise -- a file that has never
        -- had a `chart` key does not get one for a chart nobody switched --
        -- and a file that has one has it because somebody pressed the key, so
        -- it is not a setting they never asked about.
        |> (\document_ ->
                when config.chart is
                    Chart.Grid ->
                        if Edit.member [ "chart" ] document_ then
                            Edit.set [ "chart" ] (Edit.string (Chart.toKey Chart.Grid)) document_

                        else
                            document_

                    other ->
                        Edit.introduce [ "chart" ]
                            { blankBefore = True
                            , leading =
                                [ " Which form the ASCII chart opens in: grid (sixteen by"
                                , " eight, the concise table) or list (one code per line,"
                                , " with names, the way man ascii prints it)."
                                ]
                            , trailing = Nothing
                            }
                            (Edit.string (Chart.toKey other))
                            document_
           )

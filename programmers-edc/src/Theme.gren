module Theme exposing (Inks, Name(..), all, fromKey, highlightNames, hint, inks, next, palette, title, toKey)

{-| predc's color schemes, and the two halves every one of them has.

A theme here is two things that are not the same thing, and the split is forced
rather than chosen. `Tui.Theme` is the *application palette*: every color on
the screen that gren-tvision draws -- frames, titles, the menu bar, the status
line, buttons, dialogs, scroll bars. `Inks` is what the tools' own canvases
paint with, and a theme cannot reach those: a `Tui.Span` names a `Tui.Hue` and
there is nothing between it and the terminal, deliberately, which is the
argument `gren-tvision/examples/palette` makes at length.

So the model holds a `Name` and the two functions below turn it into the two
halves. Which is the same principle one level up from where the package makes
it: **the color is a model decision**, made by the thing that decides what to
draw.

There is a seam in it worth knowing about. A palette can be 24-bit and an ink
cannot -- `Tui.Tint` has `Rgb`, `Tui.Hue` has sixteen names -- so a theme with
a hand-picked ground has canvases painted in whatever the terminal calls
`LightCyan`, and the two have to be chosen to sit together. That is the reason
`Inks` is a record per theme rather than one set shared by all three: the hues
that read on Borland's blue are the hues that disappear on a light ground.

-}

import Math
import Tui exposing (Hue(..), Span)


{-| Which scheme. Stored in the config file as the strings [`toKey`](#toKey)
writes, so renaming one of these renames what is on disk.
-}
type Name
    = Borland
    | Midnight
    | Gren


{-| In the order they appear on the menu, which is also the order
[`next`](#next) cycles them in.
-}
all : Array Name
all =
    [ Borland, Midnight, Gren ]


title : Name -> String
title name =
    when name is
        Borland ->
            "Borland"

        Midnight ->
            "Midnight"

        Gren ->
            "Gren"


next : Name -> Name
next name =
    when name is
        Borland ->
            Midnight

        Midnight ->
            Gren

        Gren ->
            Borland


-- WHAT THE TOOLS PAINT WITH


{-| The things every canvas in this program needs to say, named for what they
mean rather than for what color they are -- which is the entire point, since
what color they are is what a theme changes.

  - `ruler` -- a column header, an offset, a label on a value: the scaffolding
    around the data, and quieter than it.
  - `dim` -- a placeholder for something that is not there, and the words of a
    standing hint. Quieter still.
  - `key` -- the name of a key *inside* one of those hints, which is louder
    than the words around it rather than quieter: see [`hint`](#hint).
  - `alert` -- something went wrong and the line under the window says so.
  - `field` -- a run of cells the user *types into*, painted as a surface of
    its own so that it reads as a box rather than as one more line of text.
    Both halves are given, because a field is a change of *ground*: the theme
    already says as much about the palette's `input`, where the comment is
    that a field sits below the window and a button above it.
  - `selected` -- the byte, cell or row the caret is on, painted rather than
    merely pointed at, because whether a terminal shows its cursor at all is
    the terminal's business.
  - `marking` -- a range the user is dragging out and has not committed to.
    One color, and it has to differ from `selected` *and* from all six below,
    because all three can be on screen at once: the pending range, the cursor
    inside it, and the highlights it is being dragged across.
  - `highlights` -- the six a hex dump range can be painted, in the order the
    number keys pick them and [`highlightNames`](#highlightNames) names them.

The last two are the hex viewer's, and they are here rather than in it for the
reason the other four are: a color a *ground* has to be chosen against belongs
beside the ground. Six is a count, not a limit found by trying: it is how many
backgrounds a sixteen-color terminal has that a person can still tell apart
in a glance at a grid, once the ground, the selection and the marker are spoken
for.

-}
type alias Inks =
    { ruler : Hue
    , dim : Hue
    , key : Hue
    , alert : Hue
    , field : { fg : Hue, bg : Hue }
    , selected : { fg : Hue, bg : Hue }
    , marking : { fg : Hue, bg : Hue }
    , highlights : Array { fg : Hue, bg : Hue }
    }


{-| A standing hint, with the keys in it picked out.

Every tool window in predc has a line along its foot saying which keys do what,
and until now every one of them was a single run of `dim` -- which is to say it
looked exactly like a sentence somebody had written, rather than like a row of
keys. The status line at the bottom of the screen has never had that problem,
because `TStatusLine` draws the key and its label in two different colors, and
that is the whole of the difference: **`Alt-X` in one color and `Exit` in
another reads as an instruction, and one color reads as prose.**

So the hints are marked the way the status line's own entries are, with `~`
around the parts that are keys:

    Theme.hint inks "~Tab~ base, ~w~ width, ~y~ copy, ~v~ paste"

The convention is Turbo Vision's rather than a new one -- it is what a menu
title and a status-line entry already use for a hot key in this program, and
`Help.barVariants` writes its rungs that way. The tildes never reach the
screen, so a hint reads the same width it always did and every pty driver that
greps for one of these sentences goes on finding it.

There is no escape for a literal `~`, and none is needed: it is not a character
that appears in a key name or in the kind of clause these lines are made of.
A hint containing one would come out with the tilde gone and the colors
alternating from there, which is visible immediately and in the one place
somebody is already looking.
-}
hint : Inks -> String -> Array Span
hint scheme text =
    String.split "~" text
        |> Array.indexedMap
            (\index run ->
                if Math.modBy 2 index == 0 then
                    Tui.ink scheme.dim run

                else
                    Tui.ink scheme.key run
            )
        -- An empty run between two marks, or at either end, would be a span
        -- with no text -- which the differ would faithfully send and the
        -- binding would faithfully draw as nothing. Dropping them keeps a
        -- hint's span count equal to the number of things it actually says.
        |> Array.keepIf (\span -> not (String.isEmpty span.text))


{-| What the six are *called*, which is the same in every scheme because the
name is the meaning and the hue is the theme's answer to it. A menu entry and a
number key both read this, so a theme that picked a green for slot one would be
caught by the label rather than by the eye.
-}
highlightNames : Array String
highlightNames =
    [ "Red", "Green", "Yellow", "Magenta", "Cyan", "Gray" ]


inks : Name -> Inks
inks name =
    when name is
        Borland ->
            -- On Turbo Vision's blue, where the body text is already yellow.
            -- `Blue` and `DarkGray` are the two that vanish here, and they are
            -- exactly what the first version of these used.
            { ruler = LightCyan
            , dim = Cyan
            -- The only hue on this ground brighter than everything else on it
            -- and not already spoken for. `LightRed` is what Turbo Vision's
            -- own status line uses for a key, and it is `alert` here -- one
            -- color cannot mean both "press this" and "this went wrong".
            , key = White
            , alert = LightRed
            -- Recessed, which on this ground is easy: every terminal's black
            -- is darker than its blue, so the field is a hole in the window
            -- rather than a stripe across it.
            , field = { fg = White, bg = Black }
            , selected = { fg = Blue, bg = LightGray }
            -- A lighter blue than the window, so a range being dragged out
            -- reads as part of the same surface until it is committed to a
            -- color that does not.
            , marking = { fg = Black, bg = LightBlue }
            , highlights = darkGrounds
            }

        Midnight ->
            -- On a near-black ground. `Cyan` rather than `DarkGray` for the
            -- placeholders: bright black on a dark ground is the one pair the
            -- sixteen colors cannot make legible.
            { ruler = LightCyan
            , dim = Cyan
            , key = White
            , alert = LightRed
            -- The one theme where the field is *lifted* instead. Recessed is
            -- the principle, but at sixteen colors "darker than near-black"
            -- is a promise the terminal has to keep and this one cannot check,
            -- and a field nobody can see is worse than a field on the wrong
            -- side of the surface.
            , field = { fg = White, bg = DarkGray }
            , selected = { fg = Black, bg = LightGray }
            -- `Blue` is free here in a way it is not on Borland's blue, and it
            -- is the one dark ground that reads as a marker rather than as one
            -- more color in the set.
            , marking = { fg = White, bg = Blue }
            , highlights = darkGrounds
            }

        Gren ->
            -- And on a light one, where the whole set inverts: the dark hues
            -- are the readable ones and the bright ones are the ones that
            -- disappear.
            { ruler = Blue
            , dim = DarkGray
            -- The nearest of the sixteen to this scheme's own `barAccent`,
            -- `0xB85C00`, which is the color the status line already draws a
            -- key in. 5.3:1 on paper, and the one warm hue here that is not
            -- the alert.
            , key = Brown
            , alert = Red
            -- Paper's own answer, and the oldest one: a gray well with black
            -- in it.
            , field = { fg = Black, bg = LightGray }
            , selected = { fg = White, bg = Blue }
            -- Blue is the selection here, so the marker is the other thing a
            -- light ground has always used for this: a highlighter pen.
            , marking = { fg = Black, bg = Yellow }
            , highlights = darkGrounds
            }


{-| The same six in all three schemes, which is not a shortcut. Every one of
them is a *dark* ground with light text on it, and that is the one description
that holds on all three of this program's grounds at once -- Turbo Vision's
blue, near-black, and paper. The bright halves of the sixteen are the ones that
change meaning with the ground: `Yellow` is a highlighter on paper and a glare
on near-black, and `LightGray` is already the selection twice over.

`Cyan` takes black text rather than white. It is the lightest of the six, and
the only one where the eye picks the darker of the two.
-}
darkGrounds : Array { fg : Hue, bg : Hue }
darkGrounds =
    [ { fg = White, bg = Red }
    , { fg = White, bg = Green }
    , { fg = White, bg = Brown }
    , { fg = White, bg = Magenta }
    , { fg = Black, bg = Cyan }
    , { fg = White, bg = DarkGray }
    ]


-- WHAT THE PACKAGE PAINTS WITH


palette : Name -> Tui.Theme
palette name =
    when name is
        Borland ->
            Tui.borland

        Midnight ->
            midnight

        Gren ->
            gren


{-| The orange from gren-lang.org -- its logo, and the highlights on the
package index. One constant, so that correcting it is one edit and not
seventeen.
-}
orange : Tui.Tint
orange =
    Tui.Rgb 0xE8801A


{-| Near-black, and `Rgb` throughout for a reason: a dark scheme built out of
"whatever this terminal calls black" is at the mercy of a terminal whose black
is not dark. `Black` and `DarkGray` is the only dark pair the sixteen colors
offer, and it is at once too far apart to read as one surface and too close to
be a border.

The window ground is lifted off the desktop rather than equal to it, which is
the whole trick: the frame is then a change of color rather than a line drawn
around nothing.
-}
midnight : Tui.Theme
midnight =
    { desktop = { fg = Tui.Rgb 0x2A2A33, bg = Tui.Rgb 0x121218 }
    , bar = { fg = Tui.Rgb 0xC8C8D2, bg = Tui.Rgb 0x24242E }
    , barAccent = orange
    , barDisabled = Tui.Rgb 0x62626E
    , barSelected = { fg = Tui.Rgb 0x121218, bg = Tui.Rgb 0x8AA9C8 }
    , barSelectedAccent = Tui.Rgb 0x3A1A00
    , window = midnightPanel (Tui.Rgb 0x1E1E26)
    , alternate = midnightPanel (Tui.Rgb 0x1A2430)
    , dialog = midnightPanel (Tui.Rgb 0x282833)
    }


midnightPanel : Tui.Tint -> Tui.ThemePanel
midnightPanel ground =
    { frame = { fg = Tui.Rgb 0x5A5A6A, bg = ground }
    , frameActive = Tui.Rgb 0xE8E8F0
    , text = { fg = Tui.Rgb 0xC8C8D2, bg = ground }
    , accent = orange
    , selected = { fg = Tui.Rgb 0x121218, bg = Tui.Rgb 0x8AA9C8 }
    , disabled = Tui.Rgb 0x62626E
    , button = { fg = Tui.Rgb 0xF4F4FA, bg = Tui.Rgb 0x3F3F50 }
    , buttonAccent = orange
    -- Recessed rather than raised: a field sits *below* the window's ground
    -- and a button sits above it, which is the whole of why Turbo Vision keeps
    -- two colors here and this theme keeps two grounds.
    , input = { fg = Tui.Rgb 0xE8E8F0, bg = Tui.Rgb 0x14141A }
    , inputAccent = orange
    , scrollBar = { fg = Tui.Rgb 0x4A4A58, bg = Tui.Rgb 0x24242E }
    }


{-| Paper, slate and the orange -- gren-lang.org's own three. A light scheme,
and the one that makes the point that these are not three variations on
Borland's.

It is also the one that proves `Inks` had to exist. Every hue the other two
paint with is a bright one, and every bright hue is invisible here.

**Every color below was checked as a contrast ratio against the ground it
lands on**, and that is not fussiness -- it is the only way to get a light
scheme right, because on a light ground the mistakes are quiet. A dark scheme
that goes wrong is illegible and you fix it; a light one that goes wrong is
*nearly* legible, and it stays that way. The first version of this had white
text on the orange at 2.8:1 in two places that mattered -- the focused Name
field of the file dialog, and the selected row of its list -- and it read as a
slightly odd color rather than as a bug.

So the orange appears in three places and each one is a different orange,
chosen for what it sits on:

  - `frameActive`, the border and title of the window in front, is
    [`deepOrange`](#gren) at 5.3:1 on paper. The border is decoration and could
    be brighter; the title is text and cannot.
  - the accents -- hot keys, in the body text and on the menu bar -- are
    `0xB85C00` at 4.3:1.
  - the buttons are the *bright* [`orange`](#orange) with near-black on it, at
    6.3:1 -- the keypad, and the OK and Cancel of every dialog. This is the one
    place the logo color appears at full strength, and it can now be used in a
    dialog as well as in a window because `button` and `input` are separate
    fields: before they were one, an orange button meant an orange text field,
    which is why the Name box of the file dialog was the thing that looked
    wrong.

And the selection is not orange at all, in either direction. White on slate is
12.3:1 and reads at a glance, which is what a selection is for. Neither is the
input line: paper with a hairline of warm gray under it, at 10.5:1, which is a
text field that looks like a text field.
-}
gren : Tui.Theme
gren =
    { desktop = { fg = Tui.Rgb 0xC4BFB6, bg = Tui.Rgb 0xE4DFD6 }
    , bar = { fg = Tui.Rgb 0x2A2622, bg = Tui.Rgb 0xF4F1EA }
    , barAccent = Tui.Rgb 0xB85C00
    , barDisabled = Tui.Rgb 0x9A948A
    , barSelected = grenSelected
    , barSelectedAccent = Tui.Rgb 0xFFC46B
    , window = grenPanel (Tui.Rgb 0xFAF8F3)
    , alternate = grenPanel (Tui.Rgb 0xF0EEE6)
    , dialog = grenPanel (Tui.Rgb 0xF4F1EA)
    }


{-| Deep enough that a window title drawn in it reads on paper -- 5.3:1, where
the logo orange is 2.6:1 and looks like a mistake somebody made on purpose.
-}
deepOrange : Tui.Tint
deepOrange =
    Tui.Rgb 0xA35200


{-| White on slate, and deliberately not on the orange: 12.3:1 against the
2.8:1 that white on orange gives. This is the focused input line, the selected
row of a list and the highlighted entry on the menu bar, which is to say every
place a person is looking for something.
-}
grenSelected : Tui.Pair
grenSelected =
    { fg = Tui.Rgb 0xFFFFFF, bg = Tui.Rgb 0x3A342E }


grenPanel : Tui.Tint -> Tui.ThemePanel
grenPanel ground =
    { frame = { fg = Tui.Rgb 0x8A857C, bg = ground }
    , frameActive = deepOrange
    , text = { fg = Tui.Rgb 0x2A2622, bg = ground }
    , accent = Tui.Rgb 0xB85C00
    , selected = grenSelected
    , disabled = Tui.Rgb 0x9A948A
    -- Near-black on the logo orange, at 6.3:1. White on it is 2.8:1 and looks
    -- like a mistake somebody made on purpose, which is what the first pass
    -- did. The hot key is a dark red-brown: readable on the orange and
    -- unmistakably not the letter beside it.
    , button = { fg = Tui.Rgb 0x2A1400, bg = orange }
    , buttonAccent = Tui.Rgb 0x5C0A00
    , input = { fg = Tui.Rgb 0x2A2622, bg = Tui.Rgb 0xDCD7CC }
    , inputAccent = Tui.Rgb 0xB85C00
    , scrollBar = { fg = Tui.Rgb 0xB0AAA0, bg = Tui.Rgb 0xEAE6DD }
    }


-- ON DISK


{-| The name this scheme is written down as, which is a `String` and not a
`Json.Encode.Value` or a `Toml.Edit.Value`. The config file has been both, and
which one it is has never been a fact about a color scheme -- so the encoding
lives with the file and this hands over the one thing only `Theme` knows.
-}
toKey : Name -> String
toKey name =
    when name is
        Borland ->
            "borland"

        Midnight ->
            "midnight"

        Gren ->
            "gren"


{-| A name this version does not know is not an error worth showing anybody: a
config file written by a later predc should start, in the scheme predc started
in before there was a config file at all. Which is why this is total rather
than a `Maybe` -- there is no caller who would do anything else with the
`Nothing`.
-}
fromKey : String -> Name
fromKey text =
    when text is
        "midnight" ->
            Midnight

        "gren" ->
            Gren

        _ ->
            Borland

port module Main exposing (main)

{-| **predc** -- the programmer's every-day carry.

A pocket knife: several small tools that a programmer wants two or three times
a week and never wants to go looking for. Each one is an ordinary window on the
desktop, so two of them can be on screen at once -- which is the case the thing
exists for. You convert a timestamp *while* reading the hex dump that contains
it.

This file is the shell: the menu bar, the status line, the About box, and
nothing else. The tools live in `Tool/`, each a small self-contained
model-update-view that hands back a `Tui.Window`, and this module owns only
which of them are open.

Window *management* is deliberately not here. Zoom, resize, tile, cascade and
close are Turbo Vision's own commands and never reach the model; a window's
rectangle in `view` is where it starts, not where it is. `examples/demo` in
gren-tvision makes the same point at length and it is the reason this shell is
as short as it is.

-}

import Array exposing (Array)
import Init
import Json.Decode as Decode
import Json.Encode as Encode
import Node
import Tool.Ascii
import Tool.Calc
import Tui exposing (Event(..), MenuItem(..), View(..))


-- PORTS


port tuiOut : Encode.Value -> Cmd msg


port tuiIn : (Decode.Value -> msg) -> Sub msg


tui : Tui.Ports Msg
tui =
    { toJs = tuiOut, fromJs = tuiIn }


-- MODEL


type alias Model =
    { -- The About box centres itself, and a rectangle is in desktop
      -- coordinates, so the shell has to know how big the desktop is. It is
      -- also the only thing here that needs the `Resized` event.
      desktop : { cols : Int, rows : Int }
    -- One field per tool, `Nothing` when its window is not open. A field
    -- rather than a list because the tools do not share a model type and
    -- should not be made to: what they share is the shape of the three
    -- functions the shell calls.
    , ascii : Maybe Tool.Ascii.Model
    , calc : Maybe Tool.Calc.Model
    }


type Msg
    = FromTui Event


init : Node.Environment -> Init.Task { model : Model, command : Cmd Msg }
init _ =
    Node.startProgram
        { model =
            { desktop = { cols = 80, rows = 23 }
            , ascii = Nothing
            , calc = Nothing
            }
        , command = Cmd.none
        }


-- UPDATE


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        FromTui event ->
            handleEvent event model


handleEvent : Event -> Model -> { model : Model, command : Cmd Msg }
handleEvent event model =
    when event is
        Resized size ->
            { model = { model | desktop = size }, command = Cmd.none }

        Command "about" ->
            { model = model, command = Tui.dialog tui (aboutDialog model) }

        -- Opening a tool that is already open raises its window instead of
        -- doing nothing, which is what the user meant by asking for it twice.
        -- `Tui.focus` is the only way to say it: which windows exist is the
        -- model's, and which one is in front is not.
        Command cmd ->
            if cmd == Tool.Ascii.command then
                when model.ascii is
                    Nothing ->
                        { model = { model | ascii = Just Tool.Ascii.init }
                        , command = Cmd.none
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Ascii.windowId
                        }

            else if cmd == Tool.Calc.command then
                when model.calc is
                    Nothing ->
                        { model = { model | calc = Just Tool.Calc.init }
                        , command = Cmd.none
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Calc.windowId
                        }

            else
                -- Every other command belongs to a tool: its menu's, or one of
                -- its buttons'. The shell does not know which, and does not
                -- need to.
                toTools event model

        -- A window the user closed from its frame has to leave the model, or
        -- the next render puts it straight back -- and here that takes the
        -- tool's state with it, which is `Maybe` read literally: a closed tool
        -- is a tool you are done with, and reopening it starts fresh. A tool
        -- holding something the user *made* rather than merely where they were
        -- looking can keep its model behind a flag of its own instead.
        WindowClosed id ->
            if id == Tool.Ascii.windowId then
                { model = { model | ascii = Nothing }, command = Cmd.none }

            else if id == Tool.Calc.windowId then
                { model = { model | calc = Nothing }, command = Cmd.none }

            else
                { model = model, command = Cmd.none }

        _ ->
            toTools event model


{-| Every open tool is handed the event and answers for its own view ids; a
closed one is not consulted, which is what `Maybe.map` says here. Nothing is
routed by window, because an event names the *view* it came from and that is
the finer-grained fact.
-}
toTools : Event -> Model -> { model : Model, command : Cmd Msg }
toTools event model =
    { model =
        { model
            | ascii = Maybe.map (Tool.Ascii.update event) model.ascii
            , calc = Maybe.map (Tool.Calc.update event) model.calc
        }
    , command = Cmd.none
    }


-- SUBSCRIPTIONS


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- VIEW


view : Model -> Tui.Ui
view model =
    { menuBar = menuBar model
    , statusLine =
        [ { text = "~Alt-X~ Exit", key = "Alt-X", cmd = "quit" }
        , { text = "~Alt-A~ ASCII", key = "Alt-A", cmd = Tool.Ascii.command }
        , { text = "~Alt-R~ RPN", key = "Alt-R", cmd = Tool.Calc.command }
        , { text = "~F5~ Zoom", key = "F5", cmd = "zoom" }
        , { text = "~F6~ Next", key = "F6", cmd = "next" }
        , { text = "~Alt-F3~ Close", key = "Alt-F3", cmd = "close" }
        ]
    , windows =
        (when model.ascii is
            Just ascii ->
                [ Tool.Ascii.view ascii ]

            Nothing ->
                []
        )
            ++ (when model.calc is
                    Just calc ->
                        [ Tool.Calc.view calc ]

                    Nothing ->
                        []
               )
    , overlays = []
    }


{-| The bar, with each open tool's own menu spliced in between Tools and
Window.

A tool's menu is present because the tool is *open*, not because it is the one
in front, and that is forced rather than chosen: nothing tells the model which
window is active. There is no event for it -- `Focused` is a list box's
highlight moving, and window order belongs to Turbo Vision. So a menu that
followed the focus is not expressible, and the honest alternative is a bar that
grows by one menu per open tool.
-}
menuBar : Model -> Array MenuItem
menuBar model =
    [ SubMenu
        { title = "~F~ile"
        , key = ""
        , items = [ Item { title = "E~x~it", cmd = "quit", key = "Alt-X", shortcut = "Alt-X" } ]
        }
    , SubMenu
        { title = "~T~ools"
        , key = ""
        , items = [ Tool.Ascii.menuItem, Tool.Calc.menuItem ]
        }
    ]
        ++ toolMenus model
        ++ -- Every one of these is Turbo Vision's own: they move windows
           -- around and say nothing to the model, which is why `view` can
           -- render the same rectangle forever without dragging a window back
           -- to where it began.
           [ SubMenu
                { title = "~W~indow"
                , key = ""
                , items =
                    [ Item { title = "~R~esize/move", cmd = "resize", key = "Ctrl-F5", shortcut = "Ctrl-F5" }
                    , Item { title = "~Z~oom", cmd = "zoom", key = "F5", shortcut = "F5" }
                    , Item { title = "~N~ext", cmd = "next", key = "F6", shortcut = "F6" }
                    , Item { title = "~C~lose", cmd = "close", key = "Alt-F3", shortcut = "Alt-F3" }
                    , Item { title = "~T~ile", cmd = "tile", key = "", shortcut = "" }
                    , Item { title = "C~a~scade", cmd = "cascade", key = "", shortcut = "" }
                    ]
                }
           , SubMenu
                { title = "~H~elp"
                , key = ""
                , items = [ Item { title = "~A~bout...", cmd = "about", key = "", shortcut = "" } ]
                }
           ]


toolMenus : Model -> Array MenuItem
toolMenus model =
    when model.calc is
        Just calc ->
            [ Tool.Calc.menu calc ]

        Nothing ->
            []


aboutDialog : Model -> Tui.DialogSpec
aboutDialog model =
    Tui.messageBox
        { id = "about"
        , title = "About"
        , text = "\n\u{0003}predc\n \n\u{0003}the programmer's every-day carry\n \n\u{0003}small tools, one terminal window\n"
        , buttons = Tui.okButtons
        , desktop = model.desktop
        }


-- PROGRAM


main : Tui.Program Model Msg
main =
    Tui.defineProgram tui
        { init = init
        , update = update
        , subscriptions = subscriptions
        , view = view
        , onEvent = FromTui
        }

port module Main exposing (main)

{-| **predc** -- the programmer's every-day carry.

A pocket knife: several small tools that a programmer wants two or three times
a week and never wants to go looking for. Each one is an ordinary window on the
desktop, so two of them can be on screen at once -- which is the case the thing
exists for. You convert a timestamp *while* reading the hex dump that contains
it.

This file is the shell: the menu bar, the status line, the About box, and
nothing else. The tools live in `Tool/`, each a small self-contained
model-update-view that hands back a `Tui.Window`, and this module owns only
which of them are open.

Window *management* is deliberately not here. Zoom, resize, tile, cascade and
close are Turbo Vision's own commands and never reach the model; a window's
rectangle in `view` is where it starts, not where it is. `examples/demo` in
gren-tvision makes the same point at length and it is the reason this shell is
as short as it is.

-}

import Argparse.Parser as Parser
import Argparse.PrettyPrinter as PP
import Array exposing (Array)
import Bytes exposing (Bytes)
import Chart
import Cli
import Config
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Help
import Init
import Json.Decode as Decode
import Json.Encode as Encode
import Node
import Stream
import Stream.Log
import Task exposing (Task)
import Terminal
import Theme
import Time
import Tool.Ascii
import Tool.Calc
import Tool.Calendar
import Tool.Encode
import Tool.Env
import Tool.Hex
import Tool.Notes
import Tool.Random
import Tool.Time
import Tool.Unicode
import Tui exposing (Event(..), MenuItem(..), View(..))
import Week


-- PORTS


port tuiOut : Encode.Value -> Cmd msg


port tuiIn : (Decode.Value -> msg) -> Sub msg


tui : Tui.Ports Msg
tui =
    { toJs = tuiOut, fromJs = tuiIn }


{-| The same two port functions, at the hex viewer's message type.

A port is polymorphic in its message -- `port tuiOut : Encode.Value -> Cmd msg`
-- and the annotation is what pins one down. So a tool that opens a dialog of
its own needs a record at *its* type, and that is the entire cost of a tool
having messages the shell knows nothing about. It is four lines, and it is here
rather than in `Tool/Hex.gren` because ports may only be declared in a `port
module` and there is exactly one of those.
-}
hexPorts : Tui.Ports Tool.Hex.Msg
hexPorts =
    { toJs = tuiOut, fromJs = tuiIn }


{-| The calendar's, for the same reason the hex viewer has one: it opens a
dialog, and a dialog is a command whose answer comes back as an event.
-}
calendarPorts : Tui.Ports Tool.Calendar.Msg
calendarPorts =
    { toJs = tuiOut, fromJs = tuiIn }


{-| The notes tool's, which needs one for both of those reasons at once: it
opens dialogs, and it reads and writes files.
-}
notesPorts : Tui.Ports Tool.Notes.Msg
notesPorts =
    { toJs = tuiOut, fromJs = tuiIn }


{-| The random tool's, which it needs for exactly one thing that is not its
own randomness: putting what it made on the clipboard.
-}
randomPorts : Tui.Ports Tool.Random.Msg
randomPorts =
    { toJs = tuiOut, fromJs = tuiIn }


{-| predc's *other* port pair, and the only one that is not Turbo Vision's.

`bin/predc.js` subscribes to it, because `run()` in gren-tvision-runtime hands
the app back precisely so that a program with ports of its own can: the runtime
claims `tuiOut` and `tuiIn` and nothing else. What is on the far end is
`bin/timezones.js` and the IANA time zone database compiled into node, which is
the one thing predc needs that Gren cannot supply -- see `Tool.Time`.
-}
port intlOut : Encode.Value -> Cmd msg


port intlIn : (Decode.Value -> msg) -> Sub msg


{-| The converter is the one tool that needs both pairs, and `Tool.Time.Wiring`
says why: it talks to `bin/timezones.js` about zones and to Turbo Vision about
which of its two windows should have the focus. The two record types are
identical, so the field names are the only thing keeping them apart.
-}
timeWiring : Tool.Time.Wiring
timeWiring =
    { intl = { toJs = intlOut, fromJs = intlIn }
    , tui = { toJs = tuiOut, fromJs = tuiIn }
    }


-- MODEL


type alias Model =
    { -- The About box centres itself, and a rectangle is in desktop
      -- coordinates, so the shell has to know how big the desktop is. It is
      -- also the only thing here that needs the `Resized` event.
      desktop : { cols : Int, rows : Int }
    -- Held so that a tool which reads files can be handed it when it opens.
    -- `FileSystem.initialize` is an `Init.Task` and therefore the program's
    -- first act; nothing later can ask for one.
    , permission : FileSystem.Permission
    -- What the process was started with. Held for the same reason and with the
    -- same consequence: `Node.getEnvironmentVariables` is an `Init.Task`, so
    -- this is a snapshot from before the first frame -- which is why
    -- `Tool.Env` has no Refresh and does not need one.
    , environment : Dict String String
    -- The same environment as bytes, when this machine has a `/proc` to read
    -- it from. `Nothing` on anything that does not, and `Tool.Env` does
    -- without the byte view rather than pretending: see the note in `init`.
    , environ : Maybe Bytes
    -- One field per tool, `Nothing` when its window is not open. A field
    -- rather than a list because the tools do not share a model type and
    -- should not be made to: what they share is the shape of the three
    -- functions the shell calls.
    , ascii : Maybe Tool.Ascii.Model
    , calc : Maybe Tool.Calc.Model
    , calendar : Maybe Tool.Calendar.Model
    , encode : Maybe Tool.Encode.Model
    , env : Maybe Tool.Env.Model
    , random : Maybe Tool.Random.Model
    , hex : Maybe Tool.Hex.Model
    , notes : Maybe Tool.Notes.Model
    , time : Maybe Tool.Time.Model
    , unicode : Maybe Tool.Unicode.Model
    -- The help window, which is a window like a tool's and is not one: it is
    -- on the Help menu rather than the Tools menu, and what it explains is the
    -- program rather than being a thing the program does.
    , help : Maybe Help.Model
    -- What the environment said at start-up, which the help window needs and
    -- nothing else does. Held here because `Node.getEnvironmentVariables` is
    -- an `Init.Task` -- the same reason the file system permission is.
    , session : Help.Session
    -- Which colour scheme, and where to write it down. The theme is a shell
    -- concern in the same way the menu bar is: it belongs to the program
    -- rather than to any tool, and every tool has to be told.
    , theme : Theme.Name
    -- Which week numbering the calendar shows, which is a setting rather than
    -- the calendar's own state: it is remembered when the window is not open,
    -- and it is on the Options menu with the colour scheme.
    , weeks : Week.Rule
    -- Which form the ASCII chart opens in. Held here rather than in the tool
    -- for the same reason the converter's zone list is: it has to outlive a
    -- window that was closed, and it is the shell that read the config file.
    , chart : Chart.Mode
    -- The other half of the config file, held here for the same reason the
    -- theme is: it belongs to the program rather than to a tool, and it has to
    -- outlive a tool that is closed and reopened.
    --
    -- `Maybe` because "never configured" and "configured to nothing" are
    -- different answers -- see `Config`.
    , timezones : Maybe (Array String)
    -- Which zone this machine is in, from `Time.getZoneName`, and the default
    -- the converter starts in when the config file has never been written.
    -- `Nothing` only where there is no `Intl` to ask, which is not node.
    , here : Maybe String
    , configPath : Maybe Path
    }


type Msg
    = FromTui Event
    -- A tool with tasks of its own has messages of its own, and they come
    -- back through the shell because `update` is the shell's. This is the
    -- first tool that needed either.
    | FromCalendar Tool.Calendar.Msg
    | FromHex Tool.Hex.Msg
    | FromNotes Tool.Notes.Msg
    | FromRandom Tool.Random.Msg
    | FromTime Tool.Time.Msg
    -- The config file was written, or was not. Either way there is nothing to
    -- do about it -- see `Config` for why -- and this exists only because a
    -- `Task` has to be turned into a `Cmd Msg` by something.
    | Saved


{-| `/proc/self/environ`, or `Nothing` where there is none.

`readFile` and not `readFileStream`: procfs answers `stat` with a size of zero
and then hands over thirteen kilobytes, so anything that sizes a read first
reads nothing at all. That is also why the hex viewer cannot simply be pointed
at this path -- it is size-driven by design.

The failure is recovered rather than reported. There is nothing a person could
do about a machine with no `/proc`, and the tool has a complete answer for it.
-}
environBlock : FileSystem.Permission -> Task Never (Maybe Bytes)
environBlock permission =
    FileSystem.readFile permission (Path.fromPosixString "/proc/self/environ")
        |> Task.map Just
        |> Task.onError (\_ -> Task.succeed Nothing)


{-| Five awaits, and the order is the only thing about them worth saying: the
file system permission is an `Init.Task` and therefore has to be first, and it
has to be first for a second reason now -- reading the environment block is a
file read and cannot happen before there is a permission to do one.
`Terminal.initialize` answers whether anything is watching (it reads
`process.stdout` and touches nothing, so it is safe to ask before Turbo Vision
has the terminal), the environment says where the config file is, and the
config file says which theme to start in.

All of it before `startProgram`, which is what `Init.awaitTask` is for -- it
takes the ordinary `Task Never a` that `getEnvironmentVariables` and
`Config.load` are. Loading afterwards would work and would cost a visible
flash: the first frame in Borland, repainted into the saved theme once, every
single run.

And this is where the command line is read, because it is the last moment at
which the answer can be "there is no program to run". `Tui.Exit` is what says
so: nothing is rendered, Turbo Vision is never started, and a `--help` on its
way into a pager stays a `--help`. Everything below is one `when` over what
`Argparse.Parser.run` made of the words.
-}
init : Node.Environment -> Init.Task { model : Tui.Startup Model, command : Cmd Msg }
init env =
    Init.await FileSystem.initialize <| \permission ->
    Init.await Terminal.initialize <| \terminal ->
    Init.awaitTask Node.getEnvironmentVariables <| \vars ->
        let
            path =
                Config.where_ vars
        in
        Init.awaitTask (Config.load permission path) <| \config ->
        -- The environment again, and this time as bytes.
        --
        -- `Node.getEnvironmentVariables` is `process.env`, which Node has
        -- already decoded as UTF-8: a value that is not valid UTF-8 arrives as
        -- one `U+FFFD` per byte and the bytes are gone. A `LANG` of
        -- `ko_KR.euc-kr` with EUC-KR bytes in a value is a real thing to have,
        -- and `Tool.Env` was showing replacement characters with nothing to
        -- say so -- and could not have sent them to the hex viewer, because by
        -- then the only bytes left were the ones the damage is encoded in.
        --
        -- `/proc/self/environ` is the block `execve` handed this process. It
        -- is Linux only, and it is read here rather than by the tool because
        -- an `Init.Task` is the one place a tool can be handed something it
        -- cannot go and fetch. `Task.onError` rather than a check: the
        -- question is not whether the platform has `/proc` but whether this
        -- read worked, and a `Nothing` is a complete answer to it -- the tool
        -- falls back to `vars` and does without the byte view.
        --
        -- It cannot be `Tool.Hex`'s own path either: procfs reports size zero
        -- from `stat`, and the viewer is size-driven, so `predc hex
        -- /proc/self/environ` opens an empty dump. The obvious workaround is
        -- the one that does not work.
        Init.awaitTask (environBlock permission) <| \environ ->
        -- Which zone this machine is in, and it costs no port: `Time.here` is
        -- the useless one -- its own doc comment says it can never answer
        -- `America/New_York` and will hand back `Etc/GMT-5` instead -- but
        -- `getZoneName` reads `Intl.DateTimeFormat().resolvedOptions()` and
        -- gives the IANA name. `Offset` is what a runtime with no `Intl` at
        -- all answers, which is not node, and predc treats it as not knowing.
        Init.awaitTask Time.getZoneName <| \zoneName ->
            let
                shell =
                    { -- What the terminal actually is, rather than the
                      -- eighty-by-twenty-five everything assumes until
                      -- `Resized` arrives. `Terminal.initialize` has already
                      -- been awaited two lines up -- it reads
                      -- `process.stdout` and touches nothing, so it is safe to
                      -- ask before Turbo Vision has the terminal -- and it
                      -- knows, so there is no reason to guess and then correct.
                      --
                      -- It matters because a window sized from the desktop is
                      -- sized in `init`, before the first `Resized` can
                      -- possibly have been delivered: `predc env` on a
                      -- fifty-row terminal opened a window for a
                      -- twenty-three-row one and left half the screen empty.
                      -- Two rows off the terminal's own count, for the menu
                      -- bar and the status line.
                      desktop =
                        when terminal is
                            Just tty ->
                                { cols = tty.columns, rows = max 1 (tty.rows - 2) }

                            Nothing ->
                                { cols = 80, rows = 23 }
                    , permission = permission
                    , environment = vars
                    , environ = environ
                    , ascii = Nothing
                    , calc = Nothing
                    , calendar = Nothing
                    , encode = Nothing
                    , env = Nothing
                    , random = Nothing
                    , hex = Nothing
                    , notes = Nothing
                    , time = Nothing
                    , unicode = Nothing
                    , help = Nothing
                    , session = Help.detect vars
                    , theme = config.theme
                    , timezones = config.timezones
                    , weeks = config.weeks
                    , chart = config.chart
                    , here =
                        when zoneName is
                            Time.Name name ->
                                Just name

                            Time.Offset _ ->
                                Nothing
                    , configPath = path
                    }

                -- node, the script, then the words the user typed.
                args =
                    Array.dropFirst 2 env.args
            in
            if Array.isEmpty args then
                -- `predc` on its own is the desktop, and never the help text
                -- that an empty argument list means to `Argparse.Parser.run`.
                -- The tools are on the menu; that is what the menu is for.
                Node.startProgram
                    { model = Tui.Start shell, command = Cmd.none }

            else
                when Parser.run args Cli.parser is
                    Parser.Success command ->
                        open command shell

                    Parser.HelpText doc ->
                        printing (say terminal vars env.stdout doc) 0

                    Parser.UnknownCommand word ->
                        printing (say terminal vars env.stderr (unknown word)) 1

                    Parser.BadFlags problem ->
                        printing
                            (say terminal vars env.stderr (Parser.flagErrorPrettified problem))
                            1

                    Parser.BadArguments problem ->
                        printing
                            (say terminal vars env.stderr (Parser.argumentErrorPrettified problem))
                            1


{-| The tool the command line asked for, open on the desktop the moment the
first frame is drawn.

Every one of these is the model the Tools menu would have produced, which is
the point: a command line is a shortcut through the menu and not a second way
into the program. The hex viewer with a path is the only one that starts a
task, and it is the tool's own `openFile` rather than anything assembled here
-- `Main` does not know what a file has to become before the viewer can show
it, and should not learn.
-}
open : Cli.Command -> Model -> Init.Task { model : Tui.Startup Model, command : Cmd Msg }
open command shell =
    when command is
        Cli.Ascii ->
            Node.startProgram
                { model = Tui.Start { shell | ascii = Just (Tool.Ascii.init shell.chart shell.desktop) }
                , command = Cmd.none
                }

        Cli.Calc ->
            Node.startProgram
                { model = Tui.Start { shell | calc = Just Tool.Calc.init }
                , command = Cmd.none
                }

        Cli.Calendar ->
            let
                step =
                    Tool.Calendar.init
            in
            Node.startProgram
                { model = Tui.Start { shell | calendar = Just step.model }
                , command = Cmd.map FromCalendar step.command
                }

        Cli.Env ->
            Node.startProgram
                { model = Tui.Start { shell | env = Just (Tool.Env.init shell.environ shell.environment shell.desktop) }
                , command = Cmd.none
                }

        Cli.Encode ->
            Node.startProgram
                { model = Tui.Start { shell | encode = Just Tool.Encode.init }
                , command = Cmd.none
                }

        -- The one command that starts a task, other than the hex viewer with
        -- a path: the window is not worth opening empty, so the first draw is
        -- already on its way before the first frame is.
        Cli.Notes name ->
            let
                step =
                    Tool.Notes.init shell.permission
                        (Tool.Notes.where_ shell.environment)
                        name
                        shell.desktop
            in
            Node.startProgram
                { model = Tui.Start { shell | notes = Just step.model }
                , command = Cmd.map FromNotes step.command
                }

        Cli.Random ->
            let
                step =
                    Tool.Random.init
            in
            Node.startProgram
                { model = Tui.Start { shell | random = Just step.model }
                , command = Cmd.map FromRandom step.command
                }

        Cli.Time ->
            let
                step =
                    Tool.Time.init shell.timezones shell.here
            in
            Node.startProgram
                { model = Tui.Start { shell | time = Just step.model }
                , command = Cmd.map FromTime step.command
                }

        Cli.Unicode ->
            Node.startProgram
                { model = Tui.Start { shell | unicode = Just Tool.Unicode.init }
                , command = Cmd.none
                }

        Cli.Hex Nothing ->
            Node.startProgram
                { model = Tui.Start { shell | hex = Just (Tool.Hex.init shell.permission shell.desktop) }
                , command = Cmd.none
                }

        Cli.Hex (Just file) ->
            let
                step =
                    Tool.Hex.openFile shell.permission shell.desktop file
            in
            Node.startProgram
                { model = Tui.Start { shell | hex = Just step.model }
                , command = Cmd.map FromHex step.command
                }


{-| The command line was the whole of it: print, set the exit code, and stop.

`Node.setExitCode` and not `Node.exitWithCode`, which does not wait for the
write to land -- and a help text is exactly the thing somebody pipes into a
pager. There is nothing to wait for it here: with `Tui.Exit` the program has no
subscriptions and no window, so node runs out of work as soon as the line is
written and leaves with the code.
-}
printing : Task.Task Never {} -> Int -> Init.Task { model : Tui.Startup Model, command : Cmd Msg }
printing write code =
    Node.startProgram
        { model = Tui.Exit
        , command =
            write
                |> Task.andThen (\_ -> Node.setExitCode code)
                |> Task.execute
        }


{-| Colour if somebody is looking, and not if the output is a pipe or if
NO_COLOR is set (<https://no-color.org>). This is `Argparse.Program`'s own rule,
copied rather than called: predc cannot use that runner, because the runner
ends in a process that exits and predc's ends in one that paints.
-}
say : Maybe Terminal.Configuration -> Dict String String -> Stream.Writable Bytes -> PP.Document -> Task.Task Never {}
say terminal vars stream doc =
    let
        colourful =
            terminal /= Nothing && not (Dict.member "NO_COLOR" vars)

        -- A paragraph is a sequence of words until something says where the
        -- line ends, and the honest answer to that is the terminal it is
        -- being printed into. Eighty when there is no terminal, which is the
        -- width every pipe has been assumed to have since the VT100.
        width =
            when terminal is
                Just config ->
                    config.columns

                Nothing ->
                    80
    in
    Stream.Log.line stream
        (PP.toStringWithOptions
            { PP.defaultOptions | maxColumns = width }
            (if colourful then
                doc

             else
                PP.stripColor doc
            )
        )


unknown : String -> PP.Document
unknown word =
    PP.verticalBlock
        [ PP.words ("There is no predc command called `" ++ word ++ "`.")
        , PP.empty
        , PP.words "Try `predc --help` for the ones there are."
        ]


-- UPDATE


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        FromTui event ->
            handleEvent event model

        Saved ->
            { model = model, command = Cmd.none }

        FromCalendar sub ->
            { model = { model | calendar = Maybe.map (Tool.Calendar.answered sub) model.calendar }
            , command = Cmd.none
            }

        FromRandom sub ->
            { model = { model | random = Maybe.map (Tool.Random.answered sub) model.random }
            , command = Cmd.none
            }

        FromTime sub ->
            when model.time is
                Just time ->
                    let
                        step =
                            Tool.Time.receive timeWiring sub time
                    in
                    { model = { model | time = Just step.model }
                    , command = Cmd.map FromTime step.command
                    }

                Nothing ->
                    { model = model, command = Cmd.none }

        FromNotes sub ->
            when model.notes is
                Just notes ->
                    let
                        step =
                            Tool.Notes.receive notesPorts sub notes
                    in
                    { model = { model | notes = Just step.model }
                    , command = Cmd.map FromNotes step.command
                    }

                Nothing ->
                    { model = model, command = Cmd.none }

        FromHex sub ->
            when model.hex is
                Just hex ->
                    let
                        step =
                            Tool.Hex.receive hexPorts sub hex
                    in
                    { model = { model | hex = Just step.model }
                    , command = Cmd.map FromHex step.command
                    }

                Nothing ->
                    { model = model, command = Cmd.none }


handleEvent : Event -> Model -> { model : Model, command : Cmd Msg }
handleEvent event model =
    when event is
        -- The shell's own copy first, and then **on to the tools**, which is
        -- the branch that used to stop here.
        --
        -- Three of them keep a desktop of their own and centre dialogs on it:
        -- `Tool.Hex` and `Help` have a `Tui.Resized` branch each and neither
        -- was ever reached, so both sat on the 80x23 they were seeded with. On
        -- a 120-column terminal the hex viewer's **Go to offset** and **Type
        -- bytes** opened nine columns from the left edge, centred for a
        -- desktop that was not there. Nothing reported it: a dialog in the
        -- wrong place is a dialog, and the seed is a plausible size.
        Resized size ->
            toTools event { model | desktop = size }

        Command "about" ->
            { model = model, command = Tui.dialog tui (aboutDialog model) }

        -- One command per scheme rather than a cycling one, so that the menu
        -- can say which is which and a person can go straight to the one they
        -- want. Saving on every change and not on exit: predc is a program
        -- people leave open and close with Alt-X or with the window, and a
        -- setting that survives only a tidy exit is a setting that gets lost.
        Command "theme.borland" ->
            chooseTheme Theme.Borland model

        Command "theme.midnight" ->
            chooseTheme Theme.Midnight model

        Command "theme.gren" ->
            chooseTheme Theme.Gren model

        Command "weeks.iso" ->
            chooseWeeks Week.Iso model

        Command "weeks.us" ->
            chooseWeeks Week.Us model

        Command "chart.grid" ->
            chooseChart Chart.Grid model

        Command "chart.list" ->
            chooseChart Chart.List model

        -- Opening a tool that is already open raises its window instead of
        -- doing nothing, which is what the user meant by asking for it twice.
        -- `Tui.focus` is the only way to say it: which windows exist is the
        -- model's, and which one is in front is not.
        Command cmd ->
            if cmd == Tool.Ascii.command then
                when model.ascii is
                    Nothing ->
                        { model = { model | ascii = Just (Tool.Ascii.init model.chart model.desktop) }
                        , command = Cmd.none
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Ascii.windowId
                        }

            else if cmd == Tool.Calc.command then
                when model.calc is
                    Nothing ->
                        { model = { model | calc = Just Tool.Calc.init }
                        , command = Cmd.none
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Calc.windowId
                        }

            else if cmd == Tool.Calendar.command then
                when model.calendar is
                    Nothing ->
                        let
                            step =
                                Tool.Calendar.init
                        in
                        { model = { model | calendar = Just step.model }
                        , command = Cmd.map FromCalendar step.command
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Calendar.windowId
                        }

            else if cmd == Tool.Encode.command then
                when model.encode is
                    Nothing ->
                        { model = { model | encode = Just Tool.Encode.init }
                        , command = Cmd.none
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Encode.windowId
                        }

            else if cmd == Tool.Env.command then
                when model.env is
                    Nothing ->
                        { model = { model | env = Just (Tool.Env.init model.environ model.environment model.desktop) }
                        , command = Cmd.none
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Env.windowId
                        }

            else if cmd == Tool.Random.command then
                when model.random is
                    Nothing ->
                        let
                            step =
                                Tool.Random.init
                        in
                        { model = { model | random = Just step.model }
                        , command = Cmd.map FromRandom step.command
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Random.windowId
                        }

            else if cmd == Tool.Hex.command then
                when model.hex is
                    Nothing ->
                        { model = { model | hex = Just (Tool.Hex.init model.permission model.desktop) }
                        , command = Cmd.none
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Hex.windowId
                        }

            else if cmd == Tool.Notes.command then
                when model.notes is
                    Nothing ->
                        openNotes Nothing model

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Notes.windowId
                        }

            else if cmd == Tool.Time.command then
                when model.time is
                    Nothing ->
                        openTime model

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Time.windowId
                        }

            else if cmd == Tool.Unicode.command then
                when model.unicode is
                    Nothing ->
                        { model = { model | unicode = Just Tool.Unicode.init }
                        , command = Cmd.none
                        }

                    Just _ ->
                        { model = model
                        , command = Tui.focus tui Tool.Unicode.windowId
                        }

            else if
                -- The one window that has something to do when it is *re*-opened
                -- as well as when it is opened: it measures whether this terminal
                -- will hand a clipboard back, and that can change under a running
                -- program. So a second F1 on an open window asks again rather than
                -- only bringing it to the front.
                cmd == Help.command
            then
                let
                    step =
                        Help.opened tui model.desktop model.session
                in
                { model = { model | help = Just step.model }
                , command =
                    Cmd.batch
                        [ step.command
                        , when model.help is
                            Just _ ->
                                Tui.focus tui Help.windowId

                            Nothing ->
                                Cmd.none
                        ]
                }

            else
                -- Every other command belongs to a tool: its menu's, or one of
                -- its buttons'. The shell does not know which, and does not
                -- need to.
                toTools event model

        -- A window the user closed from its frame has to leave the model, or
        -- the next render puts it straight back -- and here that takes the
        -- tool's state with it, which is `Maybe` read literally: a closed tool
        -- is a tool you are done with, and reopening it starts fresh. A tool
        -- holding something the user *made* rather than merely where they were
        -- looking can keep its model behind a flag of its own instead.
        WindowClosed id ->
            if id == Tool.Ascii.windowId then
                { model = { model | ascii = Nothing }, command = Cmd.none }

            else if id == Tool.Calc.windowId then
                { model = { model | calc = Nothing }, command = Cmd.none }

            else if id == Tool.Calendar.windowId then
                { model = { model | calendar = Nothing }, command = Cmd.none }

            else if id == Tool.Encode.windowId then
                { model = { model | encode = Nothing }, command = Cmd.none }

            else if id == Tool.Env.windowId then
                { model = { model | env = Nothing }, command = Cmd.none }

            else if id == Tool.Random.windowId then
                { model = { model | random = Nothing }, command = Cmd.none }

            else if id == Tool.Hex.windowId then
                { model = { model | hex = Nothing }, command = Cmd.none }

            else if id == Tool.Notes.windowId then
                { model = { model | notes = Nothing }, command = Cmd.none }

            else if id == Tool.Time.windowId then
                { model = { model | time = Nothing }, command = Cmd.none }

            else if id == Tool.Unicode.windowId then
                { model = { model | unicode = Nothing }, command = Cmd.none }

            else if id == Help.windowId then
                { model = { model | help = Nothing }, command = Cmd.none }

            else
                -- The zone picker is a window of the converter's rather than
                -- the shell's, so closing it from its frame is the tool's news
                -- and not this function's. Everything unrecognised goes the
                -- same way, which is what stops the shell having to learn the
                -- id of every window a tool decides to open.
                toTools event model

        _ ->
            toTools event model


{-| The converter is the first tool that has something to do before it can
draw anything: it has to find out what time it is, and then what that time is
called in five places. So opening it is a `Step` rather than a model, and its
zones come from the shell because the shell is what read the config file.
-}
openTime : Model -> { model : Model, command : Cmd Msg }
openTime model =
    let
        step =
            Tool.Time.init model.timezones model.here
    in
    { model = { model | time = Just step.model }
    , command = Cmd.map FromTime step.command
    }


{-| The notes window, which needs the environment to know where notes live and
the file system permission to read them -- both of which are `Init.Task`s and
so are the shell's, exactly as the hex viewer's permission is.

`Tool.Notes.where_` is called here rather than held on the model beside
`configPath`, because unlike the config file it is wanted only when the window
opens and it is two `Dict` lookups.
-}
openNotes : Maybe String -> Model -> { model : Model, command : Cmd Msg }
openNotes wanted model =
    let
        step =
            Tool.Notes.init model.permission
                (Tool.Notes.where_ model.environment)
                wanted
                model.desktop
    in
    { model = { model | notes = Just step.model }
    , command = Cmd.map FromNotes step.command
    }


{-| Write the settings down, taking every one of them off the model.

A helper rather than a record built at each call site, and the reason is that
the compiler found both of the old ones the moment a third setting existed:
each was spelling out `{ theme = ..., timezones = ... }` by hand, so adding a
field meant remembering every place that saves. Now adding one means adding it
here.
-}
saveSettings : Model -> Cmd Msg
saveSettings model =
    Config.save model.permission
        model.configPath
        { theme = model.theme
        , timezones = model.timezones
        , weeks = model.weeks
        , chart = model.chart
        }
        |> Task.perform (\_ -> Saved)


chooseTheme : Theme.Name -> Model -> { model : Model, command : Cmd Msg }
chooseTheme name model =
    if name == model.theme then
        { model = model, command = Cmd.none }

    else
        let
            chosen =
                { model | theme = name }
        in
        { model = chosen, command = saveSettings chosen }


{-| The same shape as `chooseTheme`, and for the same reason: a setting the
user picked is written down as it is picked, because predc is a program people
leave open and close with the window.
-}
chooseWeeks : Week.Rule -> Model -> { model : Model, command : Cmd Msg }
chooseWeeks rule model =
    if rule == model.weeks then
        { model = model, command = Cmd.none }

    else
        let
            chosen =
                { model | weeks = rule }
        in
        { model = chosen, command = saveSettings chosen }


{-| The same shape as the two above, with one line they do not need: the chart
is a *window* as well as a setting, so an open one has to be told.

Without that the tick on the menu and the chart on the screen would disagree,
which is the failure mode a setting with two ways in always has. The other
direction is already covered -- `Tab` moves the tool's own mode and `toTools`
reads it back by comparison -- and the two meet here, because after this the
tool and the shell agree and that comparison finds nothing to save.
-}
chooseChart : Chart.Mode -> Model -> { model : Model, command : Cmd Msg }
chooseChart mode model =
    if mode == model.chart then
        { model = model, command = Cmd.none }

    else
        let
            chosen =
                { model
                    | chart = mode
                    , ascii = Maybe.map (Tool.Ascii.show mode) model.ascii
                }
        in
        { model = chosen, command = saveSettings chosen }


{-| Every open tool is handed the event and answers for its own view ids; a
closed one is not consulted, which is what `Maybe.map` says here. Nothing is
routed by window, because an event names the *view* it came from and that is
the finer-grained fact.

The hex viewer is the one that reads a file, and so the first tool to answer an
event with anything but a new model. That is the whole difference between the
two shapes here: a tool with no tasks is a `Model -> Model` and needs no
mapping, and a tool with tasks hands back a command that has to be lifted into
the shell's `Msg` before it can be returned. Nothing forces the quiet ones to
grow a `Cmd Msg` they would only ever fill with `Cmd.none`.
-}
toTools : Event -> Model -> { model : Model, command : Cmd Msg }
toTools event model =
    let
        hex =
            Maybe.map (Tool.Hex.update hexPorts event) model.hex

        time =
            Maybe.map (Tool.Time.update timeWiring event) model.time

        -- No `Cmd.map`, and no port record of its own. Neither starts a task,
        -- so every command either can produce is an outbound port send that
        -- never answers -- which makes both `update`s polymorphic in the
        -- message type and lets them take the shell's own ports unchanged.
        -- The calculator joined them when it learned to copy and paste.
        unicode =
            Maybe.map (Tool.Unicode.update tui event) model.unicode

        calc =
            Maybe.map (Tool.Calc.update tui event) model.calc

        calendar =
            Maybe.map (Tool.Calendar.update calendarPorts event) model.calendar

        random =
            Maybe.map (Tool.Random.update randomPorts event) model.random

        env =
            Maybe.map (Tool.Env.update tui event) model.env

        notes =
            Maybe.map (Tool.Notes.update notesPorts event) model.notes

        moved =
            { model
                | ascii = Maybe.map (Tool.Ascii.update event) model.ascii
                , calendar = Maybe.map .model calendar
                , encode = Maybe.map (Tool.Encode.update event) model.encode
                , calc = Maybe.map .model calc
                , hex = Maybe.map .model hex
                , notes = Maybe.map .model notes
                , random = Maybe.map .model random
                , env = Maybe.map .model env
                , time = Maybe.map .model time
                , unicode = Maybe.map .model unicode
                -- Like the chart and the calculator, it starts nothing and so
                -- has nothing to hand back but a model.
                , help = Maybe.map (\it -> (Help.update event it).model) model.help
            }

        -- What the converter is displaying *is* what the config file should
        -- say, so the shell writes it down whenever the two disagree.
        --
        -- Deliberately a comparison and not a message. The picker changes the
        -- list from four different places -- Add, Remove, a double click in
        -- either of two lists -- and a tool that had to remember to announce
        -- each one is a tool with a fourth place to forget. Saving what is on
        -- the screen cannot drift from what is on the screen. It also stays
        -- silent for the case that matters most: opening the converter for the
        -- first time shows the machine's own zone, which nobody chose, and
        -- `zones` matching `timezones` at `Nothing` means that is not written
        -- down as though they had.
        chosen =
            Maybe.map Tool.Time.zones moved.time

        -- The ASCII chart's mode, read the same way and for the same reason:
        -- the tool changes it from three places -- `Tab` and two menu entries
        -- -- and a tool that had to remember to announce each one is a tool
        -- with a third place to forget. What is on the screen cannot drift
        -- from what is on the screen.
        --
        -- No `Nothing` case to guard here, unlike the zone list: the chart is
        -- opened *from* this value, so a window nobody has touched agrees with
        -- what is already written down and nothing is saved.
        showing =
            Maybe.map Tool.Ascii.mode moved.ascii

        turned =
            showing /= Nothing && showing /= Just model.chart

        wrote =
            (chosen /= Nothing && chosen /= model.timezones) || turned

        -- The environment tool asking for the hex viewer, which is the only
        -- place in predc where one tool opens another.
        --
        -- It is a field on the step rather than a `Cmd` because a `Cmd` asks
        -- the *runtime* for something, and a window belonging to `Tool.Hex` is
        -- not the runtime's to give -- the shell owns both models and is the
        -- only thing that can put one in front of the other. `Main` already
        -- reads every step to take its model; this is one more field on the
        -- same read.
        --
        -- The viewer is rebuilt rather than handed the bytes: whatever it had
        -- open was a different thing, and the alternative is a viewer that is
        -- sometimes showing what you asked for and sometimes not.
        handed =
            Maybe.andThen .send env

        withHex =
            when handed is
                Just it ->
                    let
                        step =
                            Tool.Hex.openBytes moved.permission moved.desktop it.name it.bytes
                    in
                    { model = { moved | hex = Just step.model }
                    , command = Cmd.map FromHex step.command
                    }

                Nothing ->
                    { model = moved, command = Cmd.none }

        moved2 =
            withHex.model
    in
    { model =
        if wrote then
            { moved2
                | timezones =
                    if chosen /= Nothing then
                        chosen

                    else
                        moved2.timezones
                , chart = Maybe.withDefault moved2.chart showing
            }

        else
            moved2
    , command =
        Cmd.batch
            [ withHex.command
            , when handed is
                Just _ ->
                    Tui.focus tui Tool.Hex.windowId

                Nothing ->
                    Cmd.none
            , when hex is
                Just step ->
                    Cmd.map FromHex step.command

                Nothing ->
                    Cmd.none
            , when time is
                Just step ->
                    Cmd.map FromTime step.command

                Nothing ->
                    Cmd.none
            , when unicode is
                Just step ->
                    step.command

                Nothing ->
                    Cmd.none
            , when calc is
                Just step ->
                    step.command

                Nothing ->
                    Cmd.none
            , when calendar is
                Just step ->
                    Cmd.map FromCalendar step.command

                Nothing ->
                    Cmd.none
            , when random is
                Just step ->
                    Cmd.map FromRandom step.command

                Nothing ->
                    Cmd.none
            , when env is
                Just step ->
                    step.command

                Nothing ->
                    Cmd.none
            , when notes is
                Just step ->
                    Cmd.map FromNotes step.command

                Nothing ->
                    Cmd.none
            , if wrote then
                saveSettings
                    { model
                        | timezones =
                            if chosen /= Nothing then
                                chosen

                            else
                                model.timezones
                        , chart = Maybe.withDefault model.chart showing
                    }

              else
                Cmd.none
            ]
    }


-- SUBSCRIPTIONS


{-| The Turbo Vision port pair is `defineProgramOrExit`'s own and is not here.
This is predc's second one, and it is subscribed only while the converter is
open -- a reply that arrives for a tool the user has closed has nothing to
land on, and the tool that asked for it is gone.
-}
subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.batch
        [ when model.time is
            Just it ->
                Sub.map FromTime (Tool.Time.subscriptions timeWiring it)

            Nothing ->
                Sub.none
        -- The notes tool's autosave, which subscribes only while it has
        -- something to write. `view` runs on every tick of every subscription,
        -- so a tool that ticked whenever its window was open would repaint the
        -- desktop once a second for as long as somebody left it there.
        , when model.notes is
            Just it ->
                Sub.map FromNotes (Tool.Notes.subscriptions it)

            Nothing ->
                Sub.none
        ]


-- VIEW


view : Model -> Tui.Ui
view model =
    { menuBar = menuBar model
    , theme = Theme.palette model.theme
    -- Exit, Close, and one sentence about pasting -- and no tools at all,
    -- which is the change a fifth tool forced. Every tool that went on this
    -- bar had to come off it again as soon as the next one arrived, and the
    -- Unicode decoder never fitted in the first place: `Alt-U` has been
    -- reachable only from the Tools menu since the day it was written, so the
    -- bar was already lying about what predc has. A list that cannot grow is
    -- not a list of the tools. All five carry their Alt-key on the menu and
    -- `TMenuBar` is `ofPreProcess` exactly as `TStatusLine` is, so every
    -- shortcut still works from a window with a focused canvas in it --
    -- measured for `F5` and `F6` when they came off for the same reason.
    --
    -- What the room bought is the one question this program is asked most.
    -- Copying and pasting in a terminal is genuinely confusing and every
    -- layer of it fails in silence, so the answer is now on the screen at all
    -- times rather than behind a key somebody has to know to press.
    --
    -- The width is computed and not assumed, which is the part worth keeping.
    -- `TStatusLine` drops an entry that does not fit **whole and without
    -- saying so**, and a terminal's width changes under the program, so a
    -- sentence chosen for eighty columns is a sentence that silently vanishes
    -- at sixty. `Help.pasteBar` is handed what is left after the two fixed
    -- entries and picks the longest rung that fits; the bottom rung is empty,
    -- which costs nothing and leaves `F1` working.
    , statusLine =
        let
            fixed =
                [ { text = "~Alt-X~ Exit", key = "Alt-X", cmd = "quit" }
                , { text = "~Alt-F3~ Close", key = "Alt-F3", cmd = "close" }
                ]

            -- `barWidth + 2` per entry is `TStatusLine::drawSelect`'s own
            -- arithmetic, and the `- 1` is its `i + l < size.x` rather than
            -- `<=`. Derived from `fixed` instead of written down, so that
            -- changing an entry above cannot leave a stale number here.
            spent =
                Array.foldl (\item total -> total + Help.barWidth item.text + 2) 0 fixed
        in
        fixed
            ++ [ { text = Help.pasteBar model.session (model.desktop.cols - spent - 1)
                 , key = "F1"
                 , cmd = Help.command
                 }
               ]
            -- Three keys with nothing beside them, and they are the reason the
            -- fields in this program can be filled from the rest of it.
            --
            -- Turbo Vision binds no keys to cut, copy and paste itself -- it will
            -- not choose `Ctrl-C` for somebody -- so a program that names none has
            -- input lines that cannot do either, and nothing reports it. Naming
            -- them here costs no columns, because a status entry with no text
            -- draws nothing and is still offered every keystroke.
            --
            -- What it buys over ssh is the whole of it. `y` in the Unicode decoder
            -- puts code points on a clipboard no remote terminal will ever hand
            -- back, and `Shift-Ins` in the hex viewer's **Type bytes** field takes
            -- them straight out of it again -- one program, one clipboard, no
            -- terminal involved. That is a round trip predc could not make until
            -- the binding stopped letting views keep a second clipboard of their
            -- own; `gren-tvision/doc/clipboard.md` has the story.
            ++ [ { text = "", key = "Shift-Del", cmd = "clipboard.cut" }
               , { text = "", key = "Ctrl-Ins", cmd = "clipboard.copy" }
               , { text = "", key = "Shift-Ins", cmd = "clipboard.paste" }
               ]
    , windows =
        (when model.ascii is
            Just ascii ->
                [ Tool.Ascii.view (Theme.inks model.theme) ascii ]

            Nothing ->
                []
        )
            ++ (when model.calc is
                    Just calc ->
                        [ Tool.Calc.view (Theme.inks model.theme) calc ]

                    Nothing ->
                        []
               )
            ++ (when model.calendar is
                    Just calendar ->
                        [ Tool.Calendar.view (Theme.inks model.theme) model.weeks calendar ]

                    Nothing ->
                        []
               )
            ++ (when model.encode is
                    Just encode ->
                        [ Tool.Encode.view (Theme.inks model.theme) encode ]

                    Nothing ->
                        []
               )
            ++ (when model.env is
                    Just env ->
                        [ Tool.Env.view (Theme.inks model.theme) env ]

                    Nothing ->
                        []
               )
            ++ (when model.random is
                    Just random ->
                        [ Tool.Random.view (Theme.inks model.theme) random ]

                    Nothing ->
                        []
               )
            ++ (when model.hex is
                    Just hex ->
                        [ Tool.Hex.view (Theme.inks model.theme) hex ]

                    Nothing ->
                        []
               )
            -- The one tool whose view takes no `Inks`: a list, an editor and a
            -- line of text are all views the palette dresses, and it draws no
            -- `Span` for an ink to reach.
            ++ (when model.notes is
                    Just notes ->
                        [ Tool.Notes.view notes ]

                    Nothing ->
                        []
               )
            -- The only tool that answers with more than one window: its zone
            -- picker is a second window of its own rather than a modal, and
            -- `Tool.Time` says why.
            ++ (when model.time is
                    Just time ->
                        Tool.Time.windows model.desktop time

                    Nothing ->
                        []
               )
            ++ (when model.help is
                    Just help ->
                        [ Help.view (Theme.inks model.theme) help ]

                    Nothing ->
                        []
               )
            ++ (when model.unicode is
                    Just unicode ->
                        [ Tool.Unicode.view (Theme.inks model.theme) model.session unicode ]

                    Nothing ->
                        []
               )
    , overlays = []
    }


{-| The bar, with each open tool's own menu spliced in between Tools and
Window.

A tool's menu is present because the tool is *open*, not because it is the one
in front, and that is forced rather than chosen: nothing tells the model which
window is active. There is no event for it -- `Focused` is a list box's
highlight moving, and window order belongs to Turbo Vision. So a menu that
followed the focus is not expressible, and the honest alternative is a bar that
grows by one menu per open tool.
-}
menuBar : Model -> Array MenuItem
menuBar model =
    [ SubMenu
        { title = "~F~ile"
        , key = ""
        , items = [ Item { title = "E~x~it", cmd = "quit", key = "Alt-X", shortcut = "Alt-X" } ]
        }
    , SubMenu
        { title = "~T~ools"
        , key = ""
        , items =
            [ Tool.Ascii.menuItem
            , Tool.Calc.menuItem
            , Tool.Hex.menuItem
            , Tool.Time.menuItem
            , Tool.Unicode.menuItem
            , Tool.Calendar.menuItem
            , Tool.Encode.menuItem
            , Tool.Random.menuItem
            , Tool.Env.menuItem
            , Tool.Notes.menuItem
            ]
        }
    ]
        ++ toolMenus model
        -- Colors was under Tools, where it did not belong: a colour scheme is
        -- not a tool, and the menu that lists what predc *has* should not also
        -- be where its settings live. Turbo Vision's own demo answers this --
        -- `tvdemo3.cpp` has an `~O~ptions` menu with `~C~olors...` in it,
        -- beside Mouse and Background -- and it is the Borland IDE's answer
        -- too, where Options always sits just before Window and Help. That is
        -- where this goes, and the position is the convention rather than a
        -- preference.
        --
        -- One entry in it today. It is still the right menu: Colors is the
        -- only setting predc has *now*, and the config file already holds a
        -- second thing the user chose (the converter's zone list). Under Tools
        -- the next preference had nowhere to go without making that menu wrong
        -- again -- the same argument that took the tools off the status line.
        ++ [ SubMenu
                { title = "~O~ptions"
                , key = ""
                , items =
                    [ SubMenu
                        { title = "~C~olors"
                        , key = ""
                        , items = Array.map (themeItem model.theme) Theme.all
                        }
                    , SubMenu
                        { title = "~W~eek numbers"
                        , key = ""
                        , items = Array.map (weekItem model.weeks) Week.all
                        }
                    -- The chart's own mode, on the settings menu rather than
                    -- on a menu of the tool's, which is where predc puts a
                    -- setting: the colour scheme and the week numbering are
                    -- both here and neither is on the window it changes. It
                    -- earns the place twice over -- this is the half that can
                    -- be reached when the chart is closed, and it is where
                    -- somebody looks for a thing they can change.
                    , SubMenu
                        { title = "~A~SCII chart"
                        , key = ""
                        , items = Array.map (chartItem model.chart) Chart.all
                        }
                    ]
                }
           ]
        ++ -- Every one of these is Turbo Vision's own: they move windows
           -- around and say nothing to the model, which is why `view` can
           -- render the same rectangle forever without dragging a window back
           -- to where it began.
           [ SubMenu
                { title = "~W~indow"
                , key = ""
                , items =
                    [ Item { title = "~R~esize/move", cmd = "resize", key = "Ctrl-F5", shortcut = "Ctrl-F5" }
                    , Item { title = "~Z~oom", cmd = "zoom", key = "F5", shortcut = "F5" }
                    , Item { title = "~N~ext", cmd = "next", key = "F6", shortcut = "F6" }
                    , Item { title = "~C~lose", cmd = "close", key = "Alt-F3", shortcut = "Alt-F3" }
                    , Item { title = "~T~ile", cmd = "tile", key = "", shortcut = "" }
                    , Item { title = "C~a~scade", cmd = "cascade", key = "", shortcut = "" }
                    ]
                }
           , SubMenu
                { title = "~H~elp"
                , key = ""
                , items =
                    [ Help.menuItem
                    , Tui.Separator
                    , Item { title = "~A~bout...", cmd = "about", key = "", shortcut = "" }
                    ]
                }
           ]


{-| A tick beside the one in use, because a menu is the only place this
program says which theme it is in -- there is no status line room for it and
the answer is on the screen anyway. Turbo Vision has no checkable menu item,
so it is a character in the title, which is what its own examples do.
-}
themeItem : Theme.Name -> Theme.Name -> MenuItem
themeItem current name =
    Item
        { title =
            (if name == current then
                "√ "

             else
                "  "
            )
                ++ Theme.title name
        , cmd = "theme." ++ String.toLower (Theme.title name)
        , key = ""
        , shortcut = ""
        }


{-| The chart's two forms, ticked like the themes and the week rules.

No `shortcut` on either, and `Tab` is deliberately not written here: `Tab`
reaches the chart only while the chart has the caret, and a shortcut column on
a program-wide menu that said otherwise would be wrong more often than right.
The window says it instead, on a line of its own, which is where somebody
looking at the chart will see it.
-}
chartItem : Chart.Mode -> Chart.Mode -> MenuItem
chartItem current mode =
    Item
        { title =
            (if mode == current then
                "√ "

             else
                "  "
            )
                ++ Chart.title mode
        , cmd = "chart." ++ Chart.toKey mode
        , key = ""
        , shortcut = ""
        }


{-| The same tick as the themes, and the same reason: Turbo Vision has no
checkable menu item, so the mark is a character in the title.

The titles say what each rule *is* rather than only naming it, because "ISO" and
"US" are not what somebody is choosing between -- which day the week starts on
and which week gets number 1 are.
-}
weekItem : Week.Rule -> Week.Rule -> MenuItem
weekItem current rule =
    Item
        { title =
            (if rule == current then
                "√ "

             else
                "  "
            )
                ++ Week.title rule
        , cmd = "weeks." ++ Week.toKey rule
        , key = ""
        , shortcut = ""
        }


toolMenus : Model -> Array MenuItem
toolMenus model =
    (when model.calc is
        Just calc ->
            [ Tool.Calc.menu calc ]

        Nothing ->
            []
    )
        ++ (when model.hex is
                Just _ ->
                    [ Tool.Hex.menu ]

                Nothing ->
                    []
           )
        ++ (when model.encode is
                Just _ ->
                    [ Tool.Encode.menu ]

                Nothing ->
                    []
           )
        ++ (when model.random is
                Just _ ->
                    [ Tool.Random.menu ]

                Nothing ->
                    []
           )
        ++ (when model.env is
                Just _ ->
                    [ Tool.Env.menu ]

                Nothing ->
                    []
           )
        ++ (when model.calendar is
                Just _ ->
                    [ Tool.Calendar.menu ]

                Nothing ->
                    []
           )
        ++ (when model.unicode is
                Just _ ->
                    [ Tool.Unicode.menu ]

                Nothing ->
                    []
           )
        ++ (when model.notes is
                Just _ ->
                    [ Tool.Notes.menu ]

                Nothing ->
                    []
           )


{-| What predc is, and what it is standing on.

The two credits are here rather than only in the README because this is the
window somebody opens when they wonder what they are looking at, and both
answers are worth giving: the frames, the menus and the modality are Borland's
design by way of magiblot's port, and every line of predc itself is Gren.

Each URL is on a line of its own. That is not layout for its own sake -- a
`messageBox` takes its width from the longest line, so a label and a link on
one row would make the dialog wider than either needs, and a URL sharing a row
with words is harder to drag a mouse across.
-}
aboutDialog : Model -> Tui.DialogSpec
aboutDialog model =
    Tui.messageBox
        { id = "about"
        , title = "About"
        , text = String.join "\n" (aboutLines model.desktop.rows)
        , buttons = Tui.okButtons
        , desktop = model.desktop
        }


{-| The longest version of the About that fits the terminal it is being shown
in, which is a ladder for the same reason the status line's paste hint is one.

**A `messageBox` clamps to the desktop and does not scroll**, so a dialog with
more text than there is room for does not lose the bottom of it politely: the
OK button is placed relative to the dialog and lands *on top of the text*.
Twenty-one rows of About in a twenty-row terminal came out with
`https     OK    ▄.org` written across it, which is the third time in this
program that something rendered into a fixed space has failed by looking like
a mess rather than by saying so.

`count + 7` is `messageBox`'s own arithmetic -- seven rows of frame, spacing
and button -- so the rungs are measured against it rather than guessed. The
floor is the chrome: below about twelve rows no dialog with a button in it
fits, and that is `Tui`'s to answer rather than something to word around.
-}
aboutLines : Int -> Array String
aboutLines rows =
    let
        fits candidate =
            Array.length candidate + 7 <= rows
    in
    [ -- Everything: what it is, what it is for, and both credits in full.
      [ ""
      , "\u{0003}predc"
      , " "
      , "\u{0003}the programmer's every-day carry"
      , " "
      , "\u{0003}small tools, one terminal window"
      , " "
      , "\u{0003}Powered by Turbo Vision"
      , "\u{0003}Borland's, ported by magiblot"
      , "\u{0003}https://github.com/magiblot/tvision"
      , " "
      , "\u{0003}Written in Gren"
      , "\u{0003}https://gren-lang.org"
      , ""
      ]
    -- The taglines go first: they are the part a reader can get from the
    -- README, and the credits are the part that is only here.
    , [ ""
      , "\u{0003}predc"
      , " "
      , "\u{0003}Powered by Turbo Vision"
      , "\u{0003}https://github.com/magiblot/tvision"
      , " "
      , "\u{0003}Written in Gren"
      , "\u{0003}https://gren-lang.org"
      , ""
      ]
    -- And at the bottom, the two names without their links, because a URL
    -- nobody can read all of is worse than a name they can search for.
    , [ ""
      , "\u{0003}predc"
      , " "
      , "\u{0003}Turbo Vision, and Gren"
      , ""
      ]
    ]
        |> Array.keepIf fits
        |> Array.first
        |> Maybe.withDefault
            [ "", "\u{0003}predc", "" ]


-- PROGRAM


main : Tui.Program Model Msg
main =
    Tui.defineProgramOrExit tui
        { init = init
        , update = update
        , subscriptions = subscriptions
        , view = view
        , onEvent = FromTui
        }

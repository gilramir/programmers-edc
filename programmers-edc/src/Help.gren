module Help exposing
    ( Entry
    , Model
    , Page(..)
    , Session
    , barWidth
    , command
    , detect
    , init
    , inventory
    , lineWidth
    , menuItem
    , opened
    , overlong
    , pageFor
    , pasteBar
    , pasteHint
    , update
    , view
    , windowId
    )

{-| The help window, which has two pages.

**What is in here** is the inventory: ten tools, what each one is for, its
Alt-key and the word that opens it from the command line. It exists because
predc's own answer to "what does this program have in it" was a menu of ten
titles, and a title is a name rather than a description -- "Encode / decode"
does not say which four transforms, and `Alt-P` for the environment list is not
guessable from anything. It is one page and not ten, and each tool gets three
lines, because somebody reading it is deciding which window to open rather than
learning how to use one.

**Copying and pasting** is the other page, and the older one.

It answers "why can I not paste into this?", and it exists because the answer
is genuinely hard and every layer of it is silent.
There are five stores on unix that people call the clipboard; Turbo Vision
touches one of them; a mouse selection fills a different one; over ssh none is
reachable and no setting changes that; and the thing that *does* work is not a
clipboard operation at all, but the terminal typing at the program. Somebody
who hits this in predc will conclude the program is broken, because every part
of the machinery that failed did so without saying anything.

**It measures rather than guesses.** The environment says whether there is a
display, an ssh session and a multiplexer, and that settles most of it -- but
whether a *terminal* will hand its clipboard back is in no variable, so the
window asks for the clipboard when it opens and reads the answer's
`fromSystem`. That one fact decides whether `p` can ever work here, and this
way it is a measurement rather than a table lookup.

**What to press comes first and why comes second**, which is the opposite of
how the subject is usually written down. Somebody in front of a terminal that
will not paste wants three lines; the page-long version is
`gren-tvision/docs/clipboard.md`, and the last line here says so.

**One window and two pages, rather than two windows.** Both are prose that
scrolls, and everything but the text -- the layout, the scroll bar, `PgDn`,
sizing to the desktop -- was already written once. Opening either from the Help
menu shows it, which is the shape a Turbo Vision help viewer has always had:
one window, whichever topic you asked for.

-}

import Array exposing (Array)
import Dict exposing (Dict)
import String
import Theme exposing (Inks)
import Tui exposing (Span, View(..))


-- NAMES


{-| Which page the window is showing. Not two windows: see the module note.
-}
type Page
    = Tools
    | Clipboard


command : Page -> String
command page =
    when page is
        Tools ->
            "help.tools"

        Clipboard ->
            "help.clipboard"


{-| The page a command opens, or `Nothing` for a command that is not ours.

`Main` dispatches through this rather than testing two names, which is what
keeps adding a third page to one file: a `Page` with no line here would not
compile.
-}
pageFor : String -> Maybe Page
pageFor cmd =
    if cmd == command Tools then
        Just Tools

    else if cmd == command Clipboard then
        Just Clipboard

    else
        Nothing


{-| One id for both pages, because there is one window. Opening the other page
from the menu re-renders this one rather than putting a second window on the
desktop -- which is also why `Main` keeps a single `Maybe Help.Model`.
-}
windowId : String
windowId =
    "help"


canvasId : String
canvasId =
    "help.text"


scrollId : String
scrollId =
    "help.scroll"


menuItem : Page -> Tui.MenuItem
menuItem page =
    when page is
        Tools ->
            Tui.Item
                { title = "~W~hat is in here"
                , cmd = command Tools
                -- No accelerator. `F1` is the clipboard page's and there is no
                -- second function key that means help; an Alt-letter would be
                -- the eleventh in a program whose ten tools already have one
                -- each, and this is the entry somebody reaches for once.
                , key = ""
                , shortcut = ""
                }

        Clipboard ->
            Tui.Item
                { title = "~C~opying and pasting"
                , cmd = command Clipboard
                -- `F1` because it is where help has been since before Turbo
                -- Vision, and because nothing else in predc wants it: the
                -- status line is all Alt-keys and Alt-F3, and the Window menu
                -- has F5 and F6.
                , key = "F1"
                , shortcut = "F1"
                }


-- SHAPE


{-| The fewest text rows to ask for.

One, and not a friendlier-looking three, because the floor and the ceiling here
are the same arithmetic: the window is `textRows + 3` tall and sits one row
down, so anything above `desktop.rows - 4` hangs off the bottom of the desktop.
A floor of three did exactly that on an eight-row terminal. Turbo Vision will
not draw a window under six rows anyway, which is a five-row desktop, and below
that there is nothing to get right.
-}
leastRows : Int
leastRows =
    1


{-| The text column. Sixty-nine because the widest line is sixty-eight and
prose wants one column of air after it; the window is `lineWidth + 3` wide,
which is the two frame columns plus the one the scroll bar sits on.
-}
lineWidth : Int
lineWidth =
    69


{-| How many rows of a window of this height are text.

Three are spoken for whatever the height is: the two frame rows and the blank
one under the text. Written once because it is used twice -- to lay the window
out and to turn a resize into a row count -- and the two agreeing is what makes
`PgDn` move by exactly what is on the screen.
-}
rowsIn : Int -> Int
rowsIn height =
    max 1 (height - 3)


-- MODEL


{-| What this machine is, as far as the clipboard is concerned.

Read once at start-up because `Node.getEnvironmentVariables` is an `Init.Task`
and nothing later can ask for one -- the same reason the file system permission
is held in the shell's model.
-}
type alias Session =
    { display : Bool
    , wayland : Bool
    , ssh : Bool
    , tmux : Bool
    , screen : Bool
    , term : String
    }


{-| What the environment says.

`SSH_CONNECTION` is tested first rather than `SSH_TTY`, because `sshd` sets it
for every session including ones with no tty. None of the three is
authoritative -- anybody can unset any of them -- which is why the window shows
what it found as well as what it concluded.
-}
detect : Dict String String -> Session
detect env =
    let
        set name =
            when Dict.get name env is
                Just value ->
                    not (String.isEmpty value)

                Nothing ->
                    False
    in
    { display = set "DISPLAY"
    , wayland = set "WAYLAND_DISPLAY"
    , ssh = set "SSH_CONNECTION" || set "SSH_TTY" || set "SSH_CLIENT"
    , tmux = set "TMUX"
    , screen = set "STY"
    , term =
        when Dict.get "TERM" env is
            Just value ->
                value

            Nothing ->
                "(unset)"
    }


{-| Whether the terminal will hand its clipboard back, which no variable says.

`Asking` is a state the window can be in for a moment and, on a terminal that
never answers, for ever -- so it is drawn rather than waited for, and the
answer replaces it whenever it arrives. Same shape and same reason as the hex
viewer's "Asking for the clipboard..." line.
-}
type Probe
    = Asking
    | Answered Bool


type alias Model =
    { page : Page
    , session : Session
    -- The desktop, because this window opens as tall as the desktop will let
    -- it. Handed over at `init` and kept up to date by `Resized`, and it needs
    -- both: `Resized` fires when the size *changes*, so a window opened after
    -- somebody stretched their terminal would otherwise never hear about it.
    , desktop : { cols : Int, rows : Int }
    , probe : Probe
    , top : Int
    , rows : Int
    }


init : Page -> { cols : Int, rows : Int } -> Session -> Model
init page desktop session =
    { page = page
    , session = session
    , desktop = desktop
    , probe = Asking
    , top = 0
    , rows = textRows page desktop
    }


{-| How many rows of text to open with: as many as the desktop has room for.

This is prose and the whole of it is a hundred-odd lines, so on any terminal
anybody has it is the desktop that decides -- which is the point. A pane
forty rows tall should show forty rows of it, not the seventeen that fit an
eighty-by-twenty-four terminal.

Four rows are not text whatever the height: the two frame rows, the blank one
under the text, and the row of desktop the window is inset from the top by.

The cap is `wholeThing` rather than the current line count, and that is not
the same number: the probe's answer is two lines longer than the question, so
sizing to what is on screen *now* would make the window jump a moment after it
opened. Sizing to the longest it can ever be does not.

Per page, because the two are different lengths and the shorter one should not
open with the taller one's empty rows under it.
-}
textRows : Page -> { cols : Int, rows : Int } -> Int
textRows page desktop =
    clamp leastRows (wholeThing page) (desktop.rows - 4)


type alias Step msg =
    { model : Model, command : Cmd msg }


still : Model -> Step msg
still model =
    { model = model, command = Cmd.none }


{-| Opening the window asks for the clipboard, and the *answer* is the point
rather than the text: `fromSystem` is what says whether the read reached
anything outside this process, and the text is dropped on the floor.

One request per opening rather than one per run, which is the cheaper mistake.
A terminal's answer can change under a running program -- tmux's
`set-clipboard` is a live setting and so is kitty's `clipboard_control` -- and
a window somebody opened *because* they just changed one should not be
answering out of a cache.

**And only the clipboard page asks.** The probe is a real `OSC 52` read going
out at the terminal, which is a thing to do when somebody has asked why pasting
does not work and not when they have asked what tools there are. The tools page
opens with `Cmd.none`; its `probe` stays `Asking` and nothing ever draws it.
-}
opened : Tui.Ports msg -> Page -> { cols : Int, rows : Int } -> Session -> Step msg
opened ports page desktop session =
    { model = init page desktop session
    , command =
        when page is
            Clipboard ->
                Tui.readClipboard ports

            Tools ->
                Cmd.none
    }


-- UPDATE


update : Tui.Event -> Model -> Step msg
update event model =
    when event is
        -- The terminal changed size, so the window should. Its rectangle is
        -- computed from this on every render, so the differ writes the new
        -- bounds by itself -- and writes nothing while the size is unchanged,
        -- which is what leaves a window the user dragged where they put it.
        Tui.Resized size ->
            still (at model.top { model | desktop = size, rows = textRows model.page size })

        Tui.WindowResized it ->
            if it.id == windowId then
                still (at model.top { model | rows = rowsIn (it.rect.y2 - it.rect.y1) })

            else
                still model

        Tui.KeyPressed pressed ->
            if pressed.id == canvasId then
                still (pressKey pressed.key model)

            else
                still model

        Tui.Scrolled bar ->
            if bar.id == scrollId then
                still (at bar.value model)

            else
                still model

        -- The probe's answer, and the guard is the one both pasting tools use:
        -- `Asking` is what says this window was the thing that asked. Every
        -- open tool is handed every event, so without it a paste made in the
        -- hex viewer would be read here as a measurement.
        Tui.ClipboardText it ->
            when model.probe is
                Asking ->
                    still { model | probe = Answered it.fromSystem }

                Answered _ ->
                    still model

        _ ->
            still model


pressKey : String -> Model -> Model
pressKey key model =
    let
        last =
            max 0 (Array.length (rows model) - model.rows)
    in
    when key is
        "Up" ->
            at (model.top - 1) model

        "Down" ->
            at (model.top + 1) model

        "PgUp" ->
            at (model.top - model.rows) model

        "PgDn" ->
            at (model.top + model.rows) model

        "Home" ->
            at 0 model

        "Ctrl-Home" ->
            at 0 model

        "End" ->
            at last model

        "Ctrl-End" ->
            at last model

        _ ->
            model


at : Int -> Model -> Model
at top model =
    { model | top = clamp 0 (max 0 (Array.length (rows model) - model.rows)) top }


-- WHAT IT SAYS


{-| A line, before a theme has been applied to it.

The text is built without `Inks` and painted afterwards, which is not tidiness:
`update` has to count the lines to scroll them and `update` has no theme. One
array that both halves agree about is what stops the scroll bar and the text
drifting apart.
-}
type Line
    = Head String
    | Text String
    | Warn String
    | Gap


paint : Inks -> Line -> Array Span
paint inks line =
    when line is
        Head text ->
            [ Tui.ink inks.ruler text ]

        Text text ->
            [ Tui.plain text ]

        Warn text ->
            [ Tui.ink inks.alert text ]

        Gap ->
            []


textOf : Line -> String
textOf line =
    when line is
        Head text ->
            text

        Text text ->
            text

        Warn text ->
            text

        Gap ->
            ""


{-| Every line of either page that is wider than the canvas, which should be
none of them.

A canvas cuts a line off at its width **without a mark**, so a sentence one
column too long arrives looking like a finished sentence -- the same trap the
calculator's message line is written against, and worse here, because this is
a page of prose and nobody counts columns while writing one. Two of the tools
page's entries were over when it was written.

Exposed only so that `tests/src/HelpTests.gren` can assert it is empty. The
session lines are the longest case of the clipboard page's conditionals, which
is why it is measured against the same made-up model `wholeThing` uses.
-}
overlong : Array String
overlong =
    let
        sample page =
            { page = page
            , session =
                { display = False
                , wayland = False
                , ssh = True
                , tmux = True
                , screen = False
                , term = "xterm-256color"
                }
            , desktop = { cols = 80, rows = 24 }
            , probe = Answered False
            , top = 0
            , rows = 1
            }
    in
    (rows (sample Tools) ++ rows (sample Clipboard))
        |> Array.map textOf
        |> Array.keepIf (\text -> String.count text > lineWidth)


{-| The most lines a page can ever be, which is what the window sizes itself
against.

Measured off a model with the probe *answered* and both conditional sections
in, because those are the longest cases -- a fact about the text rather than
about a session, which is why it is computed from a made-up model rather than
from the real one.
-}
wholeThing : Page -> Int
wholeThing page =
    Array.length
        (rows
            { page = page
            , session =
                { display = False
                , wayland = False
                , ssh = True
                , tmux = True
                , screen = False
                , term = ""
                }
            , desktop = { cols = 80, rows = 24 }
            , probe = Answered False
            , top = 0
            , rows = 1
            }
        )


{-| Every line of the page being shown. The visible ones are taken from here,
and the scroll bar counts it.
-}
rows : Model -> Array Line
rows model =
    when model.page is
        Tools ->
            whatIsInHere

        Clipboard ->
            yours model ++ pressing model ++ pasting ++ copying ++ table ++ stores


-- WHAT IS IN HERE


{-| One tool, as the inventory page describes it.

`title` and `key` are **copies** of what the tool's own `menuItem` says, and
they have to be, because `Help` cannot import the tools: `Tool.Unicode` imports
this module for [`pasteHint`](#pasteHint), so an import the other way is a
cycle. A copy that nothing checks is a copy that goes stale, and the thing that
checks these is `tests/src/HelpTests.gren` -- which is a leaf and can therefore
import both. It compares the set of tools, every title and every Alt-key
against the ten `menuItem` values, so renaming a tool or moving its key breaks
a unit test in milliseconds rather than leaving this page quietly wrong.

`word` is the command-line word from `Cli.gren`, checked the same way, and it
is on the page because it is the one thing about a tool that the user interface
never says anywhere.

-}
type alias Entry =
    { title : String
    , key : String
    , word : String
    , blurb : Array String
    }


{-| The ten, in the order the Tools menu lists them -- which is the order they
were written in rather than an alphabet, and is the order somebody who has seen
the menu is expecting.

Three lines each, at most. This page is read by somebody deciding *which window
to open*, not by somebody learning to use one, so what each entry owes them is
what the tool is for and the one thing about it that is not guessable from its
name. The tool's own module doc is where the rest lives.
-}
inventory : Array Entry
inventory =
    [ { title = "ASCII chart"
      , key = "Alt-A"
      , word = "predc ascii"
      , blurb =
            [ "0 to 127 in a grid you walk around in. Every control code has"
            , "its name, its C escape and its Ctrl- chord, which is the part"
            , "a chart usually leaves out."
            ]
      }
    , { title = "RPN calculator"
      , key = "Alt-R"
      , word = "predc calc"
      , blurb =
            [ "Exact arithmetic in dec, hex, oct and bin: 2^64-1 is a value"
            , "here and not a rounding error, and division promotes rather"
            , "than truncating, so 7 2 / is 3.5."
            ]
      }
    , { title = "Hex dump viewer"
      , key = "Alt-D"
      , word = "predc hex [file]"
      , blurb =
            [ "Offsets, sixteen bytes a row, the printable rendering beside"
            , "them. It never loads the file, so anything opens at once; six"
            , "colours are available for marking ranges up."
            ]
      }
    , { title = "Time converter"
      , key = "Alt-C"
      , word = "predc time"
      , blurb =
            [ "One instant on several wall clocks, all of them editable:"
            , "type into any row and the rest move with it. The zones are the"
            , "machine's, so daylight saving is right rather than modelled."
            ]
      }
    , { title = "Unicode decoder"
      , key = "Alt-U"
      , word = "predc unicode"
      , blurb =
            [ "What a run of bytes says in UTF-8 or UTF-16, one character a"
            , "row. The point is the rows that are wrong: overlongs,"
            , "surrogates and truncations are named, not turned into U+FFFD."
            ]
      }
    , { title = "Calendar"
      , key = "Alt-K"
      , word = "predc cal"
      , blurb =
            [ "A month, the weekday every date falls on, and the number of"
            , "the week it is in -- ISO or US, whichever Options says."
            ]
      }
    , { title = "Encode / decode"
      , key = "Alt-J"
      , word = "predc encode"
      , blurb =
            [ "Base64, percent-encoding, C string escapes and HTML entities,"
            , "both directions. Which transform and which way are both chosen"
            , "rather than sniffed, because all four inputs overlap."
            ]
      }
    , { title = "Random values"
      , key = "Alt-V"
      , word = "predc random"
      , blurb =
            [ "A v4 UUID, or a run of random bytes as hex or as base64 --"
            , "the three things a shell gets asked for when a name has to be"
            , "one nothing else has. Again makes a new one."
            ]
      }
    , { title = "Environment variables"
      , key = "Alt-P"
      , word = "predc env"
      , blurb =
            [ "Every variable this process has, with a filter. A snapshot"
            , "from before the first frame and deliberately not refreshable:"
            , "only a process itself can change its own environment."
            ]
      }
    , { title = "Quick notes"
      , key = "Alt-Q"
      , word = "predc notes [name]"
      , blurb =
            [ "Small free-form documents that outlive the terminal. The one"
            , "tool here that keeps something rather than answering a"
            , "question; it saves as you type, one file per note."
            ]
      }
    ]


{-| The page.

The three columns are the three ways to get at a tool and they are in the order
somebody needs them: what it is called, the key that opens it from anywhere,
and the word that opens it on the way in. The last of those is the reason the
page pays for itself twice -- a menu can show the first two and no menu can
show the third.
-}
whatIsInHere : Array Line
whatIsInHere =
    [ Head "THE TOOLS"
    , Gap
    , Text "  All ten are on the Tools menu. The Alt-key opens one from"
    , Text "  anywhere, including from inside another tool, and the command"
    , Text "  opens it on the way in -- predc on its own is the bare desktop."
    , Gap
    , Text "  Name                    Key       Command line"
    , Text "  ----------------------  --------  ---------------------------"
    , Gap
    ]
        ++ Array.flatten (Array.map entryLines inventory)
        ++ [ Head "AND THE REST OF THE SHELL"
           , Gap
           , Text "  Several tools at once   Every window here is a window. F6"
           , Text "                          moves between them, F5 zooms one,"
           , Text "                          Ctrl-F5 resizes, Alt-F3 closes it,"
           , Text "                          and Window | Tile lays them out."
           , Gap
           , Text "  Settings                Options: the colour scheme, whether"
           , Text "                          weeks are numbered the ISO way or"
           , Text "                          the US way, and the ASCII chart's"
           , Text "                          shape. All three are remembered in"
           , Text "                          ~/.config/predc/predc.toml, which is"
           , Text "                          a file you may edit and comment."
           , Gap
           , Text "  Moving text about       y copies and v pastes, in the tools"
           , Text "                          that deal in values. Whether that"
           , Text "                          reaches the rest of the machine is"
           , Text "                          its own subject: F1."
           , Gap
           , Text "  Leaving                 Alt-X."
           ]


{-| One tool: the heading row, then its blurb indented under it.

The blurb is indented past the name column rather than starting at it, so that
the ten names line up as a list somebody can run an eye down. Reading the page
for "is there a thing that does X" is what it is mostly for, and that is a
scan rather than a read.
-}
entryLines : Entry -> Array Line
entryLines entry =
    [ Text
        ("  "
            ++ String.padRight 24 ' ' entry.title
            ++ String.padRight 10 ' ' entry.key
            ++ entry.word
        )
    ]
        ++ Array.map (\line -> Text ("      " ++ line)) entry.blurb
        ++ [ Gap ]


{-| The half that is about *this* machine, and the reason to open the window at
all. It goes first because somebody with a broken paste wants the answer, not
the background.
-}
yours : Model -> Array Line
yours model =
    let
        it =
            model.session

        here =
            it.display || it.wayland

        place =
            if it.ssh && it.tmux then
                "Over ssh, inside tmux."

            else if it.ssh && it.screen then
                "Over ssh, inside screen."

            else if it.ssh then
                "Over ssh."

            else if it.tmux then
                "This machine, inside tmux."

            else if it.screen then
                "This machine, inside screen."

            else
                "This machine, no multiplexer."
    in
    [ Head "THIS SESSION"
    , Gap
    , Text ("  " ++ place ++ "   TERM=" ++ it.term)
    , if it.wayland then
        Text "  WAYLAND_DISPLAY is set, so wl-copy and wl-paste are tried first."

      else if it.display then
        Text "  DISPLAY is set, so xsel and xclip are tried first."

      else
        Text "  No DISPLAY, no WAYLAND_DISPLAY: xclip, xsel and wl-copy are not"
    , if here then
        Gap

      else
        Text "  tried at all -- the display they would talk to is the far end's."
    , Gap
    ]
        ++ (when model.probe is
                Asking ->
                    [ Text "  Asking the terminal for its clipboard..." ]

                Answered True ->
                    [ Text "  Measured: something outside this program answered a clipboard"
                    , Text "  read, so p and P work here."
                    ]

                Answered False ->
                    [ Warn "  Measured: nothing outside this program answered a clipboard"
                    , Warn "  read, so p and P cannot reach your clipboard here."
                    , Text "  There is no setting that changes this. Paste with the terminal"
                    , Text "  instead -- the next section is how."
                    ]
           )
        ++ [ Gap ]


{-| The same answer as [`pressing`](#pressing) in one line, for a window that
has a row to spare rather than a page.

It lives here and not in the window that draws it because there is exactly one
correct answer to "how do I paste" and it depends on the session, so a second
copy of it somewhere else is a second copy that will go stale. The Unicode
decoder draws this under its rows; the hex viewer's `Type bytes` field is the
same field and the same sentence would fit it.

**Seventy-six columns is the budget** -- the decoder's canvas -- and the
`screen` variant already spends all of them, so that is the one to measure
against when any of this changes. The `~` marks are not part of that count:
they are the status line's own convention for a key, [`Theme.hint`](Theme#hint)
turns them into a second colour, and `barWidth` below has skipped them since
before this line had any.

The order is deliberate. `Ctrl-Shift-V` first because it is the route that
cannot fail: the terminal reads its own clipboard and types the characters at
the program, so no display, no helper and no escape sequence is involved. `p`
is named last, and only where it can work, because `p` is what somebody tries
first and what fails silently over ssh.
-}
pasteHint : Session -> String
pasteHint it =
    if it.tmux then
        "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, tmux ~prefix ]~ into the field.  ~F1~ for why."

    else if it.screen then
        "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, screen ~Ctrl-a ]~ into the field.  ~F1~ for why."

    else if it.display || it.wayland then
        "Paste  ~p~ reads the clipboard; ~Ctrl-Shift-V~ into the field.  ~F1~ for why."

    else
        "Paste  ~Ctrl-Shift-V~ or ~Shift-Ins~ into the field.  ~F1~ says why ~p~ may not."


{-| How wide a status-line entry draws, which is not `String.length`.

`TStatusLine::drawSelect` measures with `cstrlen`, which skips the `~` that
mark the highlighted stretches, and then spends `l + 2` columns on the item --
one space each side. Nothing in Gren knew that rule, so the bar's width was a
thing to be counted by hand and got out of date the moment an entry changed.
-}
barWidth : String -> Int
barWidth text =
    String.count (String.replace "~" "" text)


{-| The paste hint as it goes on the **status line**, for a bar with `budget`
columns left over.

Two situations, not one. Which routes exist is the environment's answer and is
what [`pasteHint`](#pasteHint) already knew; how much room there is to say it
in is the terminal's, and changes under the program while it runs. So this
takes both, and the width is the reason it is a ladder rather than a string:
the longest version that fits is the one that goes on.

**Measured rather than counted.** Each rung is chosen by `barWidth`, so a
sentence being one character longer than its author thought demotes it instead
of overflowing. That matters here more than it usually would, because of how
`TStatusLine` fails: an entry that does not fit is **dropped whole and in
silence** -- `if( i + l < size.x )` and no `else` -- so the hint would simply
not be there, on exactly the narrow terminal where somebody most needs it and
with nothing on the screen to say a sentence had been discarded.

The bottom rung is `""`, which is deliberate and is not a failure. An entry
with no text costs no columns and is still offered every keystroke, so on a
terminal too narrow for any of this `F1` keeps working with nothing drawn --
the same trick that puts cut, copy and paste on the bar for free.

The order inside a rung is the order in [`pasteHint`](#pasteHint), and for the
same reason: `Ctrl-Shift-V` first because the terminal types the characters at
the program and nothing can block that, and `p` last and only where it can
work, because `p` is what somebody tries first and what fails in silence.
-}
pasteBar : Session -> Int -> String
pasteBar it budget =
    barVariants it
        |> Array.keepIf (\text -> barWidth text <= budget)
        |> Array.first
        |> Maybe.withDefault ""


{-| The rungs, longest first. One list per situation, because the middle of
the sentence is the part the situation changes: inside a multiplexer the
reliable route is its own paste key, with a display `p` works, and over a bare
ssh session `p` is the thing that will never work and saying so is the point.
-}
barVariants : Session -> Array String
barVariants it =
    if it.tmux then
        [ "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, or tmux ~prefix ]~ into a field   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, tmux ~prefix ]~   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, tmux ~prefix ]~   ~F1~"
        , "Paste  ~Shift-Ins~ or tmux ~prefix ]~   ~F1~"
        , "Paste  ~Shift-Ins~   ~F1~"
        , "~F1~ paste"
        , ""
        ]

    else if it.screen then
        [ "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, or screen ~Ctrl-a ]~ into a field   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, screen ~Ctrl-a ]~   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, screen ~Ctrl-a ]~   ~F1~"
        , "Paste  ~Shift-Ins~ or screen ~Ctrl-a ]~   ~F1~"
        , "Paste  ~Shift-Ins~   ~F1~"
        , "~F1~ paste"
        , ""
        ]

    else if it.display || it.wayland then
        [ "Paste  ~Ctrl-Shift-V~ or ~Shift-Ins~ into a field; ~p~ reads the clipboard   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, or ~p~ for the clipboard   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~, ~Shift-Ins~, or ~p~   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~ or ~Shift-Ins~   ~F1~ why"
        , "Paste  ~Shift-Ins~   ~F1~"
        , "~F1~ paste"
        , ""
        ]

    else
        [ "Paste  ~Ctrl-Shift-V~ or ~Shift-Ins~ into a field -- ~p~ cannot work here   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~ or ~Shift-Ins~ into a field, never ~p~   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~ or ~Shift-Ins~, not ~p~   ~F1~ why"
        , "Paste  ~Ctrl-Shift-V~ or ~Shift-Ins~   ~F1~ why"
        , "Paste  ~Shift-Ins~   ~F1~"
        , "~F1~ paste"
        , ""
        ]


{-| The section that is the point of the window, and the only other one that
knows where it is: `prefix ]` is the answer for somebody inside tmux and noise
for everybody else, so it is there only when `TMUX` is.
-}
pressing : Model -> Array Line
pressing model =
    [ Head "WHAT TO PRESS"
    , Gap
    , Text "  Paste into predc    Ctrl-Shift-V, or Shift-Insert, with the caret"
    , Text "                      in a field. This always works: your terminal"
    , Text "                      sends the text as keystrokes, and typing is"
    , Text "                      the one route nothing can block."
    , Gap
    , Text "                      The fields that take bytes are the Unicode"
    , Text "                      decoder's Bytes box and the hex viewer's"
    , Text "                      Bytes | Type bytes...  Both accept text or"
    , Text "                      hex digits; the radio beside them says which."
    , Gap
    ]
        ++ (if model.session.tmux then
                [ Text "  From tmux           prefix [ to select, then prefix ] with the"
                , Text "                      caret in a field. tmux types the buffer at"
                , Text "                      predc, so this works where p does not."
                , Gap
                ]

            else
                []
           )
        ++ [ Text "  From a selection    Shift and middle-click. A plain middle-click"
           , Text "                      will not paste -- predc reads the mouse, so"
           , Text "                      the terminal never sees the button, and on a"
           , Text "                      window frame it moves the window instead."
           , Gap
           , Text "  Inside predc        Ctrl-Ins copies, Shift-Ins pastes and"
           , Text "                      Shift-Del cuts, in every field here. They use"
           , Text "                      predc's own clipboard, so they work with no"
           , Text "                      system clipboard at all -- y in one window"
           , Text "                      then Shift-Ins in another needs no terminal."
           , Gap
           , Text "  Out of predc        y copies. Whether it reaches the rest of the"
           , Text "                      machine is the next section but one."
           , Gap
           ]


pasting : Array Line
pasting =
    [ Head "WHY A PASTE MAY NOT ARRIVE"
    , Gap
    , Text "  Two different things are called pasting and only one of them can"
    , Text "  fail."
    , Gap
    , Text "  predc asks for the clipboard -- p, P, Shift-Ins. It needs a route:"
    , Text "  a helper program that talks to a display, or an escape sequence"
    , Text "  the terminal answers. Over ssh there is no display, and the"
    , Text "  sequence is not even sent unless the terminal has already proved"
    , Text "  it answers one. tmux never proves it and never forwards it."
    , Gap
    , Text "  The terminal types at predc -- Ctrl-Shift-V, Shift-Insert,"
    , Text "  tmux's prefix ]. Your terminal reads its own clipboard, on the"
    , Text "  machine you are sitting at, and sends the characters down the"
    , Text "  connection like typing. Nothing can stop this working."
    , Gap
    , Text "  So the fix for a paste is never a setting. It is a field, and"
    , Text "  predc has two."
    , Gap
    ]


copying : Array Line
copying =
    [ Head "WHY A COPY MAY NOT ARRIVE"
    , Gap
    , Text "  Copying out is the easier direction and does have a setting."
    , Gap
    , Text "  With a display, predc runs wl-copy, xsel or xclip. Without one it"
    , Text "  hands the text to the terminal as an OSC 52 escape sequence, and"
    , Text "  that is the only route that crosses ssh."
    , Gap
    , Text "  predc says the terminal did not confirm it rather than that the"
    , Text "  copy failed, and the difference is real: the sequence goes out"
    , Text "  every time, and a terminal that took it usually does not say so."
    , Text "  The message means nobody confirmed, not that nobody took it."
    , Gap
    , Text "  tmux swallows it by default. One line fixes that:"
    , Gap
    , Text "      set -g set-clipboard on          # in ~/.tmux.conf"
    , Gap
    , Text "  That is about copying only. It does nothing for a paste."
    , Gap
    ]


table : Array Line
table =
    [ Head "EVERY ENVIRONMENT"
    , Gap
    , Text "  Where you are                    Copy out          p and P"
    , Text "  -------------------------------  ----------------  ---------------"
    , Text "  Local X11 or Wayland             works             works"
    , Text "  Local, selected with the mouse   --                never: PRIMARY"
    , Text "  Local in tmux, no DISPLAY        needs tmux line   never"
    , Text "  ssh, ordinary terminal           if allowed        never"
    , Text "  ssh, kitty with reads allowed    works             works"
    , Text "  ssh, inside tmux                 needs tmux line   never"
    , Text "  Linux virtual console            nothing to take   nothing to give"
    , Gap
    , Text "  The right-hand column is why predc has fields -- and why it never"
    , Text "  has to be the answer: Ctrl-Shift-V works in every row above."
    , Gap
    ]


stores : Array Line
stores =
    [ Head "WHY IT IS THIS CONFUSING"
    , Gap
    , Text "  Unix has no single clipboard. It has six, they hold different"
    , Text "  text, and nothing on the screen says which one you are looking at:"
    , Gap
    , Text "    X11 CLIPBOARD    an explicit Copy fills it; Ctrl-V pastes it"
    , Text "    X11 PRIMARY      selecting with the mouse fills it; middle-"
    , Text "                     click pastes it"
    , Text "    X11 cut buffers  effectively nothing has used these since 1990"
    , Text "    Wayland's        a different protocol again"
    , Text "    the terminal's   the only one that exists over ssh, because it"
    , Text "                     belongs to the machine you are sitting at"
    , Text "    tmux buffers     a private one per multiplexer, on top"
    , Gap
    , Text "  Turbo Vision reads and writes X11 CLIPBOARD and never PRIMARY."
    , Text "  So text you selected with the mouse is not text predc can ask"
    , Text "  for, even on your own machine with xclip installed. Paste it in"
    , Text "  instead, with Shift and middle-click."
    , Gap
    , Text "  The long version, with the measurements behind all of this, is"
    , Text "  gren-tvision/docs/clipboard.md."
    ]


-- VIEW


view : Inks -> Model -> Tui.Window
view inks model =
    { id = windowId
    , title =
        when model.page is
            Tools ->
                "What is in here"

            Clipboard ->
                "Copying and pasting"
    -- Narrower than the hex viewer and the decoder, because this is prose and
    -- eighty columns of it is a wall. It is also why the window is offset
    -- rather than at the left edge: it is meant to be read in front of the
    -- window that raised the question, not to replace it.
    -- Narrower than the hex viewer and the decoder, because this is prose and
    -- eighty columns of it is a wall -- and offset from the left edge for the
    -- same reason it is not full width: it is meant to be read in front of the
    -- window that raised the question, not instead of it.
    --
    -- The *height* is the desktop's, though, because the thing somebody
    -- actually wants from this window is more of it at once.
    , rect =
        { x1 = 4
        , y1 = 1
        , x2 = 4 + lineWidth + 3
        , y2 = 1 + textRows model.page model.desktop + 3
        }
    , resize = Tui.resizeHeight
    , palette = Tui.BlueWindow
    , canClose = True
    , canMove = True
    , views =
        [ Grows
            { grow = Tui.stretchHeight
            , view =
                Canvas
                    { id = canvasId
                    , rect =
                        { x1 = 1
                        , y1 = 1
                        , x2 = 1 + lineWidth
                        , y2 = 1 + textRows model.page model.desktop
                        }
                    , lines = shown inks model
                    , cursor = Nothing
                    , takesFocus = True
                    }
            }
        , Grows
            { grow = Tui.stretchHeight
            , view =
                ScrollBar
                    { id = scrollId
                    -- On the frame, which is where Turbo Vision puts a scroll
                    -- bar: the window is `lineWidth + 3` wide, so the last
                    -- column is the border and this is it.
                    , rect =
                        { x1 = 1 + lineWidth
                        , y1 = 1
                        , x2 = 2 + lineWidth
                        , y2 = 1 + textRows model.page model.desktop
                        }
                    , value = model.top
                    , min = 0
                    , max = max 0 (Array.length (rows model) - model.rows)
                    , pageStep = model.rows
                    , arrowStep = 1
                    , for = ""
                    }
            }
        ]
    }


shown : Inks -> Model -> Array (Array Span)
shown inks model =
    Array.map (paint inks)
        (Array.takeFirst model.rows (Array.dropFirst model.top (rows model)))
